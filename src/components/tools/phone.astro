---
---

<div class="tip">号段数据用于识别运营商与号码类型，不代表精确归属地，仅供填写资料时参考。</div>

<div style="max-width:420px;">
  <div class="field-label"><span>手机号码</span></div>
  <input type="text" id="ph-in" placeholder="输入 11 位手机号" maxlength="13" spellcheck="false" />
</div>

<div class="btn-row">
  <button class="primary" id="ph-go">查询</button>
  <button id="ph-batch">批量查询</button>
  <button id="ph-clear">清空</button>
</div>

<div id="ph-batch-box" style="display:none;max-width:560px;">
  <div class="field-label"><span>批量号码（每行一个）</span></div>
  <textarea id="ph-list" placeholder="13800138000&#10;18612345678" style="min-height:120px;" spellcheck="false"></textarea>
</div>

<p class="msg" id="ph-msg"></p>
<div id="ph-out"></div>

<script>
  const $ = (id) => document.getElementById(id);

  // 号段 → 运营商（仅前三位，够用于识别运营商与号码类型）
  const CARRIER = {
    移动: ['134','135','136','137','138','139','147','148','150','151','152','157','158','159','172','178','182','183','184','187','188','195','197','198'],
    联通: ['130','131','132','145','146','155','156','166','167','175','176','185','186','196'],
    电信: ['133','149','153','162','173','174','177','180','181','189','190','191','193','199'],
    广电: ['192'],
    虚拟运营商: ['170','171','165','167'],
  };
  const MAP = {};
  Object.entries(CARRIER).forEach(([k, list]) => list.forEach((p) => { if (!MAP[p]) MAP[p] = k; }));

  function lookup(num) {
    const clean = num.replace(/[\s-]/g, '');
    const res = { raw: num, clean, ok: false };
    if (!/^1[3-9]\d{9}$/.test(clean)) {
      res.reason = clean.length !== 11 ? '长度不对，应为 11 位数字' : '不是合法的手机号格式';
      return res;
    }
    res.ok = true;
    res.prefix3 = clean.slice(0, 3);
    res.carrier = MAP[res.prefix3] || '未知号段';
    res.segment = clean.slice(0, 7);
    res.masked = clean.slice(0, 3) + '****' + clean.slice(7);
    res.type = ['170', '171', '165', '167'].includes(res.prefix3) ? '虚拟运营商号段'
      : ['145', '146', '147', '148', '149'].includes(res.prefix3) ? '物联网/数据卡号段'
      : '普通手机号段';
    return res;
  }

  function renderOne(r) {
    const esc = (s) => String(s).replace(/</g, '&lt;');
    if (!r.ok) return `<tr><th>${esc(r.raw)}</th><td style="color:var(--danger);">${esc(r.reason)}</td></tr>`;
    return `<tr><th>${esc(r.masked)}</th><td>${esc(r.carrier)}　<span style="color:var(--text-sub);">${esc(r.type)}</span>　<span style="color:var(--text-hint);">号段 ${esc(r.segment)}</span></td></tr>`;
  }

  function run() {
    const single = $('ph-batch-box').style.display === 'none';
    const nums = single
      ? [$('ph-in').value.trim()].filter(Boolean)
      : $('ph-list').value.split(/\r?\n/).map((s) => s.trim()).filter(Boolean);

    if (!nums.length) { $('ph-msg').textContent = '请输入手机号'; $('ph-msg').className = 'msg err'; return; }
    const rows = nums.map((n) => lookup(n));
    const okCount = rows.filter((r) => r.ok).length;

    $('ph-out').innerHTML =
      '<table class="result-table" style="margin-top:14px;max-width:560px;">' +
      rows.map(renderOne).join('') +
      '</table>';
    $('ph-msg').textContent = single
      ? (rows[0].ok ? '查询完成' : rows[0].reason)
      : `共 ${rows.length} 个，有效 ${okCount} 个`;
    $('ph-msg').className = (single ? rows[0].ok : okCount > 0) ? 'msg ok' : 'msg err';
  }

  $('ph-go').onclick = run;
  $('ph-batch').onclick = () => {
    const box = $('ph-batch-box');
    const show = box.style.display === 'none';
    box.style.display = show ? 'block' : 'none';
    $('ph-batch').textContent = show ? '单个查询' : '批量查询';
    $('ph-out').innerHTML = '';
    $('ph-msg').textContent = '';
  };
  $('ph-clear').onclick = () => {
    $('ph-in').value = ''; $('ph-list').value = '';
    $('ph-out').innerHTML = ''; $('ph-msg').textContent = '';
  };
</script>
