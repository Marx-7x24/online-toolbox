---
import { tu } from '../../i18n/toolUi.ts';

interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---

<div class="tip">{tu(lang, '输入 JSON 后点')}「{tu(lang, '格式化')}」。{tu(lang, '数据只在你自己的浏览器里处理，不会发送到任何服务器。')}</div>

<div class="pane">
  <div>
    <div class="field-label"><span>{tu(lang, '输入')}</span><span id="jf-count"></span></div>
    <textarea id="jf-in" placeholder='粘贴 JSON，例如：{"name":"张三","age":18}' spellcheck="false"></textarea>
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '输出')}</span></div>
    <textarea id="jf-out" placeholder={tu(lang, '格式化结果')} spellcheck="false" readonly></textarea>
  </div>
</div>

<div class="btn-row">
  <button class="primary" id="jf-fmt">{tu(lang, '格式化')}</button>
  <button id="jf-min">{tu(lang, '压缩')}</button>
  <button id="jf-escape">{tu(lang, '转义为字符串')}</button>
  <button id="jf-unescape">{tu(lang, '去除转义')}</button>
  <button id="jf-copy">{tu(lang, '复制结果')}</button>
  <button id="jf-clear">{tu(lang, '清空')}</button>
</div>

<p class="msg" id="jf-msg"></p>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);
  const inEl = $('jf-in'), outEl = $('jf-out'), msgEl = $('jf-msg'), countEl = $('jf-count');

  function fail(e) {
    msgEl.className = 'msg err';
    msgEl.textContent = tu(LANG, '解析失败：') + e.message;
    outEl.value = '';
  }
  function ok(text) {
    msgEl.className = 'msg ok';
    msgEl.textContent = tu(LANG, '处理完成');
    countEl.textContent = inEl.value.length + tu(LANG, ' 字符');
  }
  function parse() {
    const raw = inEl.value.trim();
    if (!raw) { msgEl.textContent = tu(LANG, '请先输入内容'); msgEl.className = 'msg err'; return null; }
    try { return JSON.parse(raw); } catch (e) { fail(e); return null; }
  }

  $('jf-fmt').onclick = () => {
    const d = parse(); if (d === null && inEl.value.trim() === '') return;
    if (d === null) return;
    outEl.value = JSON.stringify(d, null, 2);
    ok();
  };
  $('jf-min').onclick = () => {
    const d = parse(); if (d === null) return;
    outEl.value = JSON.stringify(d);
    ok();
  };
  $('jf-escape').onclick = () => {
    const d = parse(); if (d === null) return;
    outEl.value = JSON.stringify(JSON.stringify(d));
    ok();
  };
  $('jf-unescape').onclick = () => {
    let raw = inEl.value.trim();
    if ((raw.startsWith('"') && raw.endsWith('"')) || (raw.startsWith("'") && raw.endsWith("'"))) {
      raw = raw.slice(1, -1);
    }
    try {
      const d = JSON.parse(raw.replace(/\\"/g, '"').replace(/\\\\/g, '\\'));
      outEl.value = JSON.stringify(d, null, 2);
      ok();
    } catch (e) { fail(e); }
  };
  $('jf-copy').onclick = async () => {
    if (!outEl.value) { msgEl.textContent = tu(LANG, '没有可复制的内容'); msgEl.className = 'msg err'; return; }
    await navigator.clipboard.writeText(outEl.value);
    msgEl.textContent = tu(LANG, '已复制到剪贴板'); msgEl.className = 'msg ok';
  };
  $('jf-clear').onclick = () => {
    inEl.value = ''; outEl.value = ''; msgEl.textContent = ''; countEl.textContent = '';
  };
</script>
