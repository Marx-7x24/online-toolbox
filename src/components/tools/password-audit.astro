---
import { tu } from '../../i18n/toolUi.ts';
// 密码体检：强度 + 泄露规则合一，本地计算
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div>
  <div class="field-label"><span>{tu(lang, '输入密码（仅本地检查，不上传')}）</span></div>
  <input type="text" id="pa-in" placeholder={tu(lang, '输入要体检的密码')} autocomplete="off">
  <div class="pa-bar"><div id="pa-fill" class="pa-fill"></div></div>
  <div id="pa-label" class="pa-label">{tu(lang, '尚未输入')}</div>
  <div id="pa-out" class="pa-out">{tu(lang, '等待体检')}</div>
</div>

<style>
  .pa-bar { height: 10px; border-radius: 6px; background: var(--border); overflow: hidden; margin-top: 10px; }
  .pa-fill { height: 100%; width: 0; transition: width .2s, background .2s; background: #adb5bd; }
  .pa-label { font-weight: 600; margin-top: 8px; }
  .pa-out { border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; min-height: 120px; line-height: 1.9; background: var(--bg-soft); font-size: 13px; }
  .pa-out .bad { color: #e03131; font-weight: 600; }
  .pa-out .warn { color: #f08c00; font-weight: 600; }
  .pa-out .ok { color: #2f9e44; font-weight: 600; }
</style>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);
  const WEAK = new Set(['123456', 'password', '12345678', 'qwerty', '111111', '123123', 'abc123', 'password1', '123456789', 'admin', 'welcome', 'iloveyou', '1q2w3e4r', 'qwerty123', '000000', '666666', '888888', 'passw0rd', 'p@ssw0rd', 'letmein', 'root', 'toor', 'test', 'guest', 'changeme', 'zhang123', 'woaini', '123456a', 'a123456', '1qaz2wsx', 'password123']);
  function kbWalk(p) { const w = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm', '1234567890']; for (const s of w) for (let i = 0; i + 2 < s.length; i++) if (p.toLowerCase().includes(s.slice(i, i + 3))) return true; return false; }
  function seq(p) { for (let i = 0; i + 2 < p.length; i++) { const a = p.charCodeAt(i), b = p.charCodeAt(i + 1), c = p.charCodeAt(i + 2); if (b === a + 1 && c === b + 1) return true; if (b === a - 1 && c === b - 1) return true; } return false; }
  $('pa-in').addEventListener('input', () => {
    const pw = $('pa-in').value; const len = pw.length;
    if (!len) { $('pa-fill').style.width = '0'; $('pa-label').textContent = tu(LANG, '尚未输入'); $('pa-out').textContent = tu(LANG, '等待体检'); return; }
    let pool = 0;
    if (/[a-z]/.test(pw)) pool += 26; if (/[A-Z]/.test(pw)) pool += 26; if (/[0-9]/.test(pw)) pool += 10; if (/[^a-zA-Z0-9]/.test(pw)) pool += 33;
    const bits = Math.round(len * Math.log2(pool || 1));
    let level, color;
    if (bits < 40) { level = tu(LANG, '弱'); color = '#e03131'; } else if (bits < 60) { level = tu(LANG, '中'); color = '#f08c00'; } else if (bits < 80) { level = tu(LANG, '强'); color = '#2f9e44'; } else { level = tu(LANG, '极强'); color = '#1971c2'; }
    $('pa-fill').style.width = Math.min(100, bits) + '%'; $('pa-fill').style.background = color; $('pa-label').textContent = tu(LANG, '强度：') + level + `（熵 ${bits} bit）`; $('pa-label').style.color = color;
    const items = [];
    if (WEAK.has(pw.toLowerCase())) items.push([tu(LANG, '严重'), tu(LANG, '命中常见弱密码库')]);
    if (len < 8) items.push([tu(LANG, '严重'), `长度仅 ${len} 位`]);
    if (kbWalk(pw)) items.push([tu(LANG, '警告'), tu(LANG, '含键盘连续序列')]);
    if (seq(pw)) items.push([tu(LANG, '警告'), tu(LANG, '含连续递增/递减数字')]);
    if (/^(.)\1{2,}$/.test(pw)) items.push([tu(LANG, '警告'), tu(LANG, '含连续重复字符')]);
    if (!/(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9])/.test(pw)) items.push([tu(LANG, '提示'), tu(LANG, '未同时含大小写+数字+符号')]);
    const tips = [];
    if (len < 12) tips.push(tu(LANG, '长度 ≥ 12')); if (!/[A-Z]/.test(pw)) tips.push(tu(LANG, '加大写')); if (!/[0-9]/.test(pw)) tips.push(tu(LANG, '加数字')); if (!/[^a-zA-Z0-9]/.test(pw)) tips.push(tu(LANG, '加符号'));
    let html = items.length ? items.map(([s, t]) => `<div class="${s === tu(LANG, '严重') ? 'bad' : s === tu(LANG, '警告') ? 'warn' : 'ok'}">[${s}] ${t}</div>`).join('') : '<div class="ok">未命中已知弱模式 ✓</div>';
    html += `<div style="margin-top:8px;color:var(--text-sub)">建议：${tips.length ? tips.join('；') + '。' : tu(LANG, '构成较合理，继续保持。')}</div>`;
    $('pa-out').innerHTML = html;
  });
</script>
