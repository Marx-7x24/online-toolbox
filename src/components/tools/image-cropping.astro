---
// 图片自由裁切：拖框选区域 → 输出 PNG
---
<div class="pane">
  <div>
    <div class="field-label"><span>选择图片</span></div>
    <input type="file" id="cr-file" accept="image/*">
    <div id="cr-info" class="msg"></div>
    <p style="font-size:12px;color:#999;margin-top:8px">提示：在下方图片上按住鼠标拖动框选区域，可拖动/调整 8 个控制点。</p>
    <div class="field-label" style="margin-top:14px"><span>裁切预览</span></div>
    <div id="cr-cropped" class="cr-cropped"></div>
  </div>
  <div>
    <div class="field-label"><span>拖框选区</span></div>
    <div id="cr-stage" class="cr-stage">
      <canvas id="cr-canvas"></canvas>
      <div id="cr-rect" class="cr-rect" style="display:none">
        <div class="cr-handle" data-h="nw"></div>
        <div class="cr-handle" data-h="n"></div>
        <div class="cr-handle" data-h="ne"></div>
        <div class="cr-handle" data-h="e"></div>
        <div class="cr-handle" data-h="se"></div>
        <div class="cr-handle" data-h="s"></div>
        <div class="cr-handle" data-h="sw"></div>
        <div class="cr-handle" data-h="w"></div>
      </div>
    </div>
  </div>
</div>
<div class="btn-row">
  <button id="cr-apply" class="primary">应用裁切</button>
  <button id="cr-dl">下载 PNG</button>
  <button id="cr-reset" class="btn-grey">重置</button>
  <span id="cr-msg" class="msg"></span>
</div>

<style>
  .cr-stage { position: relative; margin-top: 10px; border: 1px dashed var(--border); border-radius: 8px; min-height: 240px; background: var(--hover-bg); overflow: hidden; user-select: none; max-height: 480px; display: inline-block; }
  .cr-stage canvas { display: block; max-width: 100%; }
  .cr-rect { position: absolute; border: 2px solid var(--primary-color, #3e2eff); background: rgba(62, 46, 255, 0.12); cursor: move; box-sizing: border-box; }
  .cr-handle { position: absolute; width: 10px; height: 10px; background: #fff; border: 2px solid var(--primary-color, #3e2eff); border-radius: 50%; }
  .cr-handle[data-h="nw"] { top: -5px; left: -5px; cursor: nwse-resize; }
  .cr-handle[data-h="n"]  { top: -5px; left: calc(50% - 5px); cursor: ns-resize; }
  .cr-handle[data-h="ne"] { top: -5px; right: -5px; cursor: nesw-resize; }
  .cr-handle[data-h="e"]  { top: calc(50% - 5px); right: -5px; cursor: ew-resize; }
  .cr-handle[data-h="se"] { bottom: -5px; right: -5px; cursor: nwse-resize; }
  .cr-handle[data-h="s"]  { bottom: -5px; left: calc(50% - 5px); cursor: ns-resize; }
  .cr-handle[data-h="sw"] { bottom: -5px; left: -5px; cursor: nesw-resize; }
  .cr-handle[data-h="w"]  { top: calc(50% - 5px); left: -5px; cursor: ew-resize; }
  .cr-cropped { margin-top: 10px; border: 1px dashed var(--border); border-radius: 8px; padding: 10px; min-height: 120px; display: flex; align-items: center; justify-content: center; background: var(--hover-bg); }
  .cr-cropped img { max-width: 100%; max-height: 320px; }
  .cr-cropped:empty::before { content: '尚未裁切'; color: #999; }
</style>

<script>
  const $ = (id) => document.getElementById(id);
  let imgEl = null;
  let croppedBlob = null;
  let crop = null; // {x, y, w, h} in image px
  const stage = $('cr-stage'), canvas = $('cr-canvas'), rect = $('cr-rect');
  const ctx = canvas.getContext('2d');

  $('cr-file').addEventListener('change', async (e) => {
    const f = e.target.files[0];
    if (!f) return;
    const img = new Image();
    img.onload = () => {
      imgEl = img;
      // 缩放到 max width 600
      const maxW = 600;
      const ratio = Math.min(1, maxW / img.width);
      canvas.width = Math.round(img.width * ratio);
      canvas.height = Math.round(img.height * ratio);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      stage.style.width = canvas.width + 'px';
      stage.style.height = canvas.height + 'px';
      $('cr-info').textContent = `原始 ${img.width}×${img.height} · 显示 ${canvas.width}×${canvas.height}`;
      $('cr-info').className = 'msg ok';
      // 默认框选中间 80%
      crop = { x: canvas.width*0.1, y: canvas.height*0.1, w: canvas.width*0.8, h: canvas.height*0.8 };
      drawRect();
    };
    img.src = URL.createObjectURL(f);
  });

  function drawRect() {
    if (!crop) return;
    rect.style.display = 'block';
    rect.style.left = crop.x + 'px';
    rect.style.top = crop.y + 'px';
    rect.style.width = crop.w + 'px';
    rect.style.height = crop.h + 'px';
  }

  // 拖动 / 缩放
  let drag = null;
  rect.addEventListener('mousedown', (e) => {
    const handle = e.target.dataset.h;
    drag = { type: handle || 'move', startX: e.clientX, startY: e.clientY, orig: { ...crop } };
    e.preventDefault();
  });
  window.addEventListener('mousemove', (e) => {
    if (!drag) return;
    const dx = e.clientX - drag.startX;
    const dy = e.clientY - drag.startY;
    const o = drag.orig;
    if (drag.type === 'move') {
      crop.x = clamp(o.x + dx, 0, canvas.width - crop.w);
      crop.y = clamp(o.y + dy, 0, canvas.height - crop.h);
    } else {
      let x1 = o.x, y1 = o.y, x2 = o.x + o.w, y2 = o.y + o.h;
      if (drag.type.includes('w')) x1 = clamp(o.x + dx, 0, x2 - 20);
      if (drag.type.includes('e')) x2 = clamp(o.x + o.w + dx, x1 + 20, canvas.width);
      if (drag.type.includes('n')) y1 = clamp(o.y + dy, 0, y2 - 20);
      if (drag.type.includes('s')) y2 = clamp(o.y + o.h + dy, y1 + 20, canvas.height);
      crop = { x: x1, y: y1, w: x2 - x1, h: y2 - y1 };
    }
    drawRect();
  });
  window.addEventListener('mouseup', () => drag = null);
  function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }

  // 框选（按住空白处拖动创建新框）
  let creating = null;
  stage.addEventListener('mousedown', (e) => {
    if (e.target !== canvas) return;
    const r = stage.getBoundingClientRect();
    const x = e.clientX - r.left, y = e.clientY - r.top;
    creating = { x, y, ex: x, ey: y };
    crop = { x, y, w: 1, h: 1 };
    drawRect();
  });
  stage.addEventListener('mousemove', (e) => {
    if (!creating) return;
    const r = stage.getBoundingClientRect();
    const x = clamp(e.clientX - r.left, 0, canvas.width);
    const y = clamp(e.clientY - r.top, 0, canvas.height);
    crop = {
      x: Math.min(creating.x, x),
      y: Math.min(creating.y, y),
      w: Math.abs(x - creating.x),
      h: Math.abs(y - creating.y),
    };
    drawRect();
  });
  window.addEventListener('mouseup', () => { creating = null; });

  $('cr-apply').addEventListener('click', async () => {
    if (!imgEl || !crop) { $('cr-msg').textContent = '请先选图并框选区域'; $('cr-msg').className = 'msg err'; return; }
    const ratio = canvas.width / imgEl.width;
    const sx = crop.x / ratio, sy = crop.y / ratio, sw = crop.w / ratio, sh = crop.h / ratio;
    const out = document.createElement('canvas');
    out.width = Math.round(sw); out.height = Math.round(sh);
    out.getContext('2d').drawImage(imgEl, sx, sy, sw, sh, 0, 0, out.width, out.height);
    croppedBlob = await new Promise(res => out.toBlob(res, 'image/png'));
    $('cr-cropped').innerHTML = '<img alt="裁切预览">';
    $('cr-cropped').querySelector('img').src = URL.createObjectURL(croppedBlob);
    $('cr-msg').textContent = `裁切完成 · ${out.width}×${out.height} · ${(croppedBlob.size/1024).toFixed(1)} KB`;
    $('cr-msg').className = 'msg ok';
  });

  $('cr-dl').addEventListener('click', () => {
    if (!croppedBlob) return;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(croppedBlob);
    a.download = 'cropped.png';
    a.click();
  });

  $('cr-reset').addEventListener('click', () => {
    imgEl = null; croppedBlob = null; crop = null;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    rect.style.display = 'none';
    $('cr-file').value = '';
    $('cr-info').textContent = '';
    $('cr-cropped').innerHTML = '';
    $('cr-msg').textContent = '';
  });
</script>
