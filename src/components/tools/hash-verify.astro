---
// 哈希一致性校验：本地计算并比对
---
<div class="pane">
  <div>
    <div class="field-label"><span>原文</span></div>
    <textarea id="hv-text" placeholder="粘贴要校验的文本"></textarea>
    <div class="field-label" style="margin-top:10px;"><span>算法</span></div>
    <select id="hv-algo"><option value="md5">MD5</option><option value="sha1">SHA-1</option><option value="sha256" selected>SHA-256</option><option value="sha512">SHA-512</option></select>
    <div class="field-label" style="margin-top:10px;"><span>预期哈希（可选）</span></div>
    <input type="text" id="hv-expect" placeholder="粘贴预期哈希值进行比对" autocomplete="off">
  </div>
  <div>
    <div class="field-label"><span>计算结果</span></div>
    <textarea id="hv-out" readonly></textarea>
  </div>
</div>
<div class="btn-row">
  <button id="hv-run" class="primary">计算</button>
  <button id="hv-copy">复制</button>
  <span id="hv-msg" class="msg"></span>
</div>

<script>
  import SparkMD5 from 'spark-md5';
  const $ = (id) => document.getElementById(id);
  async function digest(text, algo) {
    if (algo === 'md5') return SparkMD5.hash(text);
    const buf = await crypto.subtle.digest(algo.toUpperCase().replace('SHA', 'SHA-'), new TextEncoder().encode(text));
    return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
  }
  $('hv-run').addEventListener('click', async () => {
    const text = $('hv-text').value;
    if (!text) { $('hv-msg').textContent = '请输入原文'; $('hv-msg').className = 'msg err'; return; }
    const h = await digest(text, $('hv-algo').value);
    let extra = '';
    const exp = $('hv-expect').value.trim().toLowerCase();
    if (exp) extra = (exp === h.toLowerCase() ? '\n✓ 与预期一致' : '\n✗ 与预期不一致') + '\n预期：' + $('hv-expect').value;
    $('hv-out').value = h + extra;
    $('hv-msg').textContent = exp ? (exp === h.toLowerCase() ? '校验通过' : '校验不通过') : '已计算'; $('hv-msg').className = exp ? (exp === h.toLowerCase() ? 'msg ok' : 'msg err') : 'msg ok';
  });
  $('hv-copy').addEventListener('click', async () => {
    if (!$('hv-out').value) return;
    try { await navigator.clipboard.writeText($('hv-out').value); $('hv-msg').textContent = '已复制'; $('hv-msg').className = 'msg ok'; }
    catch { $('hv-msg').textContent = '复制失败'; $('hv-msg').className = 'msg err'; }
  });
</script>
