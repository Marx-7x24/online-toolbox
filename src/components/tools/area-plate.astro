    if (/^军/.test(p)) return tu(LANG, '军队');
    if (/^港|^澳|^台/.test(p)) return tu(LANG, '港澳/台入境内地');
    if (/^学/.test(p)) return tu(LANG, '教练车');
    if (/^挂/.test(p)) return tu(LANG, '挂车');
    if (/^临/.test(p)) return tu(LANG, '临时号牌');
