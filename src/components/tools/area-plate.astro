---
import { tu } from '../../i18n/toolUi.ts';
// 车牌归属地查询：根据车牌号解析省份与发牌城市（本地词表，覆盖各省会及主要城市）
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div class="pane">
  <div>
    <div class="field-label"><span>{tu(lang, '车牌号')}</span></div>
    <input type="text" id="ap-in" placeholder={tu(lang, '如 京A12345 / 粤B12345')} style="width:100%;padding:10px;border:1px solid var(--border-color);border-radius:8px;box-sizing:border-box;font-size:16px;letter-spacing:1px;text-transform:uppercase">
    <div class="btn-row" style="margin-top:12px">
      <button id="ap-run" class="primary">{tu(lang, '查询')}</button>
      <button id="ap-clear">{tu(lang, '清空')}</button>
    </div>
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '查询结果')}</span></div>
    <table class="result-table"><tbody>
      <tr><th>{tu(lang, '省份')}</th><td id="ap-prov">—</td></tr>
      <tr><th>{tu(lang, '发牌城市')}</th><td id="ap-city">—</td></tr>
      <tr><th>{tu(lang, '车牌类型')}</th><td id="ap-type">—</td></tr>
    </tbody></table>
    <p class="msg" id="ap-msg"></p>
  </div>
</div>

