    '琼A':'海口','琼B':'三亚','琼C':'海南(琼北)','琼D':'海南(琼南)','琼E':'洋浦','琼F':'儋州'
  };
  function plateType(p){
    if (/^WJ/.test(p)) return '武警';
    if (/^使/.test(p)) return '使馆';
    if (/^军/.test(p)) return '军队';
    if (/^港|^澳|^台/.test(p)) return '港澳/台入境内地';
    if (/^学/.test(p)) return '教练车';
    if (/^挂/.test(p)) return '挂车';
    if (/^临/.test(p)) return '临时号牌';
    if (/^领/.test(p)) return '领事馆';
    return '普通民用号牌';
  }
  $('ap-run').addEventListener('click', () => {
    const raw = $('ap-in').value.trim().toUpperCase();
    const m = raw.match(/^([京津冀晋蒙辽吉黑沪苏浙皖闽赣鲁豫鄂湘粤桂琼渝川贵云藏陕甘青宁新])([A-Z])/);
    if (!m){ $('ap-prov').textContent='—'; $('ap-city').textContent='—'; $('ap-type').textContent='—'; $('ap-msg').textContent='无法识别，请输入形如「京A12345」的号牌'; $('ap-msg').className='msg err'; return; }
    const prov = PROV[m[1]] || '未知省份';
    const city = CITY[m[1]+m[2]] || (prov + '（城市代码 '+m[2]+' 未收录）');
    $('ap-prov').textContent = prov;
    $('ap-city').textContent = city;
    $('ap-type').textContent = plateType(raw);
    $('ap-msg').textContent = '查询完成（数据基于公开号牌规则，个别区县代号可能未收录）';
    $('ap-msg').className = 'msg ok';
  });
  $('ap-clear').addEventListener('click', () => { $('ap-in').value=''; $('ap-prov').textContent='—'; $('ap-city').textContent='—'; $('ap-type').textContent='—'; $('ap-msg').textContent=''; });
</script>
