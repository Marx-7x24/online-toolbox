---
import { tu } from '../../i18n/toolUi.ts';
// 调色板生成：HSL 算法，本地计算
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div>
  <div class="field-label"><span>{tu(lang, '基础颜色')}</span></div>
  <input type="color" id="pl-base" value="#4c6ef5">
  <div class="field-label" style="margin-top:14px;"><span>{tu(lang, '色阶（明暗')}）</span></div>
  <div id="pl-scale" class="pl-row"></div>
  <div class="field-label" style="margin-top:14px;"><span>{tu(lang, '配色方案')}</span></div>
  <div id="pl-harm" class="pl-harm"></div>
</div>

<style>
  .pl-row, .pl-harm { display: flex; gap: 8px; flex-wrap: wrap; }
  .pl-row { margin-bottom: 8px; }
  .sw { flex: 1; min-width: 64px; border-radius: 8px; padding: 10px 8px; text-align: center; font-size: 12px; color: #fff; cursor: pointer; border: 1px solid rgba(0,0,0,.1); }
  .sw.dark { color: #fff; }
  .sw.light { color: #111; }
  .pl-harm .grp { flex: 1; min-width: 140px; }
  .pl-harm .grp .t { font-size: 12px; color: var(--text-sub); margin-bottom: 4px; }
</style>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);
  function hexToHsl(hex) {
    let r = parseInt(hex.slice(1, 3), 16) / 255, g = parseInt(hex.slice(3, 5), 16) / 255, b = parseInt(hex.slice(5, 7), 16) / 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0; const l = (max + min) / 2;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      if (max === r) h = (g - b) / d + (g < b ? 6 : 0);
      else if (max === g) h = (b - r) / d + 2;
      else h = (r - g) / d + 4;
      h *= 60;
    }
    return [h, s * 100, l * 100];
  }
  function hslToHex(h, s, l) {
    h = (h % 360 + 360) % 360; s /= 100; l /= 100;
    const k = (n) => (n + h / 30) % 12;
    const a = s * Math.min(l, 1 - l);
    const f = (n) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
    const to = (x) => Math.round(255 * x).toString(16).padStart(2, '0');
    return `#${to(f(0))}${to(f(8))}${to(f(4))}`;
  }
  function swatch(hex, label) {
    const [h, s, l] = hexToHsl(hex);
    const dark = l < 55;
    return `<div class="sw ${dark ? 'dark' : 'light'}" data-hex="${hex}" title="${hex}">${label || hex}<br>${hex.toUpperCase()}</div>`;
  }
  function render() {
    const [h, s, l] = hexToHsl($('pl-base').value);
    const scale = [];
    [0.92, 0.78, 0.64, 0.5, 0.38, 0.26, 0.16].forEach((ll, i) => scale.push(swatch(hslToHex(h, s, ll), 'L' + (i + 1))));
    $('pl-scale').innerHTML = scale.join('');
    const harm = [
      [tu(LANG, '原色'), hslToHex(h, s, l)],
      [tu(LANG, '互补'), hslToHex(h + 180, s, l)],
      [tu(LANG, '类似 +30'), hslToHex(h + 30, s, l)],
      [tu(LANG, '类似 -30'), hslToHex(h - 30, s, l)],
      [tu(LANG, '三角 +120'), hslToHex(h + 120, s, l)],
      [tu(LANG, '三角 -120'), hslToHex(h - 120, s, l)],
    ].map(([t, hex]) => `<div class="grp"><div class="t">${t}</div>${swatch(hex)}</div>`).join('');
    $('pl-harm').innerHTML = harm;
  }
  $('pl-base').addEventListener('input', render);
  document.addEventListener('click', (e) => {
    const t = e.target.closest('.sw');
    if (t) { navigator.clipboard.writeText(t.dataset.hex).catch(() => {}); }
  });
  render();
</script>
