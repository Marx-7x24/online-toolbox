---
import { tu } from '../../i18n/toolUi.ts';
// 时间戳批量转换：本地计算
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div class="pane">
  <div>
    <div class="field-label"><span>{tu(lang, '时间戳（每行一个，自动识别秒')}/{tu(lang, '毫秒')}）</span></div>
    <textarea id="tb-in" placeholder="1693545600&#10;1693545600000"></textarea>
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '结果')}</span></div>
    <textarea id="tb-out" readonly></textarea>
  </div>
</div>
<div class="btn-row">
  <button id="tb-run" class="primary">{tu(lang, '转换')}</button>
  <button id="tb-copy">{tu(lang, '复制')}</button>
  <span id="tb-msg" class="msg"></span>
</div>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);
  function conv(v) {
    const n = v.trim();
    if (!/^\d+$/.test(n)) return n + tu(LANG, ' → 非法');
    const ms = n.length > 11 ? +n : +n * 1000;
    const d = new Date(ms);
    if (isNaN(d)) return n + tu(LANG, ' → 无效');
    return `${n} → ${d.toLocaleString('zh-CN')} (${d.toISOString()})`;
  }
  $('tb-run').addEventListener('click', () => {
    const lines = $('tb-in').value.split('\n').map((x) => x.trim()).filter(Boolean);
    if (!lines.length) { $('tb-out').value = ''; return; }
    $('tb-out').value = lines.map(conv).join('\n');
    $('tb-msg').textContent = `已转换 ${lines.length} 条`; $('tb-msg').className = 'msg ok';
  });
  $('tb-copy').addEventListener('click', async () => {
    if (!$('tb-out').value) return;
    try { await navigator.clipboard.writeText($('tb-out').value); $('tb-msg').textContent = tu(LANG, '已复制'); $('tb-msg').className = 'msg ok'; }
    catch { $('tb-msg').textContent = tu(LANG, '复制失败'); $('tb-msg').className = 'msg err'; }
  });
</script>
