---
import { tu } from '../../i18n/toolUi.ts';
// PDF 页面提取：pdf-lib，本地处理
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div class="pane">
  <div>
    <div class="field-label"><span>{tu(lang, '上传')} PDF</span></div>
    <input type="file" id="ex-file" accept="application/pdf">
    <div class="field-label" style="margin-top:10px;"><span>{tu(lang, '提取页码')}</span></div>
    <input type="text" id="ex-range" placeholder={tu(lang, '如 1-3,5,7-9（从 1 开始）')}>
    <div class="field-label" style="margin-top:10px;"><span>{tu(lang, '状态')}</span></div>
    <div id="ex-status" class="ex-status">{tu(lang, '尚未选择文件')}</div>
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '说明')}</span></div>
    <div class="ex-help">
      {tu(lang, '按页码把指定页抽出来合成新 PDF。')}<br>
      {tu(lang, '支持范围（1-3）与逗号分隔（5,7）。')}<br>
      {tu(lang, '全部本地处理，文件不上传。')}
    </div>
  </div>
</div>
<div class="btn-row">
  <button id="ex-run" class="primary">{tu(lang, '提取并下载')}</button>
  <span id="ex-msg" class="msg"></span>
</div>

<style>
  .ex-status, .ex-help {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px;
    min-height: 120px;
    color: var(--text-sub);
    background: var(--bg-soft);
    line-height: 1.7;
  }
</style>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  import { PDFDocument } from 'pdf-lib';
  const $ = (id) => document.getElementById(id);
  let bytes = null;
  function parseRanges(s, total) {
    const out = [];
    const parts = s.split(',').map((x) => x.trim()).filter(Boolean);
    for (const p of parts) {
      if (p.includes('-')) {
        const [a, b] = p.split('-').map((x) => parseInt(x, 10));
        if (!a || !b || a > b) throw new Error(tu(LANG, '范围格式错误：') + p);
        for (let i = a; i <= b; i++) out.push(i);
      } else {
        const n = parseInt(p, 10);
        if (!n) throw new Error(tu(LANG, '页码格式错误：') + p);
        out.push(n);
      }
    }
    const idx = out.map((n) => n - 1).filter((n) => n >= 0 && n < total);
    if (!idx.length) throw new Error(tu(LANG, '没有有效的页码'));
    return [...new Set(idx)];
  }
  $('ex-file').addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    bytes = new Uint8Array(await file.arrayBuffer());
    const doc = await PDFDocument.load(bytes);
    $('ex-status').textContent = `已载入，共 ${doc.getPageCount()} 页`;
  });
  $('ex-run').addEventListener('click', async () => {
    if (!bytes) { $('ex-msg').textContent = tu(LANG, '请先选择 PDF 文件'); $('ex-msg').className = 'msg err'; return; }
    try {
      const doc = await PDFDocument.load(bytes);
      const total = doc.getPageCount();
      const idx = parseRanges($('ex-range').value, total);
      const out = await PDFDocument.create();
      const pages = await out.copyPages(doc, idx);
      pages.forEach((p) => out.addPage(p));
      const data = await out.save();
      const blob = new Blob([data], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = 'extracted.pdf'; a.click();
      $('ex-msg').textContent = `已提取 ${idx.length} 页`; $('ex-msg').className = 'msg ok';
    } catch (err) { $('ex-msg').textContent = tu(LANG, '处理失败：') + err.message; $('ex-msg').className = 'msg err'; }
  });
</script>
