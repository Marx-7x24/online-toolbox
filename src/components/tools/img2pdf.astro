---
import { tu } from '../../i18n/toolUi.ts';

interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---

<div class="tip">{tu(lang, '图片与生成的 PDF 都不离开你的浏览器，适合处理敏感扫描件。')}</div>

<div class="btn-row" style="align-items:center;">
  <input type="file" id="i2p-file" accept="image/*" multiple style="width:auto;font-family:inherit;padding:6px;border:none;" />
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-top:12px;">
  <div>
    <div class="field-label"><span>{tu(lang, '页面尺寸')}</span></div>
    <select id="i2p-size">
      <option value="fit">{tu(lang, '适应图片原始尺寸')}</option>
      <option value="a4" selected>A4 210×297 mm</option>
      <option value="a5">A5 148×210 mm</option>
      <option value="letter">Letter 216×279 mm</option>
    </select>
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '方向')}</span></div>
    <select id="i2p-orient">
      <option value="portrait">{tu(lang, '纵向')}</option>
      <option value="landscape">{tu(lang, '横向')}</option>
      <option value="auto">{tu(lang, '按图片自动')}</option>
    </select>
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '页边距')}</span><span id="i2p-m-val">20 pt</span></div>
    <input type="range" id="i2p-m" min="0" max="80" value="20" style="padding:0;" />
  </div>
</div>

<div class="btn-row">
  <button class="primary" id="i2p-go">{tu(lang, '生成')} PDF</button>
  <button id="i2p-clear">{tu(lang, '清空')}</button>
</div>

<p class="msg" id="i2p-msg"></p>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  import { PDFDocument } from 'pdf-lib';

  const $ = (id) => document.getElementById(id);
  const PAGE_MM = { a4: [210, 297], a5: [148, 210], letter: [216, 279] };

  $('i2p-m').oninput = () => { $('i2p-m-val').textContent = $('i2p-m').value + ' pt'; };

  function loadImage(src) {
    return new Promise((res, rej) => {
      const img = new Image();
      img.onload = () => res(img);
      img.onerror = rej;
      img.src = src;
    });
  }

  // pdf-lib 只吃 JPG/PNG，先把任意格式统一转 JPEG
  async function toJpeg(img) {
    const canvas = document.createElement('canvas');
    canvas.width = img.width;
    canvas.height = img.height;
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(img, 0, 0);
    return await new Promise((res) => canvas.toBlob(res, 'image/jpeg', 0.92));
  }

  $('i2p-go').onclick = async () => {
    const files = Array.from($('i2p-file').files || []);
    if (!files.length) { $('i2p-msg').textContent = tu(LANG, '请先选择图片'); $('i2p-msg').className = 'msg err'; return; }
    $('i2p-msg').textContent = tu(LANG, '处理中… 0 / ') + files.length;
    $('i2p-msg').className = 'msg';

    try {
      const doc = await PDFDocument.create();
      const margin = +$('i2p-m').value;
      const sizeKey = $('i2p-size').value;
      const orient = $('i2p-orient').value;

      for (let i = 0; i < files.length; i++) {
        const img = await loadImage(URL.createObjectURL(files[i]));
        const jpeg = await toJpeg(img);
        const bytes = new Uint8Array(await jpeg.arrayBuffer());
        const embed = await doc.embedJpg(bytes);

        let pw, ph;
        if (sizeKey === 'fit') {
          pw = img.width; ph = img.height;
        } else {
          const [a, b] = PAGE_MM[sizeKey];
          const pt = (mm) => Math.round((mm / 25.4) * 72);
          pw = pt(a); ph = pt(b);
          if (orient === 'landscape' || (orient === 'auto' && img.width > img.height)) { const t = pw; pw = ph; ph = t; }
        }

        const page = doc.addPage([pw, ph]);
        const maxW = pw - margin * 2;
        const maxH = ph - margin * 2;
        const scale = Math.min(maxW / embed.width, maxH / embed.height);
        const w = embed.width * scale;
        const h = embed.height * scale;
        page.drawImage(embed, { x: (pw - w) / 2, y: (ph - h) / 2, width: w, height: h });
        $('i2p-msg').textContent = `处理中… ${i + 1} / ${files.length}`;
      }

      const pdfBytes = await doc.save();
      const url = URL.createObjectURL(new Blob([pdfBytes], { type: 'application/pdf' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = 'images.pdf';
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 5000);
      $('i2p-msg').textContent = `已生成包含 ${files.length} 页的 PDF，开始下载`;
      $('i2p-msg').className = 'msg ok';
    } catch (e) {
      $('i2p-msg').textContent = tu(LANG, '生成失败：') + e.message;
      $('i2p-msg').className = 'msg err';
    }
  };

  $('i2p-clear').onclick = () => {
    $('i2p-file').value = '';
    $('i2p-msg').textContent = '';
  };
</script>
