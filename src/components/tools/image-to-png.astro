---
// 任意图片格式 → PNG（浏览器端 Canvas 编码）
---
<div class="pane">
  <div>
    <div class="field-label"><span>选择图片</span></div>
    <input type="file" id="itpng-file" accept="image/*">
    <div id="itpng-info" class="msg"></div>
  </div>
  <div>
    <div class="field-label"><span>PNG 预览</span></div>
    <div id="itpng-preview" class="itpng-preview"></div>
  </div>
</div>
<div class="btn-row">
  <button id="itpng-run" class="primary">转换为 PNG</button>
  <button id="itpng-dl">下载 PNG</button>
  <button id="itpng-reset">重置</button>
  <span id="itpng-msg" class="msg"></span>
</div>

<style>
  .itpng-preview { margin-top: 10px; border: 1px dashed var(--border); border-radius: 8px; padding: 10px; min-height: 120px; display: flex; align-items: center; justify-content: center; background: #fafafa; }
  .itpng-preview img { max-width: 100%; max-height: 320px; }
  .itpng-preview:empty::before { content: '尚未选择图片'; color: #999; }
</style>

<script>
  const $ = (id) => document.getElementById(id);
  let sourceFile = null;
  let pngBlob = null;

  $('itpng-file').addEventListener('change', (e) => {
    const f = e.target.files[0];
    if (!f) return;
    sourceFile = f;
    $('itpng-info').textContent = `已选择：${f.name} · ${(f.size/1024).toFixed(1)} KB · ${f.type || '未知类型'}`;
    $('itpng-info').className = 'msg ok';
  });

  $('itpng-run').addEventListener('click', async () => {
    if (!sourceFile) { $('itpng-msg').textContent = '请先选择图片'; $('itpng-msg').className = 'msg err'; return; }
    try {
      const bitmap = await createImageBitmap(sourceFile);
      const canvas = document.createElement('canvas');
      canvas.width = bitmap.width; canvas.height = bitmap.height;
      canvas.getContext('2d').drawImage(bitmap, 0, 0);
      pngBlob = await new Promise((res, rej) => canvas.toBlob(b => b ? res(b) : rej(new Error('PNG 编码失败')), 'image/png'));
      $('itpng-preview').innerHTML = `<img alt="预览">`;
      $('itpng-preview').querySelector('img').src = URL.createObjectURL(pngBlob);
      $('itpng-msg').textContent = `转换成功 · ${(pngBlob.size/1024).toFixed(1)} KB`;
      $('itpng-msg').className = 'msg ok';
    } catch (err) {
      $('itpng-msg').textContent = '转换失败：' + err.message;
      $('itpng-msg').className = 'msg err';
    }
  });

  $('itpng-dl').addEventListener('click', () => {
    if (!pngBlob) { $('itpng-msg').textContent = '请先转换'; $('itpng-msg').className = 'msg err'; return; }
    const a = document.createElement('a');
    a.href = URL.createObjectURL(pngBlob);
    a.download = (sourceFile.name.replace(/\.[^.]+$/, '') || 'image') + '.png';
    a.click();
  });

  $('itpng-reset').addEventListener('click', () => {
    sourceFile = null; pngBlob = null;
    $('itpng-file').value = '';
    $('itpng-info').textContent = '';
    $('itpng-preview').innerHTML = '';
    $('itpng-msg').textContent = '';
  });
</script>
