---
// 随机昵称生成：中文词表，本地生成
---
<div>
  <div class="field-label"><span>生成数量</span></div>
  <input type="number" id="nk-n" min="1" max="20" value="6">
  <label class="chk"><input type="checkbox" id="nk-suf" checked> 加后缀（呀/酱/同学…）</label>
  <div class="field-label" style="margin-top:12px;"><span>结果</span></div>
  <div id="nk-out" class="nk-out">点击生成</div>
</div>
<div class="btn-row">
  <button id="nk-gen" class="primary">生成</button>
  <button id="nk-copy">复制</button>
  <span id="nk-msg" class="msg"></span>
</div>

<style>
  .chk { display: inline-flex; align-items: center; gap: 6px; margin: 10px 14px 0 0; font-size: 13px; color: var(--text-sub); }
  .nk-out { border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; min-height: 80px; line-height: 2; background: var(--bg-soft); word-break: break-all; }
</style>

<script>
  const $ = (id) => document.getElementById(id);
  const ADJ = ['安静的', '快乐', '迷糊', '温柔', '酷酷', '软萌', '元气', '佛系', '文艺', '暴躁', '清冷', '甜甜', '咸鱼', '热血', '慢半拍', '爱睡', '话少', '摸鱼', '半糖', '微醺'];
  const NOUN = ['小猫', '星辰', '月亮', '橘子', '海风', '云朵', '柚子', '苏打', '鹿', '鲸鱼', '栗子', '兔子', '山茶', '麦穗', '泡芙', '布丁', '海盐', '椰汁', '风铃', '苔藓'];
  const SUF = ['呀', '酱', '同学', '君', '小', '本尊', 'ing', '酱紫', 'kid', '君'];
  const pick = (a) => a[Math.floor(Math.random() * a.length)];
  function gen() {
    const n = Math.max(1, Math.min(20, parseInt($('nk-n').value, 10) || 6));
    const list = [];
    for (let i = 0; i < n; i++) {
      let u = pick(ADJ) + pick(NOUN);
      if ($('nk-suf').checked) u += pick(SUF);
      list.push(u);
    }
    $('nk-out').textContent = list.join('\n');
    $('nk-msg').textContent = `已生成 ${n} 个`; $('nk-msg').className = 'msg ok';
  }
  $('nk-gen').addEventListener('click', gen);
  $('nk-copy').addEventListener('click', async () => {
    if (!$('nk-out').textContent || $('nk-out').textContent === '点击生成') return;
    try { await navigator.clipboard.writeText($('nk-out').textContent); $('nk-msg').textContent = '已复制'; $('nk-msg').className = 'msg ok'; }
    catch { $('nk-msg').textContent = '复制失败'; $('nk-msg').className = 'msg err'; }
  });
  gen();
</script>
