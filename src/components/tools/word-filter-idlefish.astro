---
import { tu } from '../../i18n/toolUi.ts';
// 闲鱼违禁词过滤：检测/高亮平台限流词，可一键净化文本（内置演示词表 + 自定义）
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div class="pane">
  <div>
    <div class="field-label"><span>{tu(lang, '待检测文本')}</span></div>
    <textarea id="wf-in" placeholder={tu(lang, '粘贴商品描述…')} style="width:100%;height:240px;padding:10px;border:1px solid var(--border-color);border-radius:8px;box-sizing:border-box;resize:vertical;font-size:14px"></textarea>
    <div class="field-label" style="margin-top:12px"><span>{tu(lang, '自定义补充词（每行一个')}）</span></div>
    <textarea id="wf-custom" placeholder={tu(lang, '选填，每行一个词')} style="width:100%;height:70px;padding:10px;border:1px solid var(--border-color);border-radius:8px;box-sizing:border-box;font-size:13px"></textarea>
    <div class="btn-row" style="margin-top:12px">
      <button id="wf-run" class="primary">{tu(lang, '检测')}</button>
      <button id="wf-clean">{tu(lang, '复制净化文本')}</button>
      <button id="wf-clear">{tu(lang, '清空')}</button>
    </div>
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '检测结果（命中词高亮')}）</span></div>
    <div id="wf-out" style="border:1px solid var(--border-color);border-radius:8px;padding:10px;min-height:240px;max-height:340px;overflow:auto;font-size:14px;line-height:1.7;background:#fff"></div>
    <p class="msg" id="wf-msg"></p>
  </div>
</div>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);
  const BUILTIN = [tu(LANG, '微信'),'vx','VX',tu(LANG, '薇信'),'qq','QQ',tu(LANG, '支付宝'),tu(LANG, '淘宝'),tu(LANG, '京东'),tu(LANG, '拼多多'),tu(LANG, '线下交易'),tu(LANG, '不通过平台'),tu(LANG, '担保交易'),tu(LANG, '走平台外'),tu(LANG, '加我'),tu(LANG, '私聊'),tu(LANG, '微信转账'),tu(LANG, '现金交易'),tu(LANG, '面交'),tu(LANG, '一口价'),tu(LANG, '可小刀'),tu(LANG, '诚心出'),tu(LANG, '招代理'),tu(LANG, '代购'),tu(LANG, '刷单'),tu(LANG, '引流'),tu(LANG, '私下'),tu(LANG, '链接'),tu(LANG, '二维码')];
  function list(){
    const s = new Set(BUILTIN);
    $('wf-custom').value.split('\n').map(x=>x.trim()).filter(Boolean).forEach(w=>s.add(w));
    return Array.from(s).sort((a,b)=>b.length-a.length);
  }
  function escapeHtml(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
  $('wf-run').addEventListener('click', () => {
    const text = $('wf-in').value;
    if (!text){ $('wf-out').innerHTML=''; $('wf-msg').textContent=''; return; }
    const words = list(); let count=0;
    let html = escapeHtml(text);
    words.forEach(w => {
      const re = new RegExp(w.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'), 'g');
      html = html.replace(re, (m)=>{ count++; return '<mark style="background:#ffe08a;color:#7a4b00;padding:0 2px;border-radius:3px">'+m+'</mark>'; });
    });
    $('wf-out').innerHTML = html;
    $('wf-msg').textContent = count ? `共命中 ${count} 处，建议修改后再发布` : '未发现明显违禁词（演示词表，非官方完整清单）';
    $('wf-msg').className = count ? 'msg err' : 'msg ok';
  });
  $('wf-clean').addEventListener('click', () => {
    const text = $('wf-in').value; if(!text) return;
    const words = list(); let out = text;
    words.forEach(w => { out = out.split(w).join(''); });
    navigator.clipboard.writeText(out).then(()=>{ $('wf-msg').textContent=tu(LANG, '已复制净化后文本（移除命中词）'); $('wf-msg').className='msg ok'; });
  });
  $('wf-clear').addEventListener('click', () => { $('wf-in').value=''; $('wf-custom').value=''; $('wf-out').innerHTML=''; $('wf-msg').textContent=''; });
</script>
