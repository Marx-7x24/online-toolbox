---
// weight-converter：纯前端单位换算（系数型）
const UNITS = [{"sym":"t","zh":"吨","f":1000},{"sym":"kg","zh":"千克","f":1},{"sym":"g","zh":"克","f":0.001},{"sym":"mg","zh":"毫克","f":0.000001},{"sym":"jin","zh":"斤","f":0.5},{"sym":"liang","zh":"两","f":0.05},{"sym":"qian","zh":"钱","f":0.005},{"sym":"lb","zh":"磅","f":0.45359237},{"sym":"oz","zh":"盎司","f":0.028349523},{"sym":"st","zh":"英石","f":6.35029318},{"sym":"ct","zh":"克拉","f":0.0002}];
const BASE = { name: "千克", sym: "kg" };
---
<div class="pane">
  <div>
    <div class="field-label"><span>数值</span></div>
    <input type="number" id="uc-val" value="1" step="any" style="width:100%;padding:8px;border:1px solid var(--border-color);border-radius:6px;box-sizing:border-box;font-size:16px">
    <div class="field-label" style="margin-top:12px"><span>从</span></div>
    <select id="uc-from" style="width:100%;padding:8px;border:1px solid var(--border-color);border-radius:6px;background:#fff;font-size:14px">
      <option value="t" data-f="1000">吨 (t)</option>
      <option value="kg" data-f="1">千克 (kg)</option>
      <option value="g" data-f="0.001">克 (g)</option>
      <option value="mg" data-f="0.000001">毫克 (mg)</option>
      <option value="jin" data-f="0.5">斤 (jin)</option>
      <option value="liang" data-f="0.05">两 (liang)</option>
      <option value="qian" data-f="0.005">钱 (qian)</option>
      <option value="lb" data-f="0.45359237">磅 (lb)</option>
      <option value="oz" data-f="0.028349523">盎司 (oz)</option>
      <option value="st" data-f="6.35029318">英石 (st)</option>
      <option value="ct" data-f="0.0002">克拉 (ct)</option>
    </select>
    <div style="text-align:center;margin:8px 0">
      <button id="uc-swap">⇅ 交换单位</button>
    </div>
    <div class="field-label"><span>到</span></div>
    <select id="uc-to" style="width:100%;padding:8px;border:1px solid var(--border-color);border-radius:6px;background:#fff;font-size:14px">
      <option value="t" data-f="1000">吨 (t)</option>
      <option value="kg" data-f="1">千克 (kg)</option>
      <option value="g" data-f="0.001">克 (g)</option>
      <option value="mg" data-f="0.000001">毫克 (mg)</option>
      <option value="jin" data-f="0.5">斤 (jin)</option>
      <option value="liang" data-f="0.05">两 (liang)</option>
      <option value="qian" data-f="0.005">钱 (qian)</option>
      <option value="lb" data-f="0.45359237">磅 (lb)</option>
      <option value="oz" data-f="0.028349523">盎司 (oz)</option>
      <option value="st" data-f="6.35029318">英石 (st)</option>
      <option value="ct" data-f="0.0002">克拉 (ct)</option>
    </select>
    <div style="margin-top:16px;padding:14px;background:rgba(0,0,0,.03);border-radius:8px">
      <div id="uc-out" style="font-size:20px;font-weight:600;color:var(--primary-color);word-break:break-all;line-height:1.5">-</div>
      <div style="font-size:12px;color:var(--text-sub);margin-top:4px">换算结果</div>
    </div>
  </div>
  <div>
    <div class="field-label"><span>等于以下所有单位</span></div>
    <table id="uc-table" style="width:100%;border-collapse:collapse;font-size:14px"></table>
    <p class="msg" id="uc-msg"></p>
  </div>
</div>

<script>
const $ = (id) => document.getElementById(id);
const UNITS = [{"sym":"t","zh":"吨","f":1000},{"sym":"kg","zh":"千克","f":1},{"sym":"g","zh":"克","f":0.001},{"sym":"mg","zh":"毫克","f":0.000001},{"sym":"jin","zh":"斤","f":0.5},{"sym":"liang","zh":"两","f":0.05},{"sym":"qian","zh":"钱","f":0.005},{"sym":"lb","zh":"磅","f":0.45359237},{"sym":"oz","zh":"盎司","f":0.028349523},{"sym":"st","zh":"英石","f":6.35029318},{"sym":"ct","zh":"克拉","f":0.0002}];
function fmt(n){
  if (!isFinite(n)) return '-';
  if (n !== 0 && (Math.abs(n) < 1e-6 || Math.abs(n) >= 1e15)) return n.toExponential(6).replace(/(\.\d*?[1-9])0+e|\.0+e/g, '$1e');
  const s = n.toLocaleString('zh-CN', { maximumFractionDigits: 10 });
  return s;
}
function factorOf(sel){
  const opt = sel.options[sel.selectedIndex];
  return parseFloat(opt.dataset.f);
}
function symOf(sel){ return sel.value; }
function convert(){
  const v = parseFloat($('uc-val').value);
  if (isNaN(v)){ $('uc-out').textContent = '-'; $('uc-table').innerHTML=''; return; }
  const from = factorOf($('uc-from')), to = factorOf($('uc-to'));
  const base = v * from;
  const out = base / to;
  $('uc-out').textContent = fmt(out) + ' ' + symOf($('uc-to'));
  let html = '';
  for (const u of UNITS){
    html += '<tr style="border-bottom:1px solid var(--border-color)">' +
      '<td style="padding:7px 4px;color:var(--text-sub)">' + u.zh + ' (' + u.sym + ')</td>' +
      '<td style="padding:7px 4px;text-align:right;font-weight:600">' + fmt(base / u.f) + '</td></tr>';
  }
  $('uc-table').innerHTML = html;
}
['uc-val','uc-from','uc-to'].forEach(id => $(id).addEventListener('input', convert));
$('uc-from').addEventListener('change', convert);
$('uc-to').addEventListener('change', convert);
$('uc-swap').addEventListener('click', () => {
  const a = $('uc-from').selectedIndex, b = $('uc-to').selectedIndex;
  $('uc-from').selectedIndex = b; $('uc-to').selectedIndex = a;
  convert();
});
// 默认：从基准单位到第二个单位
$('uc-from').selectedIndex = UNITS.findIndex(u => u.sym === "kg");
if ($('uc-to').selectedIndex === $('uc-from').selectedIndex) $('uc-to').selectedIndex = ("kg" === 'm/s' ? 1 : 0);
if ($('uc-to').selectedIndex === $('uc-from').selectedIndex && $('uc-to').length > 1) $('uc-to').selectedIndex = 1;
convert();
</script>
