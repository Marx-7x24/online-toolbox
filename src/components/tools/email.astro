---
// 邮箱格式校验：批量校验邮箱格式，并标记一次性/临时邮箱域名
---
<div class="pane">
  <div>
    <div class="field-label"><span>邮箱（每行一个）</span></div>
    <textarea id="em-in" placeholder="user@example.com&#10;test@mailinator.com" style="width:100%;height:260px;padding:10px;border:1px solid var(--border-color);border-radius:8px;box-sizing:border-box;font-size:14px;resize:vertical"></textarea>
    <div class="btn-row" style="margin-top:12px">
      <button id="em-run" class="primary">校验</button>
      <button id="em-clear">清空</button>
    </div>
  </div>
  <div>
    <div class="field-label"><span>结果</span></div>
    <div id="em-out" style="border:1px solid var(--border-color);border-radius:8px;padding:8px;min-height:260px;max-height:340px;overflow:auto;font-size:13px;background:var(--hover-bg)"></div>
    <p class="msg" id="em-msg"></p>
  </div>
</div>

<script>
  const $ = (id) => document.getElementById(id);
  const RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const DISPOSABLE = ['mailinator.com','10minutemail.com','tempmail.com','guerrillamail.com','yopmail.com','trashmail.com','temp-mail.org','getnada.com','sharklasers.com','dispostable.com','fakeinbox.com','maildrop.cc'];
  $('em-run').addEventListener('click', () => {
    const lines = $('em-in').value.split('\n').map(s=>s.trim()).filter(Boolean);
    if (!lines.length){ $('em-out').innerHTML=''; $('em-msg').textContent=''; return; }
    let ok=0, bad=0, disp=0;
    const html = lines.map(e=>{
      const valid = RE.test(e);
      let tag='', cls='';
      if (!valid){ bad++; tag='格式错误'; cls='err'; }
      else {
        const dom = e.split('@')[1].toLowerCase();
        if (DISPOSABLE.includes(dom)){ disp++; tag='临时邮箱'; cls='warn'; }
        else { ok++; tag='有效'; cls='ok'; }
      }
      const c = cls==='err'?'#d92c2c':cls==='warn'?'#b7791f':'#0f9960';
      return `<div style="display:flex;justify-content:space-between;gap:8px;padding:4px 6px;border-bottom:1px solid var(--border-color)">
        <span style="word-break:break-all">${e.replace(/</g,'&lt;')}</span>
        <span style="color:${c};font-weight:600;white-space:nowrap">${tag}</span></div>`;
    }).join('');
    $('em-out').innerHTML = html;
    $('em-msg').textContent = `有效 ${ok} · 临时邮箱 ${disp} · 格式错误 ${bad}`;
    $('em-msg').className = 'msg';
  });
  $('em-clear').addEventListener('click', ()=>{ $('em-in').value=''; $('em-out').innerHTML=''; $('em-msg').textContent=''; });
</script>
