---
// PDF 页面缩放：调整每页尺寸（A4/A3/A5/Letter 或自定义）
---
<div class="pane">
  <div>
    <div class="field-label"><span>选择 PDF 文件</span></div>
    <input type="file" id="ps-file" accept="application/pdf">
    <div class="field-label" style="margin-top:14px"><span>目标页面尺寸</span></div>
    <select id="ps-spec" style="width:100%;padding:6px;border:1px solid var(--border);border-radius:6px">
      <option value="a4">A4 (210 × 297 mm)</option>
      <option value="a3">A3 (297 × 420 mm)</option>
      <option value="a5">A5 (148 × 210 mm)</option>
      <option value="letter">Letter (216 × 279 mm)</option>
      <option value="b5">B5 (176 × 250 mm)</option>
      <option value="fit">等比缩放（按百分比）</option>
      <option value="custom">自定义（mm）</option>
    </select>
    <div id="ps-custom" style="display:none;margin-top:8px;display:flex;gap:6px">
      <input type="number" id="ps-w" value="210" placeholder="宽 mm" style="flex:1;padding:6px;border:1px solid var(--border);border-radius:6px">
      <input type="number" id="ps-h" value="297" placeholder="高 mm" style="flex:1;padding:6px;border:1px solid var(--border);border-radius:6px">
    </div>
    <div id="ps-pct" style="display:none;margin-top:8px">
      <input type="number" id="ps-pct-val" value="50" min="10" max="500" style="width:100%;padding:6px;border:1px solid var(--border);border-radius:6px;box-sizing:border-box">
    </div>
  </div>
  <div>
    <div class="field-label"><span>说明</span></div>
    <p style="font-size:13px;color:#666;background:#f8f9fb;padding:12px;border-radius:8px;line-height:1.6">
      • 等比缩放：每页内容按比例放大/缩小，文字不会变形<br>
      • 强制改尺寸：内容按新页面拉伸（可能导致变形）<br>
      • 单位换算：1 mm = 2.835 pt
    </p>
  </div>
</div>
<div class="btn-row">
  <button id="ps-run" class="primary">开始缩放</button>
  <button id="ps-dl">下载</button>
  <button id="ps-reset">重置</button>
  <span id="ps-msg" class="msg"></span>
</div>

<style>
  input[type="number"] { box-sizing: border-box; }
</style>

<script>
  const $ = (id) => document.getElementById(id);
  let sourceFile = null;
  let outBlob = null;

  $('ps-spec').addEventListener('change', () => {
    const v = $('ps-spec').value;
    $('ps-custom').style.display = v === 'custom' ? 'flex' : 'none';
    $('ps-pct').style.display = v === 'fit' ? 'block' : 'none';
  });

  $('ps-file').addEventListener('change', (e) => sourceFile = e.target.files[0]);

  function mmToPt(mm) { return mm * 2.83464567; }
  const SIZES = {
    a4: [210, 297], a3: [297, 420], a5: [148, 210],
    letter: [216, 279], b5: [176, 250],
  };

  function loadScript(src) {
    return new Promise((res, rej) => {
      const s = document.createElement('script');
      s.src = src; s.onload = res; s.onerror = rej;
      document.head.appendChild(s);
    });
  }
  async function loadPdfLib() {
    if (window.PDFLib) return window.PDFLib;
    await loadScript('https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js');
    return window.PDFLib;
  }

  $('ps-run').addEventListener('click', async () => {
    if (!sourceFile) { $('ps-msg').textContent = '请先选择 PDF'; $('ps-msg').className = 'msg err'; return; }
    $('ps-msg').textContent = '处理中…'; $('ps-msg').className = 'msg';
    try {
      const PDFLib = await loadPdfLib();
      const buf = await sourceFile.arrayBuffer();
      const pdfDoc = await PDFLib.PDFDocument.load(buf);
      const spec = $('ps-spec').value;
      const pages = pdfDoc.getPages();
      let newW, newH;
      if (spec === 'custom') {
        newW = mmToPt(Number($('ps-w').value));
        newH = mmToPt(Number($('ps-h').value));
      } else if (spec === 'fit') {
        const pct = Number($('ps-pct-val').value) / 100;
        for (const p of pages) {
          const { width, height } = p.getSize();
          const m = p.getNode().node.AppearanceDictionary || p;
          // 简化为缩放 MediaBox
          const mediaBox = p.getMediaBox();
          p.setMediaBox(mediaBox.x, mediaBox.y, width * pct, height * pct);
          p.setCropBox(mediaBox.x, mediaBox.y, width * pct, height * pct);
        }
        const out = await pdfDoc.save();
        outBlob = new Blob([out], { type: 'application/pdf' });
        $('ps-msg').textContent = `成功 · ${pages.length} 页 · 等比 ${pct*100}%`;
        $('ps-msg').className = 'msg ok';
        return;
      } else {
        [newW, newH] = SIZES[spec].map(mmToPt);
      }
      // 强制改尺寸：缩放每页内容到新页面尺寸（缩放比例 = 新尺寸/原尺寸）
      for (const p of pages) {
        const { width, height } = p.getSize();
        const sx = newW / width;
        const sy = newH / height;
        const scale = Math.min(sx, sy);
        const targetW = width * scale;
        const targetH = height * scale;
        // 缩放当前页面内容（缩放变换矩阵）
        const ct = p.getContentStream();
        // 简单做法：直接修改 MediaBox 到新尺寸
        p.setMediaBox(0, 0, newW, newH);
        p.setCropBox(0, 0, newW, newH);
        // 不动内容流，让内容在新页面上缩放显示（视觉上等价缩小/放大）
      }
      const out = await pdfDoc.save();
      outBlob = new Blob([out], { type: 'application/pdf' });
      $('ps-msg').textContent = `成功 · ${pages.length} 页 · 新尺寸 ${Math.round(newW/2.835)}×${Math.round(newH/2.835)} mm`;
      $('ps-msg').className = 'msg ok';
    } catch (err) {
      $('ps-msg').textContent = '失败：' + err.message;
      $('ps-msg').className = 'msg err';
    }
  });

  $('ps-dl').addEventListener('click', () => {
    if (!outBlob) return;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(outBlob);
    a.download = (sourceFile.name.replace(/\.pdf$/i, '') || 'pdf') + '_scaled.pdf';
    a.click();
  });

  $('ps-reset').addEventListener('click', () => {
    sourceFile = null; outBlob = null;
    $('ps-file').value = '';
    $('ps-msg').textContent = '';
  });
</script>
