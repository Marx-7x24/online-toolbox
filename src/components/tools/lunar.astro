---
import { tu } from '../../i18n/toolUi.ts';

interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---

<div class="tip">{tu(lang, '农历数据来自浏览器内置的 Chinese 日历，无需联网。不同浏览器显示格式可能略有差异。')}</div>

<div style="display:flex;gap:14px;flex-wrap:wrap;margin-bottom:14px;">
  <button class="primary" id="ln-mode-s">{tu(lang, '公历')} → {tu(lang, '农历')}</button>
  <button id="ln-mode-l">{tu(lang, '农历')} → {tu(lang, '公历')}</button>
</div>

<div id="ln-solar-box">
  <div style="max-width:300px;">
    <div class="field-label"><span>{tu(lang, '公历日期')}</span></div>
    <input type="date" id="ln-date" />
  </div>
  <div class="btn-row">
    <button class="primary" id="ln-go-s">{tu(lang, '查询')}</button>
    <button id="ln-today">{tu(lang, '今天')}</button>
  </div>
</div>

<div id="ln-lunar-box" style="display:none;">
  <div style="display:flex;gap:12px;flex-wrap:wrap;">
    <div style="min-width:130px;">
      <div class="field-label"><span>{tu(lang, '农历年')}</span></div>
      <input type="number" id="ln-y" value="2026" min="1900" max="2100" />
    </div>
    <div style="min-width:120px;">
      <div class="field-label"><span>{tu(lang, '农历月')}</span></div>
      <select id="ln-m">
        <option value="1">{tu(lang, '正月')}</option><option value="2">{tu(lang, '二月')}</option><option value="3">{tu(lang, '三月')}</option>
        <option value="4">{tu(lang, '四月')}</option><option value="5">{tu(lang, '五月')}</option><option value="6">{tu(lang, '六月')}</option>
        <option value="7">{tu(lang, '七月')}</option><option value="8">{tu(lang, '八月')}</option><option value="9">{tu(lang, '九月')}</option>
        <option value="10">{tu(lang, '十月')}</option><option value="11">{tu(lang, '冬月')}</option><option value="12">{tu(lang, '腊月')}</option>
      </select>
    </div>
    <div style="min-width:110px;">
      <div class="field-label"><span>{tu(lang, '农历日')}</span></div>
      <select id="ln-d"></select>
    </div>
    <div style="min-width:120px;">
      <div class="field-label"><span>{tu(lang, '是否闰月')}</span></div>
      <select id="ln-leap">
        <option value="0">{tu(lang, '否')}</option>
        <option value="1">{tu(lang, '是')}</option>
      </select>
    </div>
  </div>
  <div class="btn-row">
    <button class="primary" id="ln-go-l">{tu(lang, '查询')}</button>
  </div>
</div>

<p class="msg" id="ln-msg"></p>
<div id="ln-out"></div>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);
  const GAN = [tu(LANG, '甲'),tu(LANG, '乙'),tu(LANG, '丙'),tu(LANG, '丁'),tu(LANG, '戊'),tu(LANG, '己'),tu(LANG, '庚'),tu(LANG, '辛'),tu(LANG, '壬'),tu(LANG, '癸')];
  const ZHI = [tu(LANG, '子'),tu(LANG, '丑'),tu(LANG, '寅'),tu(LANG, '卯'),tu(LANG, '辰'),tu(LANG, '巳'),tu(LANG, '午'),tu(LANG, '未'),tu(LANG, '申'),tu(LANG, '酉'),tu(LANG, '戌'),tu(LANG, '亥')];
  const ANIMAL = [tu(LANG, '鼠'),tu(LANG, '牛'),tu(LANG, '虎'),tu(LANG, '兔'),tu(LANG, '龙'),tu(LANG, '蛇'),tu(LANG, '马'),tu(LANG, '羊'),tu(LANG, '猴'),tu(LANG, '鸡'),tu(LANG, '狗'),tu(LANG, '猪')];
  const MONTH_NAME = ['',tu(LANG, '正月'),tu(LANG, '二月'),tu(LANG, '三月'),tu(LANG, '四月'),tu(LANG, '五月'),tu(LANG, '六月'),tu(LANG, '七月'),tu(LANG, '八月'),tu(LANG, '九月'),tu(LANG, '十月'),tu(LANG, '冬月'),tu(LANG, '腊月')];
  const DAY_NAME = ['',tu(LANG, '初一'),tu(LANG, '初二'),tu(LANG, '初三'),tu(LANG, '初四'),tu(LANG, '初五'),tu(LANG, '初六'),tu(LANG, '初七'),tu(LANG, '初八'),tu(LANG, '初九'),tu(LANG, '初十'),tu(LANG, '十一'),tu(LANG, '十二'),tu(LANG, '十三'),tu(LANG, '十四'),tu(LANG, '十五'),tu(LANG, '十六'),tu(LANG, '十七'),tu(LANG, '十八'),tu(LANG, '十九'),tu(LANG, '二十'),tu(LANG, '廿一'),tu(LANG, '廿二'),tu(LANG, '廿三'),tu(LANG, '廿四'),tu(LANG, '廿五'),tu(LANG, '廿六'),tu(LANG, '廿七'),tu(LANG, '廿八'),tu(LANG, '廿九'),tu(LANG, '三十')];
  const FESTIVAL = {
    '1-1': tu(LANG, '春节'), '1-15': tu(LANG, '元宵节'), '2-2': tu(LANG, '龙抬头'), '5-5': tu(LANG, '端午节'),
    '7-7': tu(LANG, '七夕'), '7-15': tu(LANG, '中元节'), '8-15': tu(LANG, '中秋节'), '9-9': tu(LANG, '重阳节'),
    '12-8': tu(LANG, '腊八节'), '12-23': tu(LANG, '北方小年'), '12-24': tu(LANG, '南方小年'),
  };

  const fmt = new Intl.DateTimeFormat('zh-CN-u-ca-chinese', { year: 'numeric', month: 'numeric', day: 'numeric' });

  function chineseToNum(s) {
    const map = { 正: 1, 一: 1, 二: 2, 三: 3, 四: 4, 五: 5, 六: 6, 七: 7, 八: 8, 九: 9, 十: 10, 冬: 11, 腊: 12, 闰: 0 };
    s = s.replace(/[月日年]/g, '');
    if (/^\d+$/.test(s)) return parseInt(s, 10);
    let leap = false;
    if (s.startsWith(tu(LANG, '闰'))) { leap = true; s = s.slice(1); }
    let n = 0;
    if (s.includes(tu(LANG, '十'))) {
      const [a, b] = s.split(tu(LANG, '十'));
      n = (a ? map[a] || 0 : 1) * 10 + (b ? map[b] || 0 : 0);
    } else {
      n = map[s] || 0;
    }
    return { n, leap };
  }

  function toLunar(date) {
    const parts = fmt.formatToParts(date);
    const get = (t) => (parts.find((p) => p.type === t) || {}).value || '';
    const rawMonth = get('month');
    const rawDay = get('day');
    const parsed = chineseToNum(rawMonth);
    return {
      year: parseInt(get('year'), 10) || date.getFullYear(),
      month: parsed.n || parseInt(rawMonth, 10) || 1,
      day: chineseToNum(rawDay).n || parseInt(rawDay, 10) || 1,
      leap: parsed.leap,
      raw: fmt.format(date),
    };
  }

  function ganzhi(year) {
    const i = ((year - 4) % 10 + 10) % 10;
    const j = ((year - 4) % 12 + 12) % 12;
    return { gz: GAN[i] + ZHI[j], animal: ANIMAL[j], gan: GAN[i], zhi: ZHI[j] };
  }

  function toSolar(ly, lm, ld, leap) {
    // 在公历候选区间内搜索匹配的农历日期
    const start = new Date(ly - 1, 0, 1);
    for (let i = 0; i < 800; i++) {
      const d = new Date(start.getTime() + i * 86400000);
      const l = toLunar(d);
      if (l.year === ly && l.month === lm && l.day === ld && (!!l.leap === !!leap)) return d;
    }
    return null;
  }

  function showSolar(date) {
    const l = toLunar(date);
    const g = ganzhi(l.year);
    const fest = FESTIVAL[l.month + '-' + l.day];
    const solarStr = `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日 星期${tu(LANG, '日一二三四五六')[date.getDay()]}`;
    $('ln-out').innerHTML = `
      <table class="result-table" style="margin-top:14px;max-width:520px;">
        <tr><th>公历</th><td>${solarStr}</td></tr>
        <tr><th>农历</th><td>${l.year}年${l.leap ? '闰' : ''}${MONTH_NAME[l.month]}${DAY_NAME[l.day] || l.day + tu(LANG, '日')}</td></tr>
        <tr><th>干支</th><td>${g.gz}年（${g.gan}·${g.zhi}）</td></tr>
        <tr><th>生肖</th><td>${g.animal}</td></tr>
        ${fest ? `<tr><th>节日</th><td style="color:var(--danger);">${fest}</td></tr>` : ''}
        <tr><th>原始输出</th><td style="color:var(--text-hint);font-size:12px;">${l.raw}</td></tr>
      </table>`;
    $('ln-msg').textContent = tu(LANG, '查询完成');
    $('ln-msg').className = 'msg ok';
  }

  // 农历日下拉
  for (let i = 1; i <= 30; i++) {
    const o = document.createElement('option');
    o.value = String(i);
    o.textContent = DAY_NAME[i];
    $('ln-d').appendChild(o);
  }

  $('ln-mode-s').onclick = () => {
    $('ln-solar-box').style.display = 'block';
    $('ln-lunar-box').style.display = 'none';
    $('ln-mode-s').className = 'primary';
    $('ln-mode-l').className = '';
    $('ln-out').innerHTML = '';
    $('ln-msg').textContent = '';
  };
  $('ln-mode-l').onclick = () => {
    $('ln-solar-box').style.display = 'none';
    $('ln-lunar-box').style.display = 'block';
    $('ln-mode-l').className = 'primary';
    $('ln-mode-s').className = '';
    $('ln-out').innerHTML = '';
    $('ln-msg').textContent = '';
  };

  $('ln-go-s').onclick = () => {
    if (!$('ln-date').value) { $('ln-msg').textContent = tu(LANG, '请选择日期'); $('ln-msg').className = 'msg err'; return; }
    showSolar(new Date($('ln-date').value + 'T12:00:00'));
  };
  $('ln-today').onclick = () => {
    const d = new Date();
    $('ln-date').value = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    showSolar(d);
  };

  $('ln-go-l').onclick = () => {
    const y = +$('ln-y').value, m = +$('ln-m').value, dd = +$('ln-d').value, leap = $('ln-leap').value === '1';
    const r = toSolar(y, m, dd, leap);
    if (!r) { $('ln-msg').textContent = tu(LANG, '未找到对应的公历日期，请检查输入'); $('ln-msg').className = 'msg err'; $('ln-out').innerHTML = ''; return; }
    const g = ganzhi(y);
    $('ln-out').innerHTML = `
      <table class="result-table" style="margin-top:14px;max-width:520px;">
        <tr><th>农历</th><td>${y}年${leap ? '闰' : ''}${MONTH_NAME[m]}${DAY_NAME[dd]}</td></tr>
        <tr><th>公历</th><td style="font-size:16px;font-weight:500;">${r.getFullYear()}年${r.getMonth() + 1}月${r.getDate()}日 星期${tu(LANG, '日一二三四五六')[r.getDay()]}</td></tr>
        <tr><th>干支生肖</th><td>${g.gz}年 · ${g.animal}</td></tr>
      </table>`;
    $('ln-msg').textContent = tu(LANG, '转换完成');
    $('ln-msg').className = 'msg ok';
  };

  $('ln-today').click();
</script>
