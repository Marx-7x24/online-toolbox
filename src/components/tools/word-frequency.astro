---
import { tu } from '../../i18n/toolUi.ts';
// 词频统计：本地计数
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div class="pane">
  <div>
    <div class="field-label"><span>{tu(lang, '输入文本')}</span></div>
    <textarea id="wf-in" placeholder={tu(lang, '粘贴文章或段落')}></textarea>
    <div class="field-label" style="margin-top:10px;"><span>{tu(lang, '显示前 N 个')}</span></div>
    <input type="number" id="wf-n" min="5" max="50" value="15">
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '词频（中文按字、英文按词')}）</span></div>
    <div id="wf-out" class="wf-out">{tu(lang, '等待统计')}</div>
  </div>
</div>
<div class="btn-row">
  <button id="wf-run" class="primary">{tu(lang, '统计')}</button>
  <span id="wf-msg" class="msg"></span>
</div>

<style>
  .wf-out { border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; min-height: 200px; background: var(--bg-soft); font-size: 13px; line-height: 1.9; }
  .wf-out .row { display: grid; grid-template-columns: 1fr 70px; gap: 8px; align-items: center; }
  .wf-out .bar { height: 8px; background: var(--link); border-radius: 4px; }
</style>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);
  $('wf-run').addEventListener('click', () => {
    const text = $('wf-in').value;
    if (!text) { $('wf-out').textContent = tu(LANG, '等待统计'); return; }
    const cnt = {};
    const en = text.toLowerCase().match(/[a-z0-9]+/g) || [];
    en.forEach((w) => { cnt[w] = (cnt[w] || 0) + 1; });
    for (const ch of text) { if (/[一-龥]/.test(ch)) cnt[ch] = (cnt[ch] || 0) + 1; }
    const top = Object.entries(cnt).sort((a, b) => b[1] - a[1]).slice(0, Math.max(5, Math.min(50, parseInt($('wf-n').value, 10) || 15)));
    const max = top.length ? top[0][1] : 1;
    $('wf-out').innerHTML = top.map(([w, c]) => `<div class="row"><span>${w}（${c}）</span><span class="bar" style="width:${(c / max * 70).toFixed(0)}px"></span></div>`).join('');
    $('wf-msg').textContent = `共 ${Object.keys(cnt).length} 个不同词/字`; $('wf-msg').className = 'msg ok';
  });
</script>
