---
---

<div class="tip">密码用浏览器随机数在本地生成，不经过网络，页面关闭即消失。</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;max-width:720px;">
  <div>
    <div class="field-label"><span>密码长度</span><span id="pw-len-val">16</span></div>
    <input type="range" id="pw-len" min="6" max="64" value="16" style="padding:0;" />
  </div>
  <div>
    <div class="field-label"><span>生成数量</span></div>
    <select id="pw-count">
      <option value="1">1 个</option>
      <option value="5" selected>5 个</option>
      <option value="10">10 个</option>
      <option value="20">20 个</option>
    </select>
  </div>
</div>

<div style="margin-top:14px;">
  <div class="field-label"><span>字符组合</span></div>
  <div style="display:flex;flex-wrap:wrap;gap:14px;font-size:14px;">
    <label><input type="checkbox" id="pw-lower" checked /> 小写字母</label>
    <label><input type="checkbox" id="pw-upper" checked /> 大写字母</label>
    <label><input type="checkbox" id="pw-digit" checked /> 数字</label>
    <label><input type="checkbox" id="pw-symbol" checked /> 符号</label>
    <label><input type="checkbox" id="pw-nosimilar" /> 排除易混字符 0O1lI</label>
  </div>
</div>

<div class="btn-row">
  <button class="primary" id="pw-gen">生成</button>
  <button id="pw-copy">复制全部</button>
  <button id="pw-clear">清空</button>
</div>

<textarea id="pw-out" readonly placeholder="生成结果" style="min-height:180px;"></textarea>

<p class="msg" id="pw-msg"></p>
<div id="pw-strength"></div>

<script>
  const $ = (id) => document.getElementById(id);
  const SETS = {
    lower: 'abcdefghijklmnopqrstuvwxyz',
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    digit: '0123456789',
    symbol: '!@#$%^&*()-_=+[]{};:,.<>?',
  };
  const SIMILAR = /[0O1lI]/g;

  function pool() {
    let p = '';
    if ($('pw-lower').checked) p += SETS.lower;
    if ($('pw-upper').checked) p += SETS.upper;
    if ($('pw-digit').checked) p += SETS.digit;
    if ($('pw-symbol').checked) p += SETS.symbol;
    if ($('pw-nosimilar').checked) p = p.replace(SIMILAR, '');
    return p;
  }

  function rand(max) {
    const a = new Uint32Array(1);
    crypto.getRandomValues(a);
    return a[0] % max;
  }

  function make(length, chars) {
    let out = '';
    for (let i = 0; i < length; i++) out += chars[rand(chars.length)];
    return out;
  }

  function entropy(length, charsetSize) {
    return Math.round(length * Math.log2(charsetSize));
  }

  function label(bits) {
    if (bits < 45) return ['弱', 'var(--danger)'];
    if (bits < 70) return ['中等', 'var(--text-sub)'];
    if (bits < 100) return ['强', 'var(--success)'];
    return ['极强', 'var(--success)'];
  }

  function gen() {
    const chars = pool();
    if (!chars) {
      $('pw-msg').textContent = '请至少选择一种字符类型';
      $('pw-msg').className = 'msg err';
      return;
    }
    const len = +$('pw-len').value;
    const n = +$('pw-count').value;
    $('pw-out').value = Array.from({ length: n }, () => make(len, chars)).join('\n');

    const bits = entropy(len, chars.length);
    const [text, color] = label(bits);
    $('pw-strength').innerHTML =
      `<div style="max-width:420px;margin-top:10px;">
        <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px;">
          <span style="color:var(--text-sub);">强度</span><span style="color:${color};">${text} · 约 ${bits} bit 熵</span>
        </div>
        <div style="height:6px;background:var(--border);border-radius:3px;overflow:hidden;">
          <div style="height:100%;width:${Math.min(100, Math.round((bits / 128) * 100))}%;background:${color};"></div>
        </div>
      </div>`;
    $('pw-msg').textContent = `已生成 ${n} 个 ${len} 位密码`;
    $('pw-msg').className = 'msg ok';
  }

  $('pw-len').oninput = () => { $('pw-len-val').textContent = $('pw-len').value; };
  $('pw-gen').onclick = gen;
  ['pw-lower', 'pw-upper', 'pw-digit', 'pw-symbol', 'pw-nosimilar', 'pw-count'].forEach((id) => {
    $(id).onchange = gen;
  });
  $('pw-copy').onclick = async () => {
    if (!$('pw-out').value) return;
    await navigator.clipboard.writeText($('pw-out').value);
    $('pw-msg').textContent = '已复制';
    $('pw-msg').className = 'msg ok';
  };
  $('pw-clear').onclick = () => {
    $('pw-out').value = ''; $('pw-strength').innerHTML = ''; $('pw-msg').textContent = '';
  };
  gen();
</script>
