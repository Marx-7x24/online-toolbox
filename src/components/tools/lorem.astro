---
import { tu } from '../../i18n/toolUi.ts';

interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---

<div class="tip">{tu(lang, '生成中文占位文本，用于设计稿与排版测试，本地生成不联网。')}</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;max-width:720px;">
  <div>
    <div class="field-label"><span>{tu(lang, '段落数')}</span><span id="lm-p-val">5</span></div>
    <input type="range" id="lm-p" min="1" max="30" value="5" style="padding:0;" />
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '每段句数')}</span><span id="lm-s-val">6</span></div>
    <input type="range" id="lm-s" min="1" max="20" value="6" style="padding:0;" />
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '文体')}</span></div>
    <select id="lm-style">
      <option value="classic">{tu(lang, '通用说明文')}</option>
      <option value="tech">{tu(lang, '技术文档风')}</option>
      <option value="news">{tu(lang, '新闻资讯风')}</option>
      <option value="marketing">{tu(lang, '营销文案风')}</option>
    </select>
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '开头')}</span></div>
    <select id="lm-start">
      <option value="1">{tu(lang, '以')}「{tu(lang, '测试文本')}」{tu(lang, '开头')}</option>
      <option value="0">{tu(lang, '直接开始')}</option>
    </select>
  </div>
</div>

<div class="btn-row">
  <button class="primary" id="lm-go">{tu(lang, '生成')}</button>
  <button id="lm-copy">{tu(lang, '复制')}</button>
  <button id="lm-clear">{tu(lang, '清空')}</button>
</div>

<p class="msg" id="lm-msg"></p>
<textarea id="lm-out" readonly style="min-height:280px;"></textarea>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);

  const CORPUS = {
    classic: {
      subj: [tu(LANG, '这种方式'), tu(LANG, '该方法'), tu(LANG, '系统设计'), tu(LANG, '整体架构'), tu(LANG, '业务流程'), tu(LANG, '数据结构'), tu(LANG, '实施方案'), tu(LANG, '应用场景'), tu(LANG, '指标体系'), tu(LANG, '服务组件')],
      verb: [tu(LANG, '能够'), tu(LANG, '可以'), tu(LANG, '需要'), tu(LANG, '应当'), tu(LANG, '通常会'), tu(LANG, '在实践中会'), tu(LANG, '本质上会')],
      obj: [tu(LANG, '有效提升整体的运行效率'), tu(LANG, '显著降低维护成本与复杂度'), tu(LANG, '为后续扩展留出充足空间'), tu(LANG, '帮助团队更快定位问题'), tu(LANG, '让配置管理变得更加直观'), tu(LANG, '在多数场景下保持稳定表现'), tu(LANG, '减少重复劳动带来的误差'), tu(LANG, '兼顾易用性与灵活性')],
      tail: [tu(LANG, '这一点在长期实践中尤为重要。'), tu(LANG, '相关细节可以参考配套文档。'), tu(LANG, '实施时建议结合自身情况调整。'), tu(LANG, '这也是业界较为通行的做法。'), tu(LANG, '具体参数需按实际环境校准。'), tu(LANG, '后续版本会持续完善这部分能力。')],
    },
    tech: {
      subj: [tu(LANG, '该模块'), tu(LANG, '接口层'), tu(LANG, '缓存策略'), tu(LANG, '异步任务'), tu(LANG, '数据管道'), tu(LANG, '鉴权流程'), tu(LANG, '日志采集'), tu(LANG, '配置中心'), tu(LANG, '调度器'), tu(LANG, '连接池')],
      verb: [tu(LANG, '通过'), tu(LANG, '依赖'), tu(LANG, '基于'), tu(LANG, '在初始化阶段会'), tu(LANG, '按需'), tu(LANG, '以增量方式')],
      obj: [tu(LANG, '完成参数的校验与归一化处理'), tu(LANG, '建立与下游服务的可靠连接'), tu(LANG, '将请求分发到对应的处理单元'), tu(LANG, '对异常情况进行捕获与重试'), tu(LANG, '把中间结果写入临时存储'), tu(LANG, '按优先级顺序消费队列任务'), tu(LANG, '在超时后自动触发降级逻辑'), tu(LANG, '记录关键路径的耗时指标')],
      tail: [tu(LANG, '默认超时时间为 3000 毫秒。'), tu(LANG, '建议在生产环境开启监控告警。'), tu(LANG, '配置项支持热更新，无需重启。'), tu(LANG, '详细字段说明见接口文档。'), tu(LANG, '注意线程安全与并发控制。'), tu(LANG, '日志级别可通过环境变量调整。')],
    },
    news: {
      subj: [tu(LANG, '相关部门'), tu(LANG, '本次会议'), tu(LANG, '研究报告'), tu(LANG, '项目负责人'), tu(LANG, '行业观察人士'), tu(LANG, '最新数据'), tu(LANG, '试点工作'), tu(LANG, '专项小组')],
      verb: [tu(LANG, '表示'), tu(LANG, '指出'), tu(LANG, '强调'), tu(LANG, '透露'), tu(LANG, '预计'), tu(LANG, '已确认')],
      obj: [tu(LANG, '各项工作正在有序推进'), tu(LANG, '下一步将扩大试点范围'), tu(LANG, '整体进展符合此前预期'), tu(LANG, '相关配套措施将陆续出台'), tu(LANG, '已初步形成可复制的经验'), tu(LANG, '社会反响总体积极正面'), tu(LANG, '技术攻关取得阶段性成果'), tu(LANG, '多方协作机制日益成熟')],
      tail: [tu(LANG, '具体情况以官方通报为准。'), tu(LANG, '记者将持续关注事件进展。'), tu(LANG, '业内人士对此评价较为积极。'), tu(LANG, '后续安排将适时对外公布。'), tu(LANG, '这项举措预计惠及更多群体。'), tu(LANG, '专家建议保持理性客观看待。')],
    },
    marketing: {
      subj: [tu(LANG, '我们的产品'), tu(LANG, '这套方案'), tu(LANG, '本次升级'), tu(LANG, '全新版本'), tu(LANG, '服务体系'), tu(LANG, '核心功能'), tu(LANG, '用户体验'), tu(LANG, '整体设计')],
      verb: [tu(LANG, '致力于'), tu(LANG, '专注于'), tu(LANG, '能够'), tu(LANG, '持续'), tu(LANG, '全面'), tu(LANG, '从根本上')],
      obj: [tu(LANG, '为每一位用户创造真正的价值'), tu(LANG, '让复杂的工作变得简单高效'), tu(LANG, '帮助你把想法快速落地'), tu(LANG, '带来焕然一新的使用感受'), tu(LANG, '在细节处体现专业与用心'), tu(LANG, '真正做到开箱即用'), tu(LANG, '让团队协作更加顺畅自然'), tu(LANG, '把时间还给真正重要的事')],
      tail: [tu(LANG, '立即体验，开启高效之旅。'), tu(LANG, '现在咨询可享专属优惠。'), tu(LANG, '已有超过万家企业选择我们。'), tu(LANG, '欢迎预约产品演示。'), tu(LANG, '更多精彩，等你来发现。'), tu(LANG, '让我们一起做得更好。')],
    },
  };

  function pick(a) { return a[Math.floor(Math.random() * a.length)]; }

  function generate() {
    const c = CORPUS[$('lm-style').value];
    const P = +$('lm-p').value, S = +$('lm-s').value;
    const out = [];
    for (let i = 0; i < P; i++) {
      const sentences = [];
      if (i === 0 && $('lm-start').value === '1') {
        sentences.push(tu(LANG, '这是一段用于排版测试的中文占位文本，内容由工具随机生成，不代表任何真实含义。'));
      }
      for (let j = 0; j < S; j++) {
        sentences.push(`${pick(c.subj)}${pick(c.verb)}${pick(c.obj)}，${pick(c.tail)}`);
      }
      out.push(sentences.join(''));
    }
    return out.join('\n\n');
  }

  function run() {
    const text = generate();
    $('lm-out').value = text;
    const chars = text.replace(/\s/g, '').length;
    $('lm-msg').textContent = `已生成 ${$('lm-p').value} 段，共 ${chars} 字`;
    $('lm-msg').className = 'msg ok';
  }

  ['lm-p', 'lm-s'].forEach((id) => {
    $(id).oninput = () => {
      $('lm-p-val').textContent = $('lm-p').value;
      $('lm-s-val').textContent = $('lm-s').value;
    };
  });
  $('lm-style').onchange = run;
  $('lm-start').onchange = run;

  $('lm-go').onclick = run;
  $('lm-copy').onclick = async () => {
    if (!$('lm-out').value) return;
    await navigator.clipboard.writeText($('lm-out').value);
    $('lm-msg').textContent = tu(LANG, '已复制');
    $('lm-msg').className = 'msg ok';
  };
  $('lm-clear').onclick = () => { $('lm-out').value = ''; $('lm-msg').textContent = ''; };
  run();
</script>
