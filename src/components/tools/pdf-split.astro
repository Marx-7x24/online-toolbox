---
---

<div class="tip">拆分在你的浏览器完成，PDF 不会离开本机。</div>

<div class="btn-row" style="align-items:center;">
  <input type="file" id="ps-file" accept="application/pdf" style="width:auto;font-family:inherit;padding:6px;border:none;" />
  <span id="ps-info" style="font-size:13px;color:var(--text-hint);"></span>
</div>

<div style="margin-top:14px;">
  <div class="field-label"><span>拆分方式</span></div>
  <select id="ps-mode" style="max-width:320px;">
    <option value="range">按页码范围提取</option>
    <option value="each">每页拆成一个文件</option>
    <option value="fixed">按固定页数切分</option>
  </select>
</div>

<div id="ps-range-box" style="max-width:420px;margin-top:12px;">
  <div class="field-label"><span>页码范围</span></div>
  <input type="text" id="ps-range" placeholder="例如 1-3,5,8-10" spellcheck="false" />
  <div style="font-size:12px;color:var(--text-hint);margin-top:4px;">支持逗号分隔的多段，如 1-3,5,8-10</div>
</div>

<div id="ps-fixed-box" style="max-width:420px;margin-top:12px;display:none;">
  <div class="field-label"><span>每个文件页数</span></div>
  <input type="number" id="ps-fixed" value="5" min="1" style="max-width:160px;" />
</div>

<div class="btn-row">
  <button class="primary" id="ps-go">开始拆分</button>
  <button id="ps-clear">清空</button>
</div>

<p class="msg" id="ps-msg"></p>
<div id="ps-out"></div>

<script>
  import { PDFDocument } from 'pdf-lib';

  const $ = (id) => document.getElementById(id);
  let loaded = null;

  $('ps-mode').onchange = () => {
    const m = $('ps-mode').value;
    $('ps-range-box').style.display = m === 'range' ? 'block' : 'none';
    $('ps-fixed-box').style.display = m === 'fixed' ? 'block' : 'none';
  };

  $('ps-file').onchange = async (e) => {
    const f = e.target.files[0];
    if (!f) return;
    $('ps-msg').textContent = '读取中…';
    $('ps-msg').className = 'msg';
    try {
      loaded = await PDFDocument.load(new Uint8Array(await f.arrayBuffer()));
      $('ps-info').textContent = `${f.name}（共 ${loaded.getPageCount()} 页）`;
      $('ps-msg').textContent = '读取成功，可开始拆分';
      $('ps-msg').className = 'msg ok';
    } catch (e) {
      loaded = null;
      $('ps-msg').textContent = '读取失败：文件可能已加密或损坏';
      $('ps-msg').className = 'msg err';
    }
  };

  function parseRange(str, total) {
    const out = [];
    for (const part of str.split(',')) {
      const t = part.trim();
      if (!t) continue;
      const m = t.match(/^(\d+)\s*-\s*(\d+)$/);
      if (m) {
        const a = +m[1], b = +m[2];
        for (let i = Math.min(a, b); i <= Math.max(a, b); i++) if (i >= 1 && i <= total) out.push(i - 1);
      } else if (/^\d+$/.test(t)) {
        const n = +t;
        if (n >= 1 && n <= total) out.push(n - 1);
      } else throw new Error('页码格式无法识别：' + t);
    }
    return [...new Set(out)].sort((a, b) => a - b);
  }

  function download(bytes, name) {
    const url = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = name;
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 5000);
  }

  $('ps-go').onclick = async () => {
    if (!loaded) { $('ps-msg').textContent = '请先选择 PDF 文件'; $('ps-msg').className = 'msg err'; return; }
    const total = loaded.getPageCount();
    const mode = $('ps-mode').value;
    const parts = [];

    try {
      if (mode === 'range') {
        const idx = parseRange($('ps-range').value, total);
        if (!idx.length) throw new Error('没有有效页码');
        const doc = await PDFDocument.create();
        const pages = await doc.copyPages(loaded, idx);
        pages.forEach((p) => doc.addPage(p));
        parts.push({ name: 'pages.pdf', bytes: await doc.save(), label: `提取 ${idx.length} 页` });
      } else if (mode === 'each') {
        for (let i = 0; i < total; i++) {
          const doc = await PDFDocument.create();
          const [p] = await doc.copyPages(loaded, [i]);
          doc.addPage(p);
          parts.push({ name: `page-${i + 1}.pdf`, bytes: await doc.save(), label: `第 ${i + 1} 页` });
          $('ps-msg').textContent = `拆分中… ${i + 1} / ${total}`;
        }
      } else {
        const n = Math.max(1, +$('ps-fixed').value);
        let i = 0, k = 1;
        while (i < total) {
          const idx = [];
          for (let j = i; j < Math.min(i + n, total); j++) idx.push(j);
          const doc = await PDFDocument.create();
          const pages = await doc.copyPages(loaded, idx);
          pages.forEach((p) => doc.addPage(p));
          parts.push({ name: `part-${k}.pdf`, bytes: await doc.save(), label: `第 ${idx[0] + 1}-${idx[idx.length - 1] + 1} 页` });
          i += n; k++;
          $('ps-msg').textContent = `拆分中… ${Math.min(i, total)} / ${total}`;
        }
      }

      parts.forEach((p, i) => setTimeout(() => download(p.bytes, p.name), i * 400));
      $('ps-out').innerHTML =
        '<div class="field-label" style="margin-top:14px;"><span>拆分结果</span><span>' + parts.length + ' 个文件</span></div>' +
        '<table class="result-table" style="max-width:420px;">' +
        parts.map((p) => `<tr><th>${p.label}</th><td>${p.name}</td></tr>`).join('') +
        '</table>';
      $('ps-msg').textContent = `已拆分为 ${parts.length} 个文件，开始下载`;
      $('ps-msg').className = 'msg ok';
    } catch (e) {
      $('ps-msg').textContent = '拆分失败：' + e.message;
      $('ps-msg').className = 'msg err';
    }
  };

  $('ps-clear').onclick = () => {
    loaded = null;
    $('ps-file').value = '';
    $('ps-range').value = '';
    $('ps-info').textContent = '';
    $('ps-out').innerHTML = '';
    $('ps-msg').textContent = '';
  };
</script>
