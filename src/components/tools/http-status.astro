---
import { tu } from '../../i18n/toolUi.ts';
// HTTP状态码查询：1xx~5xx 状态码速查表
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div class="pane">
  <div>
    <div class="field-label"><span>{tu(lang, '搜索状态码或关键词')}</span></div>
    <input type="text" id="hs-q" placeholder="{tu(lang, '如')}：404 / redirect / {tu(lang, '服务器错误')}" style="width:100%;padding:9px;border:1px solid var(--border-color);border-radius:6px;box-sizing:border-box">
    <div class="field-label" style="margin-top:12px"><span>{tu(lang, '分类筛选')}</span></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button data-c="all" type="button" class="primary">{tu(lang, '全部')}</button>
      <button data-c="1" type="button">1xx {tu(lang, '信息')}</button>
      <button data-c="2" type="button">2xx {tu(lang, '成功')}</button>
      <button data-c="3" type="button">3xx {tu(lang, '重定向')}</button>
      <button data-c="4" type="button">4xx {tu(lang, '客户端错误')}</button>
      <button data-c="5" type="button">5xx {tu(lang, '服务器错误')}</button>
    </div>
    <div style="margin-top:14px;font-size:12px;color:var(--text-sub);line-height:1.7">
      {tu(lang, '常用速记：200 成功')}｜301 {tu(lang, '永久重定向')}｜302 {tu(lang, '临时重定向')}｜304 {tu(lang, '缓存有效')}｜403 {tu(lang, '禁止访问')}｜404 {tu(lang, '未找到')}｜429 {tu(lang, '请求过多')}｜500 {tu(lang, '服务器内部错误')}｜502 {tu(lang, '网关错误')}｜503 {tu(lang, '服务不可用。')}
    </div>
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '状态码列表')}</span></div>
    <div id="hs-list" style="max-height:420px;overflow-y:auto"></div>
  </div>
</div>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

const $ = (id) => document.getElementById(id);
const DATA = [
  [100,'Continue',tu(LANG, '继续，客户端应继续请求')],[101,'Switching Protocols',tu(LANG, '切换协议（如升级 WebSocket）')],
  [200,'OK',tu(LANG, '请求成功')],[201,'Created',tu(LANG, '已创建（常用于 POST 新资源）')],[202,'Accepted',tu(LANG, '已接受，处理中')],
  [204,'No Content',tu(LANG, '成功但无返回内容')],[206,'Partial Content',tu(LANG, '部分内容（断点续传/Range）')],
  [301,'Moved Permanently',tu(LANG, '永久重定向（SEO 权重转移）')],[302,'Found',tu(LANG, '临时重定向')],
  [303,'See Other',tu(LANG, '查看其他位置（PRG 模式）')],[304,'Not Modified',tu(LANG, '缓存有效，使用本地缓存')],
  [307,'Temporary Redirect',tu(LANG, '临时重定向（保持方法不变）')],[308,'Permanent Redirect',tu(LANG, '永久重定向（保持方法不变）')],
  [400,'Bad Request',tu(LANG, '请求语法错误')],[401,'Unauthorized',tu(LANG, '未认证（需登录/Token）')],
  [403,'Forbidden',tu(LANG, '已认证但无权限')],[404,'Not Found',tu(LANG, '资源不存在')],
  [405,'Method Not Allowed',tu(LANG, 'HTTP 方法不允许')],[408,'Request Timeout',tu(LANG, '请求超时')],
  [409,'Conflict',tu(LANG, '资源冲突')],[410,'Gone',tu(LANG, '资源已永久删除')],
  [413,'Payload Too Large',tu(LANG, '请求体过大')],[415,'Unsupported Media Type',tu(LANG, '媒体类型不支持')],
  [429,'Too Many Requests',tu(LANG, '请求过于频繁（限流）')],[444,'Nginx No Response',tu(LANG, 'Nginx 主动断开连接')],
  [451,'Unavailable For Legal Reasons',tu(LANG, '因法律原因不可用')],
  [500,'Internal Server Error',tu(LANG, '服务器内部错误')],[501,'Not Implemented',tu(LANG, '功能未实现')],
  [502,'Bad Gateway',tu(LANG, '网关收到无效响应（反代常见）')],[503,'Service Unavailable',tu(LANG, '服务不可用/过载')],
  [504,'Gateway Timeout',tu(LANG, '网关等待后端超时')],[508,'Loop Detected',tu(LANG, '检测到循环')],
];
const COLORS = { 1:'#8e8e8e', 2:'#27ae60', 3:'#2980b9', 4:'#e67e22', 5:'#e74c3c' };
let filter = 'all';
function render(){
  const q = $('hs-q').value.trim().toLowerCase();
  let html = '';
  for (const [code, en, zh] of DATA){
    if (filter !== 'all' && String(code)[0] !== filter) continue;
    if (q && !(String(code).includes(q) || en.toLowerCase().includes(q) || zh.toLowerCase().includes(q))) continue;
    const cls = COLORS[String(code)[0]];
    html += `<div style="display:flex;gap:10px;align-items:flex-start;padding:8px 6px;border-bottom:1px solid var(--border-color)">
      <span style="font-family:ui-monospace,monospace;font-weight:700;color:${cls};width:44px;flex-shrink:0">${code}</span>
      <div><div style="font-size:14px;font-weight:600">${en}</div><div style="font-size:12.5px;color:var(--text-sub)">${zh}</div></div>
    </div>`;
  }
  $('hs-list').innerHTML = html || '<div style="color:var(--text-sub);padding:20px;text-align:center;font-size:13px">无匹配结果</div>';
}
$('hs-q').addEventListener('input', render);
document.querySelectorAll('button[data-c]').forEach(btn => btn.addEventListener('click', () => {
  filter = btn.dataset.c;
  document.querySelectorAll('button[data-c]').forEach(b => b.classList.remove('primary'));
  btn.classList.add('primary');
  render();
}));
render();
</script>