---
// 密码泄露本地检查：内置弱密码库 + 本地规则
---
<div>
  <div class="field-label"><span>输入密码（仅本地检查，不上传）</span></div>
  <input type="text" id="pb-in" placeholder="输入要检查的密码" autocomplete="off">
  <div id="pb-out" class="pb-out">等待检查</div>
</div>
<div class="btn-row">
  <button id="pb-run" class="primary">检查</button>
  <span id="pb-msg" class="msg"></span>
</div>

<style>
  .pb-out { border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; min-height: 120px; line-height: 1.9; background: var(--bg-soft); font-size: 13px; }
  .pb-out .bad { color: #e03131; font-weight: 600; }
  .pb-out .warn { color: #f08c00; font-weight: 600; }
  .pb-out .ok { color: #2f9e44; font-weight: 600; }
</style>

<script>
  const $ = (id) => document.getElementById(id);
  // 内置常见弱密码（示意，覆盖 Top 弱口令模式）
  const WEAK = new Set(['123456', 'password', '12345678', 'qwerty', '111111', '123123', 'abc123', 'password1', '123456789', 'admin', 'welcome', 'iloveyou', '1q2w3e4r', 'qwerty123', '000000', '666666', '888888', 'passw0rd', 'p@ssw0rd', 'letmein', 'root', 'toor', 'test', 'guest', 'changeme', 'zhang123', 'woaini', '123456a', 'a123456', '1qaz2wsx', 'password123']);
  function kbWalk(p) {
    const walks = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm', '1234567890'];
    for (const w of walks) {
      for (let i = 0; i + 2 < w.length; i++) {
        if (p.toLowerCase().includes(w.slice(i, i + 3))) return true;
      }
    }
    return false;
  }
  function seq(p) {
    for (let i = 0; i + 2 < p.length; i++) {
      const a = p.charCodeAt(i), b = p.charCodeAt(i + 1), c = p.charCodeAt(i + 2);
      if (b === a + 1 && c === b + 1) return true;
      if (b === a - 1 && c === b - 1) return true;
    }
    return false;
  }
  $('pb-run').addEventListener('click', () => {
    const p = $('pb-in').value;
    if (!p) { $('pb-out').textContent = '等待检查'; return; }
    const issues = [];
    if (WEAK.has(p.toLowerCase())) issues.push(['严重', '命中常见弱密码库，极可能被暴力破解']);
    if (p.length < 8) issues.push(['严重', `长度仅 ${p.length} 位，低于 8 位安全线`]);
    if (kbWalk(p)) issues.push(['警告', '含键盘连续序列（如 qwerty/asdf）']);
    if (seq(p)) issues.push(['警告', '含连续递增/递减数字（如 123）']);
    if (/^(.)\1{2,}$/.test(p)) issues.push(['警告', '含连续重复字符']);
    if (!/(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9])/.test(p)) issues.push(['提示', '未同时包含大小写、数字与符号']);
    const html = issues.length
      ? issues.map(([s, t]) => `<div class="${s === '严重' ? 'bad' : s === '警告' ? 'warn' : 'ok'}">[${s}] ${t}</div>`).join('')
      : '<div class="ok">未命中已知弱模式 ✓（仍建议用密码管理器生成高强度密码）</div>';
    $('pb-out').innerHTML = html;
    $('pb-msg').textContent = issues.some(([s]) => s === '严重') ? '存在高风险' : issues.length ? '存在风险' : '本地检查通过';
    $('pb-msg').className = issues.some(([s]) => s === '严重') ? 'msg err' : issues.length ? 'msg err' : 'msg ok';
  });
</script>
