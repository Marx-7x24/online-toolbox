---
import { tu } from '../../i18n/toolUi.ts';

interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---

<div class="tip">{tu(lang, '转换在你本机完成，图片不上传服务器，断网也能用。')}</div>

<div class="btn-row" style="align-items:center;">
  <input type="file" id="cv-file" accept="image/*" multiple style="width:auto;font-family:inherit;padding:6px;border:none;" />
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-top:12px;">
  <div>
    <div class="field-label"><span>{tu(lang, '目标格式')}</span></div>
    <select id="cv-fmt">
      <option value="image/jpeg">JPEG</option>
      <option value="image/png">PNG</option>
      <option value="image/webp" selected>WebP</option>
      <option value="image/bmp">BMP</option>
    </select>
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '质量')}（JPEG/WebP）</span><span id="cv-q-val">90%</span></div>
    <input type="range" id="cv-q" min="10" max="100" value="90" style="padding:0;" />
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '背景处理')}</span></div>
    <select id="cv-bg">
      <option value="white">{tu(lang, '透明区域填白（转 JPEG 建议')}）</option>
      <option value="keep">{tu(lang, '保留透明')}</option>
    </select>
  </div>
</div>

<div class="btn-row">
  <button class="primary" id="cv-go">{tu(lang, '开始转换')}</button>
  <button id="cv-dl">{tu(lang, '下载全部')}</button>
  <button id="cv-clear">{tu(lang, '清空')}</button>
</div>

<p class="msg" id="cv-msg"></p>
<div id="cv-list"></div>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);
  let jobs = [];
  const EXT = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'image/bmp': 'bmp' };

  $('cv-q').oninput = () => { $('cv-q-val').textContent = $('cv-q').value + '%'; };

  function loadImage(src) {
    return new Promise((res, rej) => {
      const img = new Image();
      img.onload = () => res(img);
      img.onerror = rej;
      img.src = src;
    });
  }

  function render() {
    $('cv-list').innerHTML = jobs.map((j) =>
      `<div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-top:1px solid var(--border);">
        <img src="${j.out}" alt="" style="width:56px;height:56px;object-fit:cover;border-radius:8px;border:1px solid var(--border);" />
        <div style="flex:1;min-width:0;">
          <div style="font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${j.name}</div>
          <div style="font-size:12px;color:var(--text-sub);">${j.from} → ${j.ext.toUpperCase()}　${(j.inSize / 1024).toFixed(0)} KB → ${(j.outSize / 1024).toFixed(0)} KB</div>
        </div>
        <a href="${j.out}" download="${j.outName}" style="padding:6px 14px;border:1px solid var(--brand);color:var(--brand);border-radius:8px;font-size:13px;">下载</a>
      </div>`
    ).join('');
  }

  $('cv-go').onclick = async () => {
    const files = Array.from($('cv-file').files || []);
    if (!files.length) { $('cv-msg').textContent = tu(LANG, '请先选择图片'); $('cv-msg').className = 'msg err'; return; }
    jobs = [];
    const fmt = $('cv-fmt').value;
    const ext = EXT[fmt];

    for (let i = 0; i < files.length; i++) {
      const f = files[i];
      $('cv-msg').textContent = `转换中… ${i + 1} / ${files.length}`;
      $('cv-msg').className = 'msg';
      try {
        const img = await loadImage(URL.createObjectURL(f));
        const canvas = document.createElement('canvas');
        canvas.width = img.width;
        canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        if (fmt === 'image/jpeg' || $('cv-bg').value === 'white') {
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
        }
        ctx.drawImage(img, 0, 0);
        const blob = await new Promise((res) => canvas.toBlob(res, fmt, fmt === 'image/png' || fmt === 'image/bmp' ? undefined : +$('cv-q').value / 100));
        jobs.push({
          name: f.name,
          from: (f.type.split('/')[1] || 'unknown').toUpperCase(),
          ext,
          inSize: f.size,
          outSize: blob.size,
          out: URL.createObjectURL(blob),
          outName: f.name.replace(/\.[^.]+$/, '') + '.' + ext,
        });
        render();
      } catch (e) {
        $('cv-msg').textContent = `${f.name} 转换失败：浏览器不支持该图片格式`;
        $('cv-msg').className = 'msg err';
      }
    }
    $('cv-msg').textContent = `完成 ${jobs.length} / ${files.length} 张`;
    $('cv-msg').className = 'msg ok';
  };

  $('cv-dl').onclick = () => {
    jobs.forEach((j, i) => setTimeout(() => {
      const a = document.createElement('a');
      a.href = j.out;
      a.download = j.outName;
      a.click();
    }, i * 300));
  };

  $('cv-clear').onclick = () => {
    jobs.forEach((j) => URL.revokeObjectURL(j.out));
    jobs = [];
    $('cv-file').value = '';
    render();
    $('cv-msg').textContent = '';
  };
</script>
