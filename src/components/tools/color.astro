---
---

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;">
  <div>
    <div class="field-label"><span>HEX</span></div>
    <input type="text" id="c-hex" value="#2563EB" spellcheck="false" />

    <div class="field-label" style="margin-top:12px;"><span>RGB</span></div>
    <div style="display:flex;gap:8px;">
      <input type="number" id="c-r" value="37" min="0" max="255" />
      <input type="number" id="c-g" value="99" min="0" max="255" />
      <input type="number" id="c-b" value="235" min="0" max="255" />
    </div>

    <div class="field-label" style="margin-top:12px;"><span>HSL</span></div>
    <div style="display:flex;gap:8px;">
      <input type="number" id="c-h" value="221" min="0" max="360" />
      <input type="number" id="c-s" value="83" min="0" max="100" />
      <input type="number" id="c-l" value="53" min="0" max="100" />
    </div>

    <div class="btn-row" style="align-items:center;">
      <label for="c-picker" style="font-size:13px;color:var(--text-sub);">取色器：</label>
      <input type="color" id="c-picker" value="#2563eb" style="width:52px;height:34px;padding:2px;" />
      <button id="c-random">随机</button>
    </div>
  </div>

  <div>
    <div class="field-label"><span>预览</span></div>
    <div id="c-preview" style="height:120px;border:1px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:ui-monospace,monospace;font-size:15px;"></div>

    <div style="display:flex;gap:10px;margin-top:12px;">
      <div style="flex:1;">
        <div class="field-label"><span>浅色底文字</span></div>
        <div id="c-on-light" style="height:44px;border:1px solid var(--border);border-radius:8px;background:#ffffff;display:flex;align-items:center;justify-content:center;font-size:13px;">示例文字 Aa</div>
      </div>
      <div style="flex:1;">
        <div class="field-label"><span>深色底文字</span></div>
        <div id="c-on-dark" style="height:44px;border:1px solid var(--border);border-radius:8px;background:#1a1a1a;display:flex;align-items:center;justify-content:center;font-size:13px;color:#fff;">示例文字 Aa</div>
      </div>
    </div>
  </div>
</div>

<div class="btn-row" style="margin-top:16px;">
  <button class="primary" id="c-copy-hex">复制 HEX</button>
  <button id="c-copy-rgb">复制 RGB</button>
  <button id="c-copy-hsl">复制 HSL</button>
</div>

<p class="msg" id="c-msg"></p>

<script>
  const $ = (id) => document.getElementById(id);
  const clamp = (n, a, b) => Math.min(b, Math.max(a, n));

  function rgbToHsl(r, g, b) {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    const l = (max + min) / 2;
    let h = 0, s = 0;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      if (max === r) h = ((g - b) / d + (g < b ? 6 : 0));
      else if (max === g) h = (b - r) / d + 2;
      else h = (r - g) / d + 4;
      h *= 60;
    }
    return [Math.round(h), Math.round(s * 100), Math.round(l * 100)];
  }

  function hslToRgb(h, s, l) {
    h /= 360; s /= 100; l /= 100;
    let r, g, b;
    if (s === 0) { r = g = b = l; }
    else {
      const hue = (t) => {
        let x = t;
        if (x < 0) x += 1;
        if (x > 1) x -= 1;
        if (x < 1 / 6) return p + (q - p) * 6 * x;
        if (x < 1 / 2) return q;
        if (x < 2 / 3) return p + (q - p) * (2 / 3 - x) * 6;
        return p;
      };
      const q = l < 0.5 ? l * (1 + s) : l + s - l * s;
      const p = 2 * l - q;
      r = hue(h + 1 / 3); g = hue(h); b = hue(h - 1 / 3);
    }
    return [Math.round(r * 255), Math.round(g * 255), Math.round(b * 255)];
  }

  const toHex = (r, g, b) => '#' + [r, g, b].map((n) => clamp(Math.round(n), 0, 255).toString(16).padStart(2, '0')).join('').toUpperCase();

  function syncTo(rgb, src) {
    const [r, g, b] = rgb.map((n) => clamp(Math.round(n), 0, 255));
    const hex = toHex(r, g, b);
    const [h, s, l] = rgbToHsl(r, g, b);
    $('c-hex').value = hex;
    $('c-picker').value = hex.toLowerCase();
    if (src !== 'rgb') { $('c-r').value = r; $('c-g').value = g; $('c-b').value = b; }
    if (src !== 'hsl') { $('c-h').value = h; $('c-s').value = s; $('c-l').value = l; }
    paint(hex);
  }

  function paint(hex) {
    $('c-preview').style.background = hex;
    const rgb = hex.slice(1).match(/../g).map((x) => parseInt(x, 16));
    const lum = (0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2]) / 255;
    $('c-preview').style.color = lum > 0.55 ? '#1a1a1a' : '#ffffff';
    $('c-preview').textContent = hex;
    $('c-on-light').style.color = hex;
    $('c-on-dark').style.background = hex;
    $('c-on-dark').style.color = lum > 0.55 ? '#1a1a1a' : '#ffffff';
  }

  $('c-hex').oninput = () => {
    const v = $('c-hex').value.trim();
    let m = v.match(/^#?([0-9a-f]{6})$/i) || v.match(/^#?([0-9a-f]{3})$/i);
    if (!m) return;
    let h = m[1];
    if (h.length === 3) h = h.split('').map((c) => c + c).join('');
    syncTo([parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)], 'hex');
  };

  ['c-r', 'c-g', 'c-b'].forEach((id) => {
    $(id).oninput = () => syncTo([+$('c-r').value || 0, +$('c-g').value || 0, +$('c-b').value || 0], 'rgb');
  });

  ['c-h', 'c-s', 'c-l'].forEach((id) => {
    $(id).oninput = () => syncTo(hslToRgb(+$('c-h').value || 0, +$('c-s').value || 0, +$('c-l').value || 0), 'hsl');
  });

  $('c-picker').oninput = () => {
    const h = $('c-picker').value.slice(1);
    syncTo([parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)], 'hex');
  };

  $('c-random').onclick = () => {
    syncTo([Math.random() * 255, Math.random() * 255, Math.random() * 255], 'hex');
  };

  const copy = async (text) => {
    await navigator.clipboard.writeText(text);
    $('c-msg').textContent = '已复制 ' + text;
    $('c-msg').className = 'msg ok';
  };
  $('c-copy-hex').onclick = () => copy($('c-hex').value);
  $('c-copy-rgb').onclick = () => copy(`rgb(${$('c-r').value}, ${$('c-g').value}, ${$('c-b').value})`);
  $('c-copy-hsl').onclick = () => copy(`hsl(${$('c-h').value}, ${$('c-s').value}%, ${$('c-l').value}%)`);

  syncTo([37, 99, 235], 'hex');
</script>
