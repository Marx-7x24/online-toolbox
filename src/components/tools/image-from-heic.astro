---
import { tu } from '../../i18n/toolUi.ts';
// HEIC/HEIF → JPG（懒加载 heic2any）
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div class="pane">
  <div>
    <div class="field-label"><span>{tu(lang, '选择')} HEIC/HEIF {tu(lang, '图片')}</span></div>
    <input type="file" id="ifheic-file" accept=".heic,.heif,image/heic,image/heif">
    <div id="ifheic-info" class="msg"></div>
    <div class="field-label" style="margin-top:14px"><span>{tu(lang, '输出画质')} <span id="ifheic-qv">92%</span></span></div>
    <input type="range" id="ifheic-q" min="1" max="100" value="92" style="width:100%">
    <p style="font-size:12px;color:#999;margin-top:8px">{tu(lang, '首次使用需联网加载解码器')} ~500KB；{tu(lang, '解码完全在浏览器本地完成，图片不会上传。')}</p>
  </div>
  <div>
    <div class="field-label"><span>JPG {tu(lang, '预览')}</span></div>
    <div id="ifheic-preview" class="ifheic-preview"></div>
  </div>
</div>
<div class="btn-row">
  <button id="ifheic-run" class="primary">{tu(lang, '转换为')} JPG</button>
  <button id="ifheic-dl">{tu(lang, '下载')} JPG</button>
  <button id="ifheic-reset">{tu(lang, '重置')}</button>
  <span id="ifheic-msg" class="msg"></span>
</div>

<style>
  .ifheic-preview { margin-top: 10px; border: 1px dashed var(--border); border-radius: 8px; padding: 10px; min-height: 120px; display: flex; align-items: center; justify-content: center; background: var(--hover-bg); }
  .ifheic-preview img { max-width: 100%; max-height: 320px; }
  .ifheic-preview:empty::before { content: '尚未选择图片'; color: #999; }
</style>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);
  let sourceFile = null;
  let jpgBlob = null;

  $('ifheic-q').addEventListener('input', e => $('ifheic-qv').textContent = e.target.value + '%');

  $('ifheic-file').addEventListener('change', (e) => {
    const f = e.target.files[0];
    if (!f) return;
    sourceFile = f;
    $('ifheic-info').textContent = `已选择：${f.name} · ${(f.size/1024).toFixed(1)} KB`;
    $('ifheic-info').className = 'msg ok';
  });

  function loadScript(src) {
    return new Promise((res, rej) => {
      const s = document.createElement('script');
      s.src = src; s.onload = res; s.onerror = rej;
      document.head.appendChild(s);
    });
  }

  async function loadHeic2any() {
    if (window.heic2any) return window.heic2any;
    await loadScript('https://cdn.jsdelivr.net/npm/heic2any@0.0.4/dist/heic2any.min.js');
    return window.heic2any;
  }

  $('ifheic-run').addEventListener('click', async () => {
    if (!sourceFile) { $('ifheic-msg').textContent = tu(LANG, '请先选择 HEIC 图片'); $('ifheic-msg').className = 'msg err'; return; }
    $('ifheic-msg').textContent = tu(LANG, '加载解码器…'); $('ifheic-msg').className = 'msg';
    try {
      const heic2any = await loadHeic2any();
      const q = Number($('ifheic-q').value) / 100;
      const blob = await heic2any({ blob: sourceFile, toType: 'image/jpeg', quality: q });
      const outBlob = Array.isArray(blob) ? blob[0] : blob;
      jpgBlob = outBlob;
      $('ifheic-preview').innerHTML = '<img alt=tu(LANG, "预览")>';
      $('ifheic-preview').querySelector('img').src = URL.createObjectURL(outBlob);
      $('ifheic-msg').textContent = `转换成功 · ${(outBlob.size/1024).toFixed(1)} KB`;
      $('ifheic-msg').className = 'msg ok';
    } catch (err) {
      $('ifheic-msg').textContent = tu(LANG, '转换失败：') + (err.message || tu(LANG, '该 HEIC 文件可能已加密或损坏'));
      $('ifheic-msg').className = 'msg err';
    }
  });

  $('ifheic-dl').addEventListener('click', () => {
    if (!jpgBlob) { $('ifheic-msg').textContent = tu(LANG, '请先转换'); $('ifheic-msg').className = 'msg err'; return; }
    const a = document.createElement('a');
    a.href = URL.createObjectURL(jpgBlob);
    a.download = (sourceFile.name.replace(/\.[^.]+$/, '') || 'image') + '.jpg';
    a.click();
  });

  $('ifheic-reset').addEventListener('click', () => {
    sourceFile = null; jpgBlob = null;
    $('ifheic-file').value = '';
    $('ifheic-info').textContent = '';
    $('ifheic-preview').innerHTML = '';
    $('ifheic-msg').textContent = '';
  });
</script>
