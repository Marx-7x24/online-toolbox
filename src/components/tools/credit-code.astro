---
import { tu } from '../../i18n/toolUi.ts';

interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---

<div class="tip">{tu(lang, '按 GB 32100-2015 标准校验统一社会信用代码，并解析登记管理部门与机构类型。')}</div>

<div style="max-width:460px;">
  <div class="field-label"><span>{tu(lang, '统一社会信用代码')}</span></div>
  <input type="text" id="cc-in" placeholder={tu(lang, '输入 18 位统一社会信用代码')} maxlength="18" style="text-transform:uppercase;" spellcheck="false" />
</div>

<div class="btn-row">
  <button class="primary" id="cc-go">{tu(lang, '校验')}</button>
  <button id="cc-gen">{tu(lang, '生成测试代码')}</button>
  <button id="cc-clear">{tu(lang, '清空')}</button>
</div>

<div id="cc-out"></div>
<p class="msg" id="cc-msg"></p>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);

  // GB 32100-2015：字符集去掉了容易混淆的 I、O、S、V、Z
  const CHARS = '0123456789ABCDEFGHJKLMNPQRTUWXY';
  const WEIGHT = [1, 3, 9, 27, 19, 26, 16, 17, 20, 29, 25, 13, 8, 24, 10, 30, 28];

  // 第 1 位登记管理部门
  const DEPT = {
    1: tu(LANG, '机构编制'), 2: tu(LANG, '外交'), 3: tu(LANG, '司法行政'), 4: tu(LANG, '文化'), 5: tu(LANG, '民政'),
    6: tu(LANG, '旅游'), 7: tu(LANG, '宗教'), 8: tu(LANG, '工会'), 9: tu(LANG, '工商'), A: tu(LANG, '中央军委改革和编制办公室'),
    N: tu(LANG, '农业'), Y: tu(LANG, '其他'),
  };
  // 第 2 位机构类别
  const KIND = {
    1: tu(LANG, '机构编制类机关'), 2: tu(LANG, '机构编制类事业单位'), 3: tu(LANG, '机构编制类中央编办直接管理机构编制的群众团体'),
    4: tu(LANG, '机构编制类其他'), 9: tu(LANG, '机构编制类其他'),
  };

  function parse(code) {
    code = code.trim().toUpperCase();
    if (code.length !== 18) return { ok: false, reason: `长度应为 18 位，当前 ${code.length} 位` };
    for (const ch of code) {
      if (CHARS.indexOf(ch) === -1) {
        return { ok: false, reason: `含有非法字符「${ch}」，标准字符集不含 I、O、S、V、Z` };
      }
    }
    let sum = 0;
    for (let i = 0; i < 17; i++) sum += CHARS.indexOf(code[i]) * WEIGHT[i];
    let c = 31 - (sum % 31);
    if (c === 31) c = 0;
    const expect = CHARS[c];
    return {
      ok: true,
      valid: expect === code[17],
      expect,
      actual: code[17],
      dept: DEPT[code[0]] || tu(LANG, '未知'),
      region: code.slice(2, 8),
      orgCode: code.slice(8, 17),
    };
  }

  // 常见省级行政区划前两位
  const PROV = {
    11: tu(LANG, '北京市'), 12: tu(LANG, '天津市'), 13: tu(LANG, '河北省'), 14: tu(LANG, '山西省'), 15: tu(LANG, '内蒙古自治区'),
    21: tu(LANG, '辽宁省'), 22: tu(LANG, '吉林省'), 23: tu(LANG, '黑龙江省'), 31: tu(LANG, '上海市'), 32: tu(LANG, '江苏省'),
    33: tu(LANG, '浙江省'), 34: tu(LANG, '安徽省'), 35: tu(LANG, '福建省'), 36: tu(LANG, '江西省'), 37: tu(LANG, '山东省'),
    41: tu(LANG, '河南省'), 42: tu(LANG, '湖北省'), 43: tu(LANG, '湖南省'), 44: tu(LANG, '广东省'), 45: tu(LANG, '广西壮族自治区'),
    46: tu(LANG, '海南省'), 50: tu(LANG, '重庆市'), 51: tu(LANG, '四川省'), 52: tu(LANG, '贵州省'), 53: tu(LANG, '云南省'),
    54: tu(LANG, '西藏自治区'), 61: tu(LANG, '陕西省'), 62: tu(LANG, '甘肃省'), 63: tu(LANG, '青海省'),
    64: tu(LANG, '宁夏回族自治区'), 65: tu(LANG, '新疆维吾尔自治区'),
  };

  function render() {
    const raw = $('cc-in').value.trim();
    const msg = $('cc-msg');
    if (!raw) { $('cc-out').innerHTML = ''; msg.textContent = tu(LANG, '请输入统一社会信用代码'); msg.className = 'msg err'; return; }
    const r = parse(raw);
    if (!r.ok) { $('cc-out').innerHTML = ''; msg.textContent = r.reason; msg.className = 'msg err'; return; }

    const rows = [
      [tu(LANG, '校验结果'), r.valid
        ? '<span style="color:var(--success);">校验位正确</span>'
        : `<span style="color:var(--danger);">校验位错误，应为 ${r.expect}，实际为 ${r.actual}</span>`],
      [tu(LANG, '登记管理部门'), r.dept],
      [tu(LANG, '登记管理机关行政区划'), (PROV[r.region.slice(0, 2)] || tu(LANG, '未知')) + '（' + r.region + '）'],
      [tu(LANG, '主体标识码（组织机构代码）'), r.orgCode],
      [tu(LANG, '完整代码'), raw.toUpperCase()],
    ];
    $('cc-out').innerHTML =
      '<table class="result-table" style="margin-top:14px;max-width:560px;">' +
      rows.map(([k, v]) => `<tr><th>${k}</th><td>${v}</td></tr>`).join('') +
      '</table>';
    msg.textContent = r.valid ? '校验通过' : tu(LANG, '校验未通过');
    msg.className = r.valid ? 'msg ok' : 'msg err';
  }

  function gen() {
    const region = '1101' + String(Math.floor(Math.random() * 90) + 10);
    let body = '9' + '1' + region;
    for (let i = 0; i < 9; i++) body += CHARS[Math.floor(Math.random() * 31)];
    let sum = 0;
    for (let i = 0; i < 17; i++) sum += CHARS.indexOf(body[i]) * WEIGHT[i];
    let c = 31 - (sum % 31);
    if (c === 31) c = 0;
    $('cc-in').value = body + CHARS[c];
    render();
  }

  $('cc-go').onclick = render;
  $('cc-gen').onclick = gen;
  $('cc-clear').onclick = () => {
    $('cc-in').value = ''; $('cc-out').innerHTML = ''; $('cc-msg').textContent = '';
  };
</script>
