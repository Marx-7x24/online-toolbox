---
import { tu } from '../../i18n/toolUi.ts';
// 二维码批量生成：复用 qrcode 库，本地渲染
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div>
  <div class="field-label"><span>{tu(lang, '每行一个内容（最多 50 个')}）</span></div>
  <textarea id="qb-in" placeholder="https://example.com&#10;hello&#10;{tu(lang, '订单号')}-12345" rows="4"></textarea>
  <div class="field-label" style="margin-top:10px;"><span>{tu(lang, '批量结果')}</span></div>
  <div id="qb-grid" class="qb-grid"></div>
</div>
<div class="btn-row">
  <button id="qb-run" class="primary">{tu(lang, '生成')}</button>
  <span id="qb-msg" class="msg"></span>
</div>

<style>
  .qb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin-top: 6px; }
  .qb-item { border: 1px solid var(--border); border-radius: 8px; padding: 10px; text-align: center; background: var(--bg-soft); }
  .qb-item canvas { max-width: 100%; background: #fff; border-radius: 4px; }
  .qb-item .t { font-size: 12px; color: var(--text-sub); margin-top: 6px; word-break: break-all; }
  .qb-item a { display: inline-block; margin-top: 6px; font-size: 12px; color: var(--link); }
</style>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  import QRCode from 'qrcode';
  const $ = (id) => document.getElementById(id);
  $('qb-run').addEventListener('click', async () => {
    const lines = $('qb-in').value.split('\n').map((x) => x.trim()).filter(Boolean).slice(0, 50);
    if (!lines.length) { $('qb-grid').innerHTML = ''; $('qb-msg').textContent = tu(LANG, '请先输入内容'); $('qb-msg').className = 'msg err'; return; }
    $('qb-grid').innerHTML = tu(LANG, '生成中…');
    const items = [];
    for (const line of lines) {
      const c = document.createElement('canvas');
      try { await QRCode.toCanvas(c, line, { width: 140, margin: 1 }); }
      catch (e) { c.replaceWith(document.createTextNode(tu(LANG, '生成失败'))); }
      const url = c.toDataURL('image/png');
      const a = document.createElement('a'); a.href = url; a.download = 'qr-' + btoa(unescape(encodeURIComponent(line))).slice(0, 8) + '.png'; a.textContent = tu(LANG, '下载');
      const div = document.createElement('div'); div.className = 'qb-item';
      const t = document.createElement('div'); t.className = 't'; t.textContent = line;
      div.appendChild(c); div.appendChild(t); div.appendChild(a);
      items.push(div);
    }
    $('qb-grid').innerHTML = ''; items.forEach((d) => $('qb-grid').appendChild(d));
    $('qb-msg').textContent = `已生成 ${items.length} 个`; $('qb-msg').className = 'msg ok';
  });
</script>
