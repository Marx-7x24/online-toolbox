---
import { tu } from '../../i18n/toolUi.ts';
// volume-converter：纯前端单位换算（系数型）
const UNITS = [{"sym":"m3","zh":"立方米","f":1000},{"sym":"L","zh":"升","f":1},{"sym":"dL","zh":"分升","f":0.1},{"sym":"cL","zh":"厘升","f":0.01},{"sym":"mL","zh":"毫升","f":0.001},{"sym":"galUS","zh":"美制加仑","f":3.785411784},{"sym":"galUK","zh":"英制加仑","f":4.54609},{"sym":"qtUS","zh":"美制夸脱","f":0.946352946},{"sym":"ptUS","zh":"美制品脱","f":0.473176473},{"sym":"cup","zh":"杯","f":0.2365882365},{"sym":"flozUS","zh":"液体盎司","f":0.0295735295625},{"sym":"tbsp","zh":"汤匙","f":0.0147867648},{"sym":"tsp","zh":"茶匙","f":0.00492892159},{"sym":"in3","zh":"立方英寸","f":0.016387064},{"sym":"ft3","zh":"立方英尺","f":28.316846592}];
const BASE = { name: "升", sym: "L" };
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div class="pane">
  <div>
    <div class="field-label"><span>{tu(lang, '数值')}</span></div>
    <input type="number" id="uc-val" value="1" step="any" style="width:100%;padding:8px;border:1px solid var(--border-color);border-radius:6px;box-sizing:border-box;font-size:16px">
    <div class="field-label" style="margin-top:12px"><span>{tu(lang, '从')}</span></div>
    <select id="uc-from" style="width:100%;padding:8px;border:1px solid var(--border-color);border-radius:6px;background:#fff;font-size:14px">
      <option value="m3" data-f="1000">{tu(lang, '立方米')} (m3)</option>
      <option value="L" data-f="1">{tu(lang, '升')} (L)</option>
      <option value="dL" data-f="0.1">{tu(lang, '分升')} (dL)</option>
      <option value="cL" data-f="0.01">{tu(lang, '厘升')} (cL)</option>
      <option value="mL" data-f="0.001">{tu(lang, '毫升')} (mL)</option>
      <option value="galUS" data-f="3.785411784">{tu(lang, '美制加仑')} (galUS)</option>
      <option value="galUK" data-f="4.54609">{tu(lang, '英制加仑')} (galUK)</option>
      <option value="qtUS" data-f="0.946352946">{tu(lang, '美制夸脱')} (qtUS)</option>
      <option value="ptUS" data-f="0.473176473">{tu(lang, '美制品脱')} (ptUS)</option>
      <option value="cup" data-f="0.2365882365">{tu(lang, '杯')} (cup)</option>
      <option value="flozUS" data-f="0.0295735295625">{tu(lang, '液体盎司')} (flozUS)</option>
      <option value="tbsp" data-f="0.0147867648">{tu(lang, '汤匙')} (tbsp)</option>
      <option value="tsp" data-f="0.00492892159">{tu(lang, '茶匙')} (tsp)</option>
      <option value="in3" data-f="0.016387064">{tu(lang, '立方英寸')} (in3)</option>
      <option value="ft3" data-f="28.316846592">{tu(lang, '立方英尺')} (ft3)</option>
    </select>
    <div style="text-align:center;margin:8px 0">
      <button id="uc-swap">⇅ {tu(lang, '交换单位')}</button>
    </div>
    <div class="field-label"><span>{tu(lang, '到')}</span></div>
    <select id="uc-to" style="width:100%;padding:8px;border:1px solid var(--border-color);border-radius:6px;background:#fff;font-size:14px">
      <option value="m3" data-f="1000">{tu(lang, '立方米')} (m3)</option>
      <option value="L" data-f="1">{tu(lang, '升')} (L)</option>
      <option value="dL" data-f="0.1">{tu(lang, '分升')} (dL)</option>
      <option value="cL" data-f="0.01">{tu(lang, '厘升')} (cL)</option>
      <option value="mL" data-f="0.001">{tu(lang, '毫升')} (mL)</option>
      <option value="galUS" data-f="3.785411784">{tu(lang, '美制加仑')} (galUS)</option>
      <option value="galUK" data-f="4.54609">{tu(lang, '英制加仑')} (galUK)</option>
      <option value="qtUS" data-f="0.946352946">{tu(lang, '美制夸脱')} (qtUS)</option>
      <option value="ptUS" data-f="0.473176473">{tu(lang, '美制品脱')} (ptUS)</option>
      <option value="cup" data-f="0.2365882365">{tu(lang, '杯')} (cup)</option>
      <option value="flozUS" data-f="0.0295735295625">{tu(lang, '液体盎司')} (flozUS)</option>
      <option value="tbsp" data-f="0.0147867648">{tu(lang, '汤匙')} (tbsp)</option>
      <option value="tsp" data-f="0.00492892159">{tu(lang, '茶匙')} (tsp)</option>
      <option value="in3" data-f="0.016387064">{tu(lang, '立方英寸')} (in3)</option>
      <option value="ft3" data-f="28.316846592">{tu(lang, '立方英尺')} (ft3)</option>
    </select>
    <div style="margin-top:16px;padding:14px;background:rgba(0,0,0,.03);border-radius:8px">
      <div id="uc-out" style="font-size:20px;font-weight:600;color:var(--primary-color);word-break:break-all;line-height:1.5">-</div>
      <div style="font-size:12px;color:var(--text-sub);margin-top:4px">{tu(lang, '换算结果')}</div>
    </div>
  </div>
  <div>
    <div class="field-label"><span>{tu(lang, '等于以下所有单位')}</span></div>
    <table id="uc-table" style="width:100%;border-collapse:collapse;font-size:14px"></table>
    <p class="msg" id="uc-msg"></p>
  </div>
</div>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

const $ = (id) => document.getElementById(id);
const UNITS = [{"sym":"m3","zh":tu(LANG, "立方米"),"f":1000},{"sym":"L","zh":tu(LANG, "升"),"f":1},{"sym":"dL","zh":tu(LANG, "分升"),"f":0.1},{"sym":"cL","zh":tu(LANG, "厘升"),"f":0.01},{"sym":"mL","zh":tu(LANG, "毫升"),"f":0.001},{"sym":"galUS","zh":tu(LANG, "美制加仑"),"f":3.785411784},{"sym":"galUK","zh":tu(LANG, "英制加仑"),"f":4.54609},{"sym":"qtUS","zh":tu(LANG, "美制夸脱"),"f":0.946352946},{"sym":"ptUS","zh":tu(LANG, "美制品脱"),"f":0.473176473},{"sym":"cup","zh":tu(LANG, "杯"),"f":0.2365882365},{"sym":"flozUS","zh":tu(LANG, "液体盎司"),"f":0.0295735295625},{"sym":"tbsp","zh":tu(LANG, "汤匙"),"f":0.0147867648},{"sym":"tsp","zh":tu(LANG, "茶匙"),"f":0.00492892159},{"sym":"in3","zh":tu(LANG, "立方英寸"),"f":0.016387064},{"sym":"ft3","zh":tu(LANG, "立方英尺"),"f":28.316846592}];
function fmt(n){
  if (!isFinite(n)) return '-';
  if (n !== 0 && (Math.abs(n) < 1e-6 || Math.abs(n) >= 1e15)) return n.toExponential(6).replace(/(\.\d*?[1-9])0+e|\.0+e/g, '$1e');
  const s = n.toLocaleString('zh-CN', { maximumFractionDigits: 10 });
  return s;
}
function factorOf(sel){
  const opt = sel.options[sel.selectedIndex];
  return parseFloat(opt.dataset.f);
}
function symOf(sel){ return sel.value; }
function convert(){
  const v = parseFloat($('uc-val').value);
  if (isNaN(v)){ $('uc-out').textContent = '-'; $('uc-table').innerHTML=''; return; }
  const from = factorOf($('uc-from')), to = factorOf($('uc-to'));
  const base = v * from;
  const out = base / to;
  $('uc-out').textContent = fmt(out) + ' ' + symOf($('uc-to'));
  let html = '';
  for (const u of UNITS){
    html += '<tr style="border-bottom:1px solid var(--border-color)">' +
      '<td style="padding:7px 4px;color:var(--text-sub)">' + u.zh + ' (' + u.sym + ')</td>' +
      '<td style="padding:7px 4px;text-align:right;font-weight:600">' + fmt(base / u.f) + '</td></tr>';
  }
  $('uc-table').innerHTML = html;
}
['uc-val','uc-from','uc-to'].forEach(id => $(id).addEventListener('input', convert));
$('uc-from').addEventListener('change', convert);
$('uc-to').addEventListener('change', convert);
$('uc-swap').addEventListener('click', () => {
  const a = $('uc-from').selectedIndex, b = $('uc-to').selectedIndex;
  $('uc-from').selectedIndex = b; $('uc-to').selectedIndex = a;
  convert();
});
// 默认：从基准单位到第二个单位
$('uc-from').selectedIndex = UNITS.findIndex(u => u.sym === "L");
if ($('uc-to').selectedIndex === $('uc-from').selectedIndex) $('uc-to').selectedIndex = ("L" === 'm/s' ? 1 : 0);
if ($('uc-to').selectedIndex === $('uc-from').selectedIndex && $('uc-to').length > 1) $('uc-to').selectedIndex = 1;
convert();
</script>
