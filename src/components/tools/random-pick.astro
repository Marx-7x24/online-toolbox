---
---

<div class="tip">用浏览器随机数在本地抽取，适合抽奖、点名、分组。结果不会上传。</div>

<div class="field-label"><span>候选列表（每行一个）</span><span id="rp-count"></span></div>
<textarea id="rp-in" placeholder="每行输入一个候选项&#10;张三&#10;李四&#10;王五" style="min-height:180px;" spellcheck="false"></textarea>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin-top:12px;">
  <div>
    <div class="field-label"><span>抽取数量</span></div>
    <input type="number" id="rp-n" value="1" min="1" />
  </div>
  <div>
    <div class="field-label"><span>分组数（0 为不分组）</span></div>
    <input type="number" id="rp-g" value="0" min="0" />
  </div>
  <div>
    <div class="field-label"><span>选项</span></div>
    <label style="display:block;font-size:13px;"><input type="checkbox" id="rp-repeat" /> 允许重复</label>
    <label style="display:block;font-size:13px;"><input type="checkbox" id="rp-remove" /> 抽取后从列表移除</label>
  </div>
  <div>
    <div class="field-label"><span>排序</span></div>
    <select id="rp-sort">
      <option value="none">保持原顺序</option>
      <option value="shuffle">随机打乱</option>
      <option value="asc">升序</option>
      <option value="desc">降序</option>
    </select>
  </div>
</div>

<div class="btn-row">
  <button class="primary" id="rp-go">开始</button>
  <button id="rp-shuffle">仅打乱顺序</button>
  <button id="rp-sample">填入示例</button>
  <button id="rp-copy">复制结果</button>
  <button id="rp-clear">清空</button>
</div>

<p class="msg" id="rp-msg"></p>
<div id="rp-out"></div>

<script>
  const $ = (id) => document.getElementById(id);

  function items() {
    return $('rp-in').value.split(/\r?\n/).map((s) => s.trim()).filter(Boolean);
  }

  function randInt(n) {
    const a = new Uint32Array(1);
    crypto.getRandomValues(a);
    return a[0] % n;
  }

  function shuffle(arr) {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = randInt(i + 1);
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  function updateCount() {
    const n = items().length;
    $('rp-count').textContent = n ? `${n} 项` : '';
  }
  $('rp-in').oninput = updateCount;

  function run() {
    let list = items();
    if (!list.length) { $('rp-msg').textContent = '请先输入候选项'; $('rp-msg').className = 'msg err'; return; }

    if ($('rp-sort').value === 'shuffle') list = shuffle(list);
    else if ($('rp-sort').value === 'asc') list.sort((a, b) => a.localeCompare(b, 'zh-CN'));
    else if ($('rp-sort').value === 'desc') list.sort((a, b) => b.localeCompare(a, 'zh-CN'));

    const groups = +$('rp-g').value || 0;
    let html = '';

    if (groups > 0) {
      const buckets = Array.from({ length: groups }, () => []);
      const pool = shuffle(list);
      pool.forEach((it, i) => buckets[i % groups].push(it));
      html =
        '<table class="result-table" style="margin-top:14px;max-width:560px;">' +
        buckets.map((b, i) =>
          `<tr><th>第 ${i + 1} 组<br><span style="font-weight:400;font-size:12px;color:var(--text-hint);">${b.length} 人</span></th>
           <td>${b.map(esc).join('、') || '<span style="color:var(--text-hint);">（空）</span>'}</td></tr>`
        ).join('') +
        '</table>';
      $('rp-msg').textContent = `已分成 ${groups} 组`;
      $('rp-msg').className = 'msg ok';
    } else {
      let n = Math.max(1, +$('rp-n').value || 1);
      const allowRepeat = $('rp-repeat').checked;
      if (!allowRepeat) n = Math.min(n, list.length);

      let picked;
      if (allowRepeat) {
        picked = Array.from({ length: n }, () => list[randInt(list.length)]);
      } else {
        picked = shuffle(list).slice(0, n);
      }

      html =
        '<table class="result-table" style="margin-top:14px;max-width:520px;">' +
        picked.map((p, i) => `<tr><th>${n > 1 ? '第 ' + (i + 1) + ' 个' : '结果'}</th>
          <td style="font-size:16px;font-weight:500;">${esc(p)}</td></tr>`).join('') +
        '</table>';

      if ($('rp-remove').checked && !allowRepeat) {
        const left = items().filter((x) => !picked.includes(x));
        $('rp-in').value = left.join('\n');
        updateCount();
        $('rp-msg').textContent = `已抽取 ${picked.length} 个，列表剩余 ${left.length} 项`;
      } else {
        $('rp-msg').textContent = `已抽取 ${picked.length} 个`;
      }
      $('rp-msg').className = 'msg ok';
    }

    $('rp-out').innerHTML = html;
  }

  $('rp-go').onclick = run;
  $('rp-shuffle').onclick = () => {
    const list = items();
    if (!list.length) { $('rp-msg').textContent = '请先输入候选项'; $('rp-msg').className = 'msg err'; return; }
    const s = shuffle(list);
    $('rp-in').value = s.join('\n');
    $('rp-out').innerHTML =
      '<table class="result-table" style="margin-top:14px;max-width:520px;">' +
      s.map((p, i) => `<tr><th>${i + 1}</th><td>${esc(p)}</td></tr>`).join('') + '</table>';
    $('rp-msg').textContent = '已打乱顺序';
    $('rp-msg').className = 'msg ok';
  };
  $('rp-sample').onclick = () => {
    $('rp-in').value = '张三\n李四\n王五\n赵六\n钱七\n孙八\n周九\n吴十';
    updateCount();
  };
  $('rp-copy').onclick = async () => {
    const rows = $('rp-out').querySelectorAll('td');
    if (!rows.length) return;
    const text = [...rows].map((r) => r.textContent.trim()).join('\n');
    await navigator.clipboard.writeText(text);
    $('rp-msg').textContent = '已复制结果';
    $('rp-msg').className = 'msg ok';
  };
  $('rp-clear').onclick = () => {
    $('rp-in').value = ''; $('rp-out').innerHTML = ''; $('rp-msg').textContent = ''; updateCount();
  };
  updateCount();
</script>
