---
// PSD/PSB → JPG/PNG（懒加载 ag-psd）
---
<div class="pane">
  <div>
    <div class="field-label"><span>选择 PSD/PSB 文件</span></div>
    <input type="file" id="ifpsd-file" accept=".psd,.psb,image/vnd.adobe.photoshop">
    <div id="ifpsd-info" class="msg"></div>
    <div class="field-label" style="margin-top:14px"><span>输出格式</span></div>
    <select id="ifpsd-fmt" style="width:100%;padding:6px;border:1px solid var(--border);border-radius:6px">
      <option value="image/jpeg">JPG（较小）</option>
      <option value="image/png">PNG（无损）</option>
    </select>
    <p style="font-size:12px;color:#999;margin-top:8px">首次使用需联网加载解码器 ~150KB；仅合成导出（不支持单独图层）。</p>
  </div>
  <div>
    <div class="field-label"><span>合成预览</span></div>
    <div id="ifpsd-preview" class="ifpsd-preview"></div>
  </div>
</div>
<div class="btn-row">
  <button id="ifpsd-run" class="primary">开始转换</button>
  <button id="ifpsd-dl">下载</button>
  <button id="ifpsd-reset">重置</button>
  <span id="ifpsd-msg" class="msg"></span>
</div>

<style>
  .ifpsd-preview { margin-top: 10px; border: 1px dashed var(--border); border-radius: 8px; padding: 10px; min-height: 120px; display: flex; align-items: center; justify-content: center; background: var(--hover-bg); }
  .ifpsd-preview img { max-width: 100%; max-height: 320px; }
  .ifpsd-preview:empty::before { content: '尚未选择图片'; color: #999; }
</style>

<script>
  const $ = (id) => document.getElementById(id);
  let sourceFile = null;
  let canvas = null;
  let outBlob = null;
  let outExt = 'jpg';

  $('ifpsd-file').addEventListener('change', (e) => {
    const f = e.target.files[0];
    if (!f) return;
    sourceFile = f;
    $('ifpsd-info').textContent = `已选择：${f.name} · ${(f.size/1024).toFixed(1)} KB`;
    $('ifpsd-info').className = 'msg ok';
  });

  function loadScript(src) {
    return new Promise((res, rej) => {
      const s = document.createElement('script');
      s.src = src; s.onload = res; s.onerror = rej;
      document.head.appendChild(s);
    });
  }

  async function loadAgPsd() {
    // ag-psd 提供 ESM / IIFE 两种入口，下面用 IIFE UMD 入口
    if (window.agPsd) return window.agPsd;
    await loadScript('https://cdn.jsdelivr.net/npm/ag-psd@3.4.0/dist/ag-psd.iife.js');
    return window.agPsd;
  }

  $('ifpsd-run').addEventListener('click', async () => {
    if (!sourceFile) { $('ifpsd-msg').textContent = '请先选择 PSD 文件'; $('ifpsd-msg').className = 'msg err'; return; }
    $('ifpsd-msg').textContent = '加载解码器…'; $('ifpsd-msg').className = 'msg';
    try {
      const agPsd = await loadAgPsd();
      const buf = await sourceFile.arrayBuffer();
      const psd = agPsd.readPsd(buf, { skipLayerImageData: true, skipThumbnail: false, useImageData: true });
      if (!psd.canvas) throw new Error('PSD 解析失败（可能含智能对象/组样式等不支持的特性）');
      canvas = psd.canvas;
      $('ifpsd-info').textContent = `已解码 · ${canvas.width}×${canvas.height} · ${psd.layers?.length || 0} 图层`;
      $('ifpsd-info').className = 'msg ok';
      await convert();
    } catch (err) {
      $('ifpsd-msg').textContent = '解码失败：' + err.message;
      $('ifpsd-msg').className = 'msg err';
    }
  });

  async function convert() {
    if (!canvas) return;
    const fmt = $('ifpsd-fmt').value;
    const w = canvas.width, h = canvas.height;
    if (fmt === 'image/jpeg') {
      const composite = document.createElement('canvas');
      composite.width = w; composite.height = h;
      const cctx = composite.getContext('2d');
      cctx.fillStyle = '#ffffff'; cctx.fillRect(0, 0, w, h);
      cctx.drawImage(canvas, 0, 0);
      outBlob = await new Promise(res => composite.toBlob(res, fmt, 0.92));
      outExt = 'jpg';
    } else {
      outBlob = await new Promise(res => canvas.toBlob(res, fmt));
      outExt = 'png';
    }
    $('ifpsd-preview').innerHTML = '<img alt="预览">';
    $('ifpsd-preview').querySelector('img').src = URL.createObjectURL(outBlob);
    $('ifpsd-msg').textContent = `就绪 · ${(outBlob.size/1024).toFixed(1)} KB`;
    $('ifpsd-msg').className = 'msg ok';
  }

  $('ifpsd-fmt').addEventListener('change', convert);

  $('ifpsd-dl').addEventListener('click', () => {
    if (!outBlob) { $('ifpsd-msg').textContent = '请先转换'; $('ifpsd-msg').className = 'msg err'; return; }
    const a = document.createElement('a');
    a.href = URL.createObjectURL(outBlob);
    a.download = (sourceFile.name.replace(/\.[^.]+$/, '') || 'image') + '.' + outExt;
    a.click();
  });

  $('ifpsd-reset').addEventListener('click', () => {
    sourceFile = null; canvas = null; outBlob = null;
    $('ifpsd-file').value = '';
    $('ifpsd-info').textContent = '';
    $('ifpsd-preview').innerHTML = '';
    $('ifpsd-msg').textContent = '';
  });
</script>
