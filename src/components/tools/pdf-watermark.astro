---
// PDF 文字水印：对角线重复叠加文字水印
---
<div class="pane">
  <div>
    <div class="field-label"><span>选择 PDF 文件</span></div>
    <input type="file" id="pw-file" accept="application/pdf">
    <div class="field-label" style="margin-top:14px"><span>水印文字</span></div>
    <input type="text" id="pw-text" value="机密文件" maxlength="30" style="width:100%;padding:6px;border:1px solid var(--border);border-radius:6px;box-sizing:border-box">
    <div class="field-label" style="margin-top:8px"><span>字号 <span id="pw-sv">40</span> pt</span></div>
    <input type="range" id="pw-size" min="10" max="120" value="40" style="width:100%">
    <div class="field-label" style="margin-top:8px"><span>透明度 <span id="pw-ov">15</span>%</span></div>
    <input type="range" id="pw-opacity" min="5" max="100" value="15" style="width:100%">
    <div class="field-label" style="margin-top:8px"><span>旋转角度 <span id="pw-rv">-30</span>°</span></div>
    <input type="range" id="pw-rot" min="-90" max="90" value="-30" style="width:100%">
  </div>
  <div>
    <div class="field-label"><span>说明</span></div>
    <p style="font-size:13px;color:#666;background:#f8f9fb;padding:12px;border-radius:8px;line-height:1.6">
      每页对角线方向重复叠加水印文字，网格分布。<br>
      需要给 PDF 嵌入字体（pdf-lib 内置 Helvetica）。
    </p>
  </div>
</div>
<div class="btn-row">
  <button id="pw-run" class="primary">添加水印</button>
  <button id="pw-dl">下载</button>
  <button id="pw-reset">重置</button>
  <span id="pw-msg" class="msg"></span>
</div>

<script>
  const $ = (id) => document.getElementById(id);
  let sourceFile = null;
  let outBlob = null;

  $('pw-size').addEventListener('input', e => $('pw-sv').textContent = e.target.value);
  $('pw-opacity').addEventListener('input', e => $('pw-ov').textContent = e.target.value);
  $('pw-rot').addEventListener('input', e => $('pw-rv').textContent = e.target.value);
  $('pw-file').addEventListener('change', (e) => sourceFile = e.target.files[0]);

  function loadScript(src) {
    return new Promise((res, rej) => {
      const s = document.createElement('script');
      s.src = src; s.onload = res; s.onerror = rej;
      document.head.appendChild(s);
    });
  }
  async function loadPdfLib() {
    if (window.PDFLib) return window.PDFLib;
    await loadScript('https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js');
    return window.PDFLib;
  }

  $('pw-run').addEventListener('click', async () => {
    if (!sourceFile) { $('pw-msg').textContent = '请先选择 PDF'; $('pw-msg').className = 'msg err'; return; }
    $('pw-msg').textContent = '处理中…'; $('pw-msg').className = 'msg';
    try {
      const PDFLib = await loadPdfLib();
      const { rgb, degrees, StandardFonts } = PDFLib;
      const buf = await sourceFile.arrayBuffer();
      const pdfDoc = await PDFLib.PDFDocument.load(buf);
      const font = await pdfDoc.embedFont(StandardFonts.HelveticaBold);
      const pages = pdfDoc.getPages();
      const text = $('pw-text').value || 'Watermark';
      const fontSize = Number($('pw-size').value);
      const opacity = Number($('pw-opacity').value) / 100;
      const rot = Number($('pw-rot').value);
      const color = rgb(0.85, 0.1, 0.1);
      const stepX = 220, stepY = 140;
      for (const page of pages) {
        const { width, height } = page.getSize();
        for (let y = 0; y < height + stepY; y += stepY) {
          for (let x = 0; x < width + stepX; x += stepX) {
            page.drawText(text, {
              x, y, size: fontSize, font,
              color, opacity,
              rotate: degrees(rot),
            });
          }
        }
      }
      const out = await pdfDoc.save();
      outBlob = new Blob([out], { type: 'application/pdf' });
      $('pw-msg').textContent = `成功 · ${pages.length} 页 · 文字 "${text}"`;
      $('pw-msg').className = 'msg ok';
    } catch (err) {
      $('pw-msg').textContent = '失败：' + err.message;
      $('pw-msg').className = 'msg err';
    }
  });

  $('pw-dl').addEventListener('click', () => {
    if (!outBlob) return;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(outBlob);
    a.download = (sourceFile.name.replace(/\.pdf$/i, '') || 'pdf') + '_watermarked.pdf';
    a.click();
  });

  $('pw-reset').addEventListener('click', () => {
    sourceFile = null; outBlob = null;
    $('pw-file').value = '';
    $('pw-msg').textContent = '';
  });
</script>
