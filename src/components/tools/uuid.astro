---
---

<div class="tip">使用浏览器 crypto 随机数生成 v4 UUID，本地生成，不会上传到服务器。</div>

<div style="display:flex;gap:16px;flex-wrap:wrap;align-items:flex-end;">
  <div style="min-width:140px;">
    <div class="field-label"><span>生成数量</span></div>
    <select id="uu-n">
      <option value="1">1 个</option>
      <option value="5">5 个</option>
      <option value="10" selected>10 个</option>
      <option value="50">50 个</option>
      <option value="100">100 个</option>
    </select>
  </div>
  <div style="min-width:160px;">
    <div class="field-label"><span>输出格式</span></div>
    <select id="uu-fmt">
      <option value="lower">小写带横线</option>
      <option value="upper">大写带横线</option>
      <option value="plain">小写无横线</option>
      <option value="plainupper">大写无横线</option>
      <option value="brace">花括号 { }</option>
    </select>
  </div>
</div>

<div class="btn-row">
  <button class="primary" id="uu-gen">生成</button>
  <button id="uu-copy">复制全部</button>
  <button id="uu-clear">清空</button>
</div>

<textarea id="uu-out" placeholder="生成结果" readonly style="min-height:220px;"></textarea>

<p class="msg" id="uu-msg"></p>

<script>
  const $ = (id) => document.getElementById(id);

  function v4() {
    const b = new Uint8Array(16);
    crypto.getRandomValues(b);
    b[6] = (b[6] & 0x0f) | 0x40;
    b[8] = (b[8] & 0x3f) | 0x80;
    const h = [...b].map((x) => x.toString(16).padStart(2, '0')).join('');
    return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;
  }

  function shape(u) {
    switch ($('uu-fmt').value) {
      case 'upper': return u.toUpperCase();
      case 'plain': return u.replace(/-/g, '');
      case 'plainupper': return u.replace(/-/g, '').toUpperCase();
      case 'brace': return '{' + u + '}';
      default: return u;
    }
  }

  function gen() {
    const n = +$('uu-n').value;
    $('uu-out').value = Array.from({ length: n }, () => shape(v4())).join('\n');
    $('uu-msg').textContent = `已生成 ${n} 个`;
    $('uu-msg').className = 'msg ok';
  }

  $('uu-gen').onclick = gen;
  $('uu-fmt').onchange = () => { if ($('uu-out').value) gen(); };

  $('uu-copy').onclick = async () => {
    if (!$('uu-out').value) return;
    await navigator.clipboard.writeText($('uu-out').value);
    $('uu-msg').textContent = '已复制';
    $('uu-msg').className = 'msg ok';
  };
  $('uu-clear').onclick = () => { $('uu-out').value = ''; $('uu-msg').textContent = ''; };
  gen();
</script>
