---
import { tu } from '../../i18n/toolUi.ts';
// 密码强度计：本地熵估算
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div>
  <div class="field-label"><span>{tu(lang, '输入密码')}</span></div>
  <input type="text" id="ps-input" placeholder={tu(lang, '输入要评估的密码')} autocomplete="off">
  <div class="ps-bar"><div id="ps-fill" class="ps-fill"></div></div>
  <div id="ps-label" class="ps-label">{tu(lang, '尚未输入')}</div>
  <div class="ps-grid">
    <div><span class="ps-k">{tu(lang, '长度')}</span><span id="ps-len" class="ps-v">0</span></div>
    <div><span class="ps-k">{tu(lang, '字符池')}</span><span id="ps-pool" class="ps-v">0</span></div>
    <div><span class="ps-k">{tu(lang, '熵值')}</span><span id="ps-bits" class="ps-v">0 bit</span></div>
    <div><span class="ps-k">{tu(lang, '破解耗时(估算')})</span><span id="ps-time" class="ps-v">—</span></div>
  </div>
  <div id="ps-tip" class="ps-tip"></div>
</div>

<style>
  .ps-bar { height: 10px; border-radius: 6px; background: var(--border); overflow: hidden; margin-top: 10px; }
  .ps-fill { height: 100%; width: 0; transition: width .2s, background .2s; background: #adb5bd; }
  .ps-label { font-weight: 600; margin-top: 8px; }
  .ps-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; margin-top: 12px; }
  .ps-grid > div { display: flex; justify-content: space-between; border-bottom: 1px dashed var(--border); padding-bottom: 4px; }
  .ps-k { color: var(--text-sub); font-size: 13px; }
  .ps-v { font-weight: 600; }
  .ps-tip { margin-top: 10px; color: var(--text-sub); font-size: 13px; line-height: 1.6; }
</style>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);
  function humanTime(seconds) {
    if (seconds < 1) return tu(LANG, '瞬间');
    const u = [[tu(LANG, '年'), 31536000], [tu(LANG, '天'), 86400], [tu(LANG, '小时'), 3600], [tu(LANG, '分钟'), 60], [tu(LANG, '秒'), 1]];
    for (const [name, s] of u) { if (seconds >= s) return (seconds / s).toFixed(seconds / s > 100 ? 0 : 1) + ' ' + name; }
    return seconds.toFixed(0) + tu(LANG, ' 秒');
  }
  $('ps-input').addEventListener('input', () => {
    const pw = $('ps-input').value;
    const len = pw.length;
    let pool = 0;
    if (/[a-z]/.test(pw)) pool += 26;
    if (/[A-Z]/.test(pw)) pool += 26;
    if (/[0-9]/.test(pw)) pool += 10;
    if (/[^a-zA-Z0-9]/.test(pw)) pool += 33;
    const bits = len ? Math.round(len * Math.log2(pool || 1)) : 0;
    // 假设 GPU 1e10 次/秒
    const seconds = bits ? Math.pow(2, bits) / 1e10 : 0;
    let level, color;
    if (len === 0) { level = tu(LANG, '尚未输入'); color = '#adb5bd'; }
    else if (bits < 40) { level = tu(LANG, '弱'); color = '#e03131'; }
    else if (bits < 60) { level = tu(LANG, '中'); color = '#f08c00'; }
    else if (bits < 80) { level = tu(LANG, '强'); color = '#2f9e44'; }
    else { level = tu(LANG, '极强'); color = '#1971c2'; }
    const pct = Math.min(100, bits);
    $('ps-fill').style.width = pct + '%';
    $('ps-fill').style.background = color;
    $('ps-label').textContent = tu(LANG, '强度：') + level;
    $('ps-label').style.color = color;
    $('ps-len').textContent = len;
    $('ps-pool').textContent = pool;
    $('ps-bits').textContent = bits + ' bit';
    $('ps-time').textContent = humanTime(seconds);
    const tips = [];
    if (len < 12) tips.push(tu(LANG, '建议长度 ≥ 12 位'));
    if (!/[A-Z]/.test(pw)) tips.push(tu(LANG, '加入大写字母'));
    if (!/[0-9]/.test(pw)) tips.push(tu(LANG, '加入数字'));
    if (!/[^a-zA-Z0-9]/.test(pw)) tips.push(tu(LANG, '加入符号'));
    if (/(.)\1\1/.test(pw)) tips.push(tu(LANG, '避免连续重复字符'));
    $('ps-tip').textContent = tips.length ? tu(LANG, '建议：') + tips.join('；') + '。' : tu(LANG, '密码构成较合理，继续保持。');
  });
</script>
