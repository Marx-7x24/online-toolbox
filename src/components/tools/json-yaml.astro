---
import { tu } from '../../i18n/toolUi.ts';
// JSON 转 YAML（简易序列化，覆盖常见结构）
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---

<div class="pane">
  <div>
    <div class="field-label"><span>{tu(lang, '输入')} JSON</span></div>
    <textarea id="jy-in" placeholder='{"name":"张三","age":20,"tags":["a","b"],"addr":{"city":"北京"}}'></textarea>
  </div>
  <div>
    <div class="field-label"><span>YAML {tu(lang, '输出')}</span></div>
    <textarea id="jy-out" readonly></textarea>
  </div>
</div>
<div class="btn-row">
  <button id="jy-run" class="primary">{tu(lang, '转换为')} YAML</button>
  <button id="jy-copy">{tu(lang, '复制结果')}</button>
  <button id="jy-download">{tu(lang, '下载')} .yaml</button>
  <span id="jy-msg" class="msg"></span>
</div>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);
  const input = $('jy-in'), output = $('jy-out'), msg = $('jy-msg');

  const needsQuote = (s) =>
    s === '' || /^[-?:,\[\]{}#&*!|>'"%@`]/.test(s) || /:\s|\s#/.test(s) ||
    /^(true|false|null|yes|no|on|off|~)$/i.test(s) || /^[-+]?\d+(\.\d+)?([eE][-+]?\d+)?$/.test(s);

  const scalar = (v) => {
    if (v === null || v === undefined) return 'null';
    if (typeof v === 'boolean' || typeof v === 'number') return String(v);
    const s = String(v);
    return needsQuote(s) ? JSON.stringify(s) : s;
  };

  function toYaml(val, indent, lines) {
    const pad = '  '.repeat(indent);
    if (Array.isArray(val)) {
      if (!val.length) { lines.push(pad + '[]'); return; }
      val.forEach((item) => {
        if (item && typeof item === 'object') {
          const sub = [];
          toYaml(item, indent + 1, sub);
          lines.push(pad + '- ' + sub[0].trim());
          sub.slice(1).forEach((l) => lines.push('  ' + l));
        } else {
          lines.push(pad + '- ' + scalar(item));
        }
      });
      return;
    }
    if (val && typeof val === 'object') {
      const keys = Object.keys(val);
      if (!keys.length) { lines.push(pad + '{}'); return; }
      keys.forEach((k) => {
        const v = val[k];
        if (v && typeof v === 'object' && Object.keys(v).length) {
          lines.push(pad + scalar(k) + ':');
          toYaml(v, indent + 1, lines);
        } else {
          lines.push(pad + scalar(k) + ': ' + scalar(v));
        }
      });
      return;
    }
    lines.push(pad + scalar(val));
  }

  $('jy-run').addEventListener('click', () => {
    try {
      const data = JSON.parse(input.value);
      const lines = [];
      toYaml(data, 0, lines);
      output.value = lines.join('\n');
      msg.textContent = tu(LANG, '转换完成'); msg.className = 'msg ok';
    } catch (e) {
      msg.textContent = tu(LANG, 'JSON 解析失败：') + e.message; msg.className = 'msg err';
    }
  });

  $('jy-copy').addEventListener('click', async () => {
    if (!output.value) return;
    try { await navigator.clipboard.writeText(output.value); msg.textContent = tu(LANG, '已复制'); msg.className = 'msg ok'; }
    catch { msg.textContent = tu(LANG, '复制失败'); msg.className = 'msg err'; }
  });

  $('jy-download').addEventListener('click', () => {
    if (!output.value) return;
    const blob = new Blob([output.value], { type: 'text/yaml;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = 'converted.yaml'; a.click();
    URL.revokeObjectURL(a.href);
  });
</script>
