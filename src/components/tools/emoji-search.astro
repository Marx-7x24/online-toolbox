---
import { tu } from '../../i18n/toolUi.ts';
// Emoji 搜索：内置数据集，本地检索
interface Props { lang?: string }
const { lang = 'zh' } = Astro.props;

---
<div>
  <div class="field-label"><span>{tu(lang, '搜索（中')}/{tu(lang, '英文关键词，如 笑')} / heart / {tu(lang, '火')}）</span></div>
  <input type="text" id="em-q" placeholder="happy" autocomplete="off">
  <div class="field-label" style="margin-top:12px;"><span>{tu(lang, '结果（点击复制')}）</span></div>
  <div id="em-out" class="em-out"></div>
</div>

<style>
  .em-out { display: grid; grid-template-columns: repeat(auto-fill, minmax(48px, 1fr)); gap: 8px; margin-top: 6px; }
  .em-out .e { font-size: 26px; text-align: center; padding: 8px 0; border-radius: 8px; background: var(--bg-soft); cursor: pointer; border: 1px solid transparent; }
  .em-out .e:hover { border-color: var(--border); }
</style>

<script>import { tu, currentLang } from '../../i18n/toolUi.ts';
const LANG = currentLang();

  const $ = (id) => document.getElementById(id);
  // [emoji, 关键词...]
  const DATA = [
    ['😀', tu(LANG, 'smile grin happy 笑 开心')], ['😂', tu(LANG, 'laugh cry joy 笑哭 哈哈')], ['🤣', tu(LANG, 'rofl roll floor 爆笑')], ['😊', tu(LANG, 'blush smile 微笑')], ['😍', tu(LANG, 'love heart eyes 爱 喜欢')], ['😎', tu(LANG, 'cool sunglasses 酷 墨镜')], ['🤔', tu(LANG, 'think thinking 思考')], ['😅', tu(LANG, 'sweat nervous 尴尬')], ['😭', tu(LANG, 'cry sad 哭')], ['😡', tu(LANG, 'angry mad 生气')], ['🥳', tu(LANG, 'party celebrate 庆祝')], ['😴', tu(LANG, 'sleep tired 睡 困')], ['🤯', tu(LANG, 'mind blown 震惊')], ['🤝', tu(LANG, 'handshake deal 握手 合作')], ['👍', tu(LANG, 'thumbs up yes ok 赞 好')], ['👎', tu(LANG, 'thumbs down no 踩 差')], ['🙏', tu(LANG, 'pray thanks 拜托 谢')], ['👏', tu(LANG, 'clap bravo 鼓掌')], ['💪', tu(LANG, 'muscle strong 加油 力量')], ['🫡', tu(LANG, 'salute 敬礼')], ['❤️', tu(LANG, 'heart love red 爱 红心')], ['🧡', tu(LANG, 'orange heart 橙心')], ['💛', tu(LANG, 'yellow heart 黄心')], ['💚', tu(LANG, 'green heart 绿心')], ['💙', tu(LANG, 'blue heart 蓝心')], ['💜', tu(LANG, 'purple heart 紫心')], ['🔥', tu(LANG, 'fire hot 火 热')], ['⭐', tu(LANG, 'star 星 星')], ['✨', tu(LANG, 'sparkle shine 闪光')], ['🌟', tu(LANG, 'glow star 发光')], ['💡', tu(LANG, 'idea bulb 想法 灯泡')], ['🚀', tu(LANG, 'rocket launch 火箭 发射')], ['💻', tu(LANG, 'laptop computer 电脑')], ['📱', tu(LANG, 'phone mobile 手机')], ['📧', tu(LANG, 'email mail 邮件')], ['🔧', tu(LANG, 'wrench tool 工具')], ['⚙️', tu(LANG, 'gear settings 设置 齿轮')], ['🐱', tu(LANG, 'cat 猫')], ['🐶', tu(LANG, 'dog 狗')], ['🐼', tu(LANG, 'panda 熊猫')], ['🦄', tu(LANG, 'unicorn 独角兽')], ['🌸', tu(LANG, 'flower sakura 花 樱花')], ['🌈', tu(LANG, 'rainbow 彩虹')], ['☀️', tu(LANG, 'sun 太阳')], ['🌙', tu(LANG, 'moon 月亮')], ['⛅', tu(LANG, 'cloud sun 多云')], ['🌊', tu(LANG, 'wave ocean 海 浪')], ['🍎', tu(LANG, 'apple 苹果')], ['🍔', tu(LANG, 'burger 汉堡')], ['🍕', tu(LANG, 'pizza 披萨')], ['☕', tu(LANG, 'coffee 咖啡')], ['🍺', tu(LANG, 'beer 啤酒')], ['🎉', tu(LANG, 'tada party 庆祝 礼花')], ['🎁', tu(LANG, 'gift 礼物')], ['🏆', tu(LANG, 'trophy win 奖杯')], ['⚽', tu(LANG, 'soccer football 足球')], ['🎮', tu(LANG, 'game controller 游戏')], ['🎵', tu(LANG, 'music note 音乐')], ['📚', tu(LANG, 'books read 书')], ['✅', tu(LANG, 'check done 完成 对')], ['❌', tu(LANG, 'cross wrong 错')], ['⚠️', tu(LANG, 'warning 警告')], ['❓', tu(LANG, 'question 问')], ['💰', tu(LANG, 'money 钱')], ['💎', tu(LANG, 'diamond 钻石')], ['🛠️', tu(LANG, 'tools build 工具')], ['🔒', tu(LANG, 'lock secure 锁 安全')], ['🔑', tu(LANG, 'key 钥匙')], ['📌', tu(LANG, 'pin 图钉')], ['📍', tu(LANG, 'location pin 定位')], ['👀', tu(LANG, 'eyes look 看')], ['🤖', tu(LANG, 'robot ai 机器人')], ['🌍', tu(LANG, 'earth globe 地球')], ['💯', tu(LANG, 'hundred perfect 满分')], ['🥰', tu(LANG, 'smiling hearts 喜爱')], ['😇', tu(LANG, 'innocent angel 天使')], ['🤩', tu(LANG, 'star struck 崇拜')], ['😉', tu(LANG, 'wink 眨眼')], ['🙌', tu(LANG, 'raised hands 举手')], ['👋', tu(LANG, 'wave hand 挥手 再见')], ['🤞', tu(LANG, 'fingers crossed 好运')], ['🍀', tu(LANG, 'clover luck 幸运')], ['🎯', tu(LANG, 'target 目标')], ['🧩', tu(LANG, 'puzzle 拼图')], ['📈', tu(LANG, 'chart up 上涨 增长')], ['📉', tu(LANG, 'chart down 下跌')], ['💡', tu(LANG, 'bulb idea 点子')], ['🔔', tu(LANG, 'bell notification 铃 通知')], ['🏠', tu(LANG, 'home house 家')], ['✈️', tu(LANG, 'plane flight 飞机')], ['🚗', tu(LANG, 'car 车')], ['⏰', tu(LANG, 'alarm clock 闹钟')], ['📅', tu(LANG, 'calendar 日历')], ['🧠', tu(LANG, 'brain 脑 智慧')], ['💬', tu(LANG, 'speech bubble 对话')], ['📝', tu(LANG, 'memo note 笔记')], ['🍃', tu(LANG, 'leaf 叶 绿叶')], ['🌹', tu(LANG, 'rose 玫瑰')], ['🐝', tu(LANG, 'bee 蜜蜂')], ['🦋', tu(LANG, 'butterfly 蝴蝶')], ['🌻', tu(LANG, 'sunflower 向日葵')], ['⚡', tu(LANG, 'lightning 闪电')], ['❄️', tu(LANG, 'snow 雪')], ['🌊', tu(LANG, 'water wave 水波')],
  ];
  function render(list) {
    $('em-out').innerHTML = list.length
      ? list.map(([e, k]) => `<div class="e" data-e="${e}" title="${k.split(' ').slice(0, 3).join(' ')}">${e}</div>`).join('')
      : '<div style="color:var(--text-sub);grid-column:1/-1">无匹配</div>';
  }
  render(DATA.slice(0, 60));
  $('em-q').addEventListener('input', () => {
    const q = $('em-q').value.trim().toLowerCase();
    if (!q) { render(DATA.slice(0, 60)); return; }
    render(DATA.filter(([, k]) => k.toLowerCase().includes(q)));
  });
  document.addEventListener('click', (e) => {
    const t = e.target.closest('.e');
    if (t) navigator.clipboard.writeText(t.dataset.e).catch(() => {});
  });
</script>
