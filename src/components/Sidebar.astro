---
import { categories, getToolsByCategory, categoryI18n } from '../data/tools.js';
import { t } from '../i18n/ui.ts';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
  lang: string;
  active?: string; // 'home' | 'recent' | category slug
}
const { lang, active = 'home' } = Astro.props;
---

<!-- 懒人式左侧 aside：logo + 导航 + 分类 + 底部 -->
<aside class="aside-content">
  <header class="sidebar-header">
    <a href={`/${lang}/`} class="logo">
      <img class="logo-image" src="/logo.png" alt="Wevva" width="34" height="34" />
      <span class="logo-text">
        <span class="logo-text__main">Wevva</span>
        <span class="logo-text__sub">{t(lang, 'brandSuffix')}</span>
      </span>
    </a>
  </header>

  <nav class="nav-menu" aria-label={t(lang, 'home')}>
    <!-- 首页 -->
    <a href={`/${lang}/`} class={`nav-item ${active === 'home' ? 'active' : ''}`} data-nav-id="home">
      <span class="nav-icon">
        <svg viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M854.4 553.6l-300.8-256c-22.4-22.4-64-22.4-86.4 0l-300.8 256v-102.4l304-268.8c22.4-22.4 57.6-22.4 80 0l304 268.8v102.4z m-86.4 0v256c0 35.2-35.2 41.6-70.4 41.6h-102.4v-86.4c0-16-25.6-41.6-41.6-41.6h-86.4c-16 0-41.6 25.6-41.6 41.6v86.4h-102.4c-35.2 0-70.4-9.6-70.4-41.6v-256l256-214.4 259.2 214.4z"></path></svg>
      </span>
      <span class="nav-label">{t(lang, 'home')}</span>
    </a>

    <!-- 最近使用（页签：点击在右侧主区展示，不在左侧平铺） -->
    <a href={`/${lang}/recent/`} class={`nav-item ${active === 'recent' ? 'active' : ''}`} data-nav-id="recent">
      <span class="nav-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </span>
      <span class="nav-label">{t(lang, 'recentTools')}</span>
    </a>

    <div class="nav-divider"></div>

    <!-- 工具分类 -->
    {categories.map((c) => {
      const count = getToolsByCategory(c.slug).length;
      const cName = categoryI18n(c, lang).name;
      return (
        <a href={`/${lang}/category/${c.slug}/`} class={`nav-item ${active === c.slug ? 'active' : ''}`} data-nav-id={c.slug}>
          <span class="nav-icon"><CategoryIcon category={c.slug} /></span>
          <span class="nav-label">{cName}</span>
          <span class="nav-count">{count}</span>
        </a>
      );
    })}

    <div class="nav-divider"></div>

    <!-- 关于 -->
    <a href={`/${lang}/about/`} class={`nav-item ${active === 'about' ? 'active' : ''}`} data-nav-id="about">
      <span class="nav-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
      </span>
      <span class="nav-label">{t(lang, 'about')}</span>
    </a>

    <!-- 留言反馈 -->
    <a href={`/${lang}/feedback/`} class={`nav-item ${active === 'feedback' ? 'active' : ''}`} data-nav-id="feedback">
      <span class="nav-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
      </span>
      <span class="nav-label">{t(lang, 'feedback')}</span>
    </a>
  </nav>

  <div class="sidebar-footer">
    <a href={`/${lang}/about/`} class="nav-item">
      <span class="nav-label">{t(lang, 'footerPrivacy')}</span>
    </a>
  </div>
</aside>
