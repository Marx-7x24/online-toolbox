---
import { categories, getToolsByCategory, categoryI18n } from '../data/tools.js';
import { t } from '../i18n/ui.ts';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
  lang: string;
  active?: string; // 'home' 或 category slug
}
const { lang, active = 'home' } = Astro.props;
---

<aside class="sidebar">
  <a href={`/${lang}/`} class={`sidebar-item ${active === 'home' ? 'active' : ''}`}>
    <span class="sidebar-icon sidebar-icon--home">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
    </span>
    <span class="sidebar-label">{t(lang, 'home')}</span>
  </a>

  <div class="sidebar-divider"></div>

  {/* 「最近使用」独立页面入口：点击打开 /zh/recent/ （仿懒人工具 /recent/） */}
  <a href={`/${lang}/recent/`} class={`sidebar-item ${active === 'recent' ? 'active' : ''}`}>
    <span class="sidebar-icon sidebar-icon--recent">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
    </span>
    <span class="sidebar-label">{t(lang, 'recentTools')}</span>
  </a>
  <div class="sidebar-recent" data-lang={lang}>
    <div class="sidebar-recent-empty">{t(lang, 'recentEmpty')}</div>
  </div>

  <div class="sidebar-divider"></div>

  {categories.map((c) => {
    const count = getToolsByCategory(c.slug).length;
    const cName = categoryI18n(c, lang).name;
    return (
      <a href={`/${lang}/category/${c.slug}/`} class={`sidebar-item ${active === c.slug ? 'active' : ''}`}>
        <span class="sidebar-icon"><CategoryIcon category={c.slug} /></span>
        <span class="sidebar-label">{cName}</span>
        <span class="sidebar-count">{count}</span>
      </a>
    );
  })}
</aside>
