---
// Google AdSense 广告位（预留）。
// 启用方式：在部署环境（Cloudflare Pages → Settings → Environment variables）设置：
//   PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
//   PUBLIC_ADSENSE_SLOT=1234567890
// 未配置 client 时本组件不渲染任何 DOM，站点行为与无广告完全一致（审核前后零影响、不影响 SEO）。
interface Props {
  slot?: string; // 位置标识（tool / category / home…），便于后续按位统计
}
const { slot = 'tool' } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT || '';
const adSlot = import.meta.env.PUBLIC_ADSENSE_SLOT || '';
---

{
  client && (
    <div class="ad-slot" data-ad-position={slot}>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={adSlot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  )
}

<style>
  .ad-slot {
    margin: 18px 0;
  }
</style>
