---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/ui.ts';

// 留言反馈页：静态站无后端，表单提交到第三方表单服务（当前用 Web3Forms）。
//
// Web3Forms 的要点：提交时必须在 body 里带 access_key（不是 URL 里），
// 官方文档的原生 form 写法是 <input type="hidden" name="access_key">，
// 这里用 fetch + JSON，所以 key 由下面的 accessKey 注入到 JSON body。
// access_key 本身就是设计给前端暴露的，不属敏感凭据。
//
// 想换 key 或换服务商：部署环境设 PUBLIC_FEEDBACK_ENDPOINT / PUBLIC_FEEDBACK_KEY 即可，
// 未配置时使用下面的默认值；两个都不设才回退到 GitHub Issues 引导。
export function getStaticPaths() {
  return ['zh', 'en'].map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;

const endpoint: string =
  import.meta.env.PUBLIC_FEEDBACK_ENDPOINT || 'https://api.web3forms.com/submit';
const accessKey: string =
  import.meta.env.PUBLIC_FEEDBACK_KEY || '02e92a6f-31fa-4347-a312-bac23c1c0bfc';
const repoIssues = 'https://github.com/Marx-7x24/online-toolbox/issues';

// 提交成功后 Web3Forms redirect 回来的地址（用 Astro.site，随 SITE_URL 自动正确）
const base = Astro.site ?? new URL('https://www.wevva.top');
const thankYouUrl = new URL(`/${lang}/feedback/?sent=1`, base).href;
---

<Base
  title={`${t(lang, 'feedback')} - ${t(lang, 'siteName')}`}
  description={t(lang, 'feedbackIntro')}
  lang={lang}
  active="feedback"
>
  <div class="tool-page-head">
    <h1>{t(lang, 'feedback')}</h1>
    <p>{t(lang, 'feedbackIntro')}</p>
  </div>

  {/* 提交成功后 Web3Forms 跳回 ?sent=1 显示感谢提示。
      注意：静态站在构建时读不到 query string，所以必须用客户端 JS 判断，
      不能写成 Astro.url.searchParams（那样恒为 false，提示永远不出现）。 */}
  <div class="fb-done" id="fb-done" hidden>
    <span class="fb-done__icon">✓</span>
    <span>{t(lang, 'feedbackOk')}</span>
  </div>

  <div class="static-page">
    {
      endpoint ? (
        // 原生 form POST（官方推荐写法）：不走 fetch，因此完全没有 CORS 问题，
        // 兼容性最好；access_key 通过隐藏字段随表单一起提交。
        <form
          id="fb-form"
          class="fb-form"
          action={endpoint}
          method="POST"
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="subject" id="fb-subject" value={`[Wevva Tools] ${t(lang, 'fbTypeTool')}`} />
          <input type="hidden" name="redirect" value={thankYouUrl} />

          {/* honeypot：正常用户看不到也填不到，机器人填了就丢弃。
              botcheck 是 Web3Forms 约定（勾选即机器人），_gotcha 兼容 Formspree */}
          <input type="checkbox" name="botcheck" class="fb-hp" tabindex="-1" aria-hidden="true" />
          <input
            type="text"
            name="_gotcha"
            class="fb-hp"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <label class="fb-label" for="fb-type">{t(lang, 'feedbackType')}</label>
          <select id="fb-type" name="type" class="fb-input">
            <option value="new-tool">{t(lang, 'fbTypeTool')}</option>
            <option value="bug">{t(lang, 'fbTypeBug')}</option>
            <option value="other">{t(lang, 'fbTypeOther')}</option>
          </select>

          <label class="fb-label" for="fb-message">{t(lang, 'feedbackContent')}</label>
          <textarea
            id="fb-message"
            name="message"
            class="fb-input fb-textarea"
            rows="5"
            placeholder={t(lang, 'feedbackContentPh')}
            required
          ></textarea>

          <label class="fb-label" for="fb-email">{t(lang, 'feedbackEmail')}</label>
          <input
            type="email"
            id="fb-email"
            name="email"
            class="fb-input"
            placeholder={t(lang, 'feedbackEmailPh')}
          />

          <div class="fb-actions">
            <button
              type="submit"
              class="fb-submit"
              id="fb-submit"
              data-label={t(lang, 'feedbackSubmit')}
            >{t(lang, 'feedbackSubmit')}</button>
            <span class="fb-msg" id="fb-msg" role="status"></span>
          </div>

          <p class="fb-note">{t(lang, 'feedbackPrivacy')}</p>
        </form>
      ) : (
        <div class="fb-fallback">
          <p>{t(lang, 'feedbackNoService')}</p>
          <a class="fb-gh" href={repoIssues} target="_blank" rel="noopener noreferrer">
            GitHub Issues →
          </a>
        </div>
      )
    }
  </div>
</Base>

<script>
  // 原生 form 提交（无 fetch、无 CORS）。这里只做一件事：
  // 把用户选的反馈类型同步到隐藏的 subject 字段，让邮件标题能一眼区分类型。
  (function () {
    const form = document.getElementById('fb-form');
    if (!form) return;
    const typeSel = document.getElementById('fb-type');
    const subject = document.getElementById('fb-subject');
    if (!typeSel || !subject) return;

    const sync = () => {
      const label = typeSel.options[typeSel.selectedIndex].text;
      subject.value = '[Wevva Tools] ' + label;
    };
    typeSel.addEventListener('change', sync);
    sync();

    // 机器人防护：如果蜜罐被填/勾选，阻止提交
    form.addEventListener('submit', function (e) {
      const honey = form.querySelector('[name="_gotcha"]');
      const bot = form.querySelector('[name="botcheck"]');
      if ((honey && honey.value) || (bot && bot.checked)) {
        e.preventDefault();
        return false;
      }
    });

    // Web3Forms 提交后跳回 ?sent=1，客户端显示感谢提示
    var done = document.getElementById('fb-done');
    if (done && /(^|[?&])sent=1(&|$)/.test(window.location.search)) {
      done.hidden = false;
    }
  })();
</script>

<style>
  .fb-form { display: flex; flex-direction: column; gap: 6px; }
  .fb-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-color);
    margin-top: 10px;
  }
  .fb-input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--main-bg);
    color: var(--text-color);
    font-size: 14px;
    font-family: inherit;
    box-sizing: border-box;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
  }
  .fb-input:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 2px rgba(125, 116, 255, 0.18);
  }
  .fb-textarea { resize: vertical; min-height: 110px; line-height: 1.7; }
  .fb-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .fb-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .fb-submit {
    padding: 10px 22px;
    border: none;
    border-radius: 8px;
    background: var(--primary-color);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: opacity .15s;
  }
  .fb-submit:hover { opacity: .9; }
  .fb-submit:disabled { opacity: .6; cursor: not-allowed; }
  .fb-msg { font-size: 13px; }
  .fb-msg.ok { color: #16a34a; }
  .fb-msg.err { color: #dc2626; }
  .fb-note {
    margin: 14px 0 0;
    font-size: 12.5px;
    color: var(--text-hint);
    line-height: 1.7;
  }
  .fb-done {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    padding: 12px 16px;
    border-radius: 10px;
    background: rgba(22, 163, 74, 0.1);
    border: 1px solid rgba(22, 163, 74, 0.35);
    color: #16a34a;
    font-size: 14px;
    font-weight: 600;
  }
  .fb-done__icon { font-size: 17px; }
  .fb-fallback { text-align: center; padding: 12px 0; }
  .fb-gh {
    display: inline-block;
    margin-top: 8px;
    padding: 9px 20px;
    border-radius: 8px;
    background: var(--primary-color);
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }
</style>
