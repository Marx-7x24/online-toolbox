---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import JsonLd from '../../components/JsonLd.astro';

// 结构化数据用的绝对地址：域名取自 astro.config 的 site（由 SITE_URL 环境变量注入）
const siteUrl = (p) => new URL(p, Astro.site).href;
import { tools, categories, getToolsByCategory, categoryI18n, toolI18n } from '../../data/tools.js';
import { t } from '../../i18n/ui.ts';

export function getStaticPaths() {
  return ['zh', 'en'].map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
---

<Base
  title={`${t(lang, 'siteName')} - ${t(lang, 'tagline')}`}
  description={t(lang, 'aboutIntro')}
  keywords="在线工具,免费工具,工具箱,JSON格式化,Base64,时间戳转换,图片压缩,online tools,free tools"
  lang={lang}
>
  {/* 结构化数据：站点信息 + 站内搜索（?q= 已由 Base 的搜索脚本支持） */}
  <JsonLd data={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t(lang, 'siteName'),
    url: siteUrl(`/${lang}/`),
    inLanguage: lang === 'en' ? 'en-US' : 'zh-CN',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: siteUrl(`/${lang}/`) + '?q={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
  }} />

  <div class="home-layout">
    <Sidebar lang={lang} active="home" />

    <div class="home-main">
      <div class="page-head">
        <h1>{t(lang, 'siteName')}</h1>
        <p>{tools.length} {t(lang, 'toolsCount')} · {t(lang, 'tagline')}</p>
      </div>

      {categories.map((c) => {
        const list = getToolsByCategory(c.slug);
        if (!list.length) return null;
        const cName = categoryI18n(c, lang).name;
        return (
          <section id={`cat-${c.slug}`} class="home-section">
            <h2 class="home-section__title">
              {cName}
              <span class="home-section__count">{list.length} {t(lang, 'toolsCount')}</span>
            </h2>
            <div class="tool-grid">
              {list.map((tool) => {
                const ti = toolI18n(tool, lang);
                const search = [ti.name, ti.desc, tool.name_en || '', tool.desc_en || '', ...ti.keywords].join(' ').replace(/\s+/g, ' ').trim().toLowerCase();
                return <ToolCard lang={lang} slug={tool.slug} name={ti.name} desc={ti.desc} category={c.slug} search={search} />;
              })}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</Base>
