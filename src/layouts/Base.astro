---
import '../styles/global.css';
import { t } from '../i18n/ui.ts';
import { tools, categories, categoryI18n } from '../data/tools.js';
import { getToolIcon } from '../data/toolIcons.js';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  lang?: string;
  active?: string; // 侧栏高亮：'home' | 'recent' | category slug
}
const { title, description, keywords, lang = 'zh', active = 'home' } = Astro.props;
// 客户端可用的工具索引：侧边栏「最近使用」与 /recent/ 独立页都靠它在浏览器端渲染。
// 带上 desc 与懒人图标文件名，保证独立页卡片外观与首页完全一致。
const toolMap = Object.fromEntries(
  tools.map((tool) => [
    tool.slug,
    {
      name: tool.name,
      name_en: tool.name_en || tool.name,
      desc: tool.desc || '',
      desc_en: tool.desc_en || tool.desc || '',
      category: tool.category,
      icon: getToolIcon(tool.slug),
    },
  ])
);

// 客户端渲染「最近使用」需要的文案（随语言切换，避免脚本里硬编码中英三元判断）
const recentI18n = {
  emptySidebar: t(lang, 'recentEmpty'),
  emptyPage: t(lang, 'recentEmptyPage'),
  emptyCta: t(lang, 'recentEmptyCta'),
  clear: t(lang, 'recentClear'),
  confirm: t(lang, 'recentConfirm'),
  viewAll: t(lang, 'recentViewAll'),
  countUnit: t(lang, 'toolsCount'),
};
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const otherLang = lang === 'zh' ? 'en' : 'zh';
// 语言切换：把路径里的 /zh/ 换成 /en/（或反之）
const switchUrl = Astro.url.pathname.replace(`/${lang}/`, `/${otherLang}/`) || `/${otherLang}/`;
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og-image.png', Astro.site).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL('/og-image.png', Astro.site).href} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <!-- 懒人式左右结构：左侧 aside 导航 + 右侧主内容 -->
  <div class="container">
    <Sidebar lang={lang} active={active} />

    <main class="main-content" id="main-content">
      <h1 class="sr-only">{title}</h1>

      <!-- 顶部搜索框（sticky，仿懒人） -->
      <div class="search-container" id="search-box">
        <input
          type="search"
          id="global-search"
          class="search-input"
          autocomplete="off"
          maxlength="20"
          placeholder={t(lang, 'searchPlaceholder')}
          aria-label={t(lang, 'searchPlaceholder')}
        />
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <button type="button" class="search-clear" id="search-clear" aria-label="清空搜索">✕</button>
        <div class="lang-switch">
          <a href={switchUrl} class="lang-switch__btn" hreflang={otherLang}>
            {otherLang === 'en' ? 'EN' : '中'}
          </a>
        </div>
      </div>

      <slot />

      <!-- 页脚 -->
      <footer class="site-footer">
        <nav class="footer-links" aria-label={t(lang, 'home')}>
          <a href={`/${lang}/`}>{t(lang, 'home')}</a>
          <a href={`/${lang}/recent/`}>{t(lang, 'recentTools')}</a>
          {categories.map((c) => (
            <a href={`/${lang}/category/${c.slug}/`}>{categoryI18n(c, lang).name}</a>
          ))}
          <a href={`/${lang}/about/`}>{t(lang, 'about')}</a>
        </nav>
        <p>{t(lang, 'footerPrivacy')}</p>
        <p>{t(lang, 'footerCopy')}</p>
      </footer>
    </main>
  </div>

  <script is:inline set:html={`window.__TOOLS__ = ${JSON.stringify(toolMap)};`}></script>
  <script is:inline set:html={`window.__RECENT_I18N__ = ${JSON.stringify(recentI18n)};`}></script>

  <script>
    import { CATEGORY_ICONS } from '../data/categoryIcons.js';

    (function () {
      const input = document.getElementById('global-search');
      const clearBtn = document.getElementById('search-clear');
      if (!input) return;
      let debounce;

      function applyFilter(q) {
        const cards = document.querySelectorAll('.tool-card');
        if (!cards.length) return;
        cards.forEach(function (card) {
          const text = (card.dataset.search || '').toLowerCase();
          card.classList.toggle('tool-card--hidden', !!(q && !text.includes(q)));
        });
        document.querySelectorAll('.home-section').forEach(function (sec) {
          const visible = sec.querySelectorAll('.tool-card:not(.tool-card--hidden)').length;
          sec.classList.toggle('home-section--hidden', !!(q && visible === 0));
        });
      }

      input.addEventListener('input', function () {
        clearTimeout(debounce);
        const v = input.value.trim();
        if (clearBtn) clearBtn.classList.toggle('show', !!v);
        debounce = setTimeout(function () {
          applyFilter(v.toLowerCase());
        }, 150);
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          input.value = '';
          clearBtn.classList.remove('show');
          applyFilter('');
          input.focus();
        });
      }

      // 支持通过 URL ?q=关键词 直接进入搜索结果
      try {
        const q = new URLSearchParams(location.search).get('q');
        if (q) {
          input.value = q;
          if (clearBtn) clearBtn.classList.add('show');
          applyFilter(q.trim().toLowerCase());
        }
      } catch (e) {}
    })();
  </script>

  <script>
    (function () {
      const RECENT_KEY = 'recentTools';
      const MAX_RECENT = 12;
      const SIDEBAR_RECENT = 6;
      const I18N = window.__RECENT_I18N__ || {};
      const CLOCK_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>';
      const EMPTY_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>';

      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function readRecent() {
        let arr = [];
        try { arr = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); } catch (e) {}
        return Array.isArray(arr) ? arr : [];
      }

      function resolveItems(slugs, lang) {
        if (!window.__TOOLS__) return [];
        return slugs.map(function (slug) {
          const tool = window.__TOOLS__[slug];
          if (!tool) return null;
          return {
            slug: slug,
            name: lang === 'en' && tool.name_en ? tool.name_en : tool.name,
            desc: lang === 'en' && tool.desc_en ? tool.desc_en : tool.desc,
            category: tool.category,
            icon: tool.icon || null,
          };
        }).filter(Boolean);
      }

      // 懒人式卡片：title 行（28px 图标 + 名称）+ 两行截断描述
      function cardHtml(item, lang) {
        let iconHtml;
        if (item.icon) {
          iconHtml = '<img src="/icons/lanren/' + escapeHtml(item.icon) + '" alt="' + escapeHtml(item.name) + '" loading="lazy" />';
        } else {
          const c = CATEGORY_ICONS[item.category] || CATEGORY_ICONS.dev;
          iconHtml = '<span class="category-icon" style="background:' + c.color + '15;color:' + c.color + '">' + c.svg + '</span>';
        }
        return '<a href="/' + lang + '/tools/' + escapeHtml(item.slug) + '/" class="tool-card">' +
          '<div class="tool-card-link">' +
          '<h3 class="tool-card-title">' + iconHtml + '<span>' + escapeHtml(item.name) + '</span></h3>' +
          '<p class="tool-card-desc">' + escapeHtml(item.desc) + '</p>' +
          '</div></a>';
      }

      function recordVisit() {
        const match = location.pathname.match(/^\/(zh|en)\/tools\/([^\/]+)\//);
        if (!match) return;
        const slug = match[2];
        if (!window.__TOOLS__ || !window.__TOOLS__[slug]) return;
        let recent = readRecent();
        recent = recent.filter((s) => s !== slug);
        recent.unshift(slug);
        if (recent.length > MAX_RECENT) recent = recent.slice(0, MAX_RECENT);
        try { localStorage.setItem(RECENT_KEY, JSON.stringify(recent)); } catch (e) {}
      }

      function renderHomeRecent() {
        const panel = document.querySelector('.home-recent-panel');
        if (!panel) return;
        const lang = panel.dataset.lang || 'zh';
        const items = resolveItems(readRecent(), lang);
        if (!items.length) {
          panel.innerHTML = '<div class="recent-empty">' +
            '<div class="recent-empty__icon">' + EMPTY_SVG + '</div>' +
            '<p>' + escapeHtml(I18N.emptyPage) + '</p>' +
            '<a class="recent-empty__cta" href="/' + lang + '/">' + escapeHtml(I18N.emptyCta) + '</a>' +
            '</div>';
          return;
        }
        panel.innerHTML = '<div class="tools-grid">' + items.map(function (item) { return cardHtml(item, lang); }).join('') + '</div>';
      }

      // 首页页签：全部工具 / 最近使用。点"最近使用"在右侧主区展示，不在左侧平铺。
      function setupHomeTabs() {
        const tabs = document.querySelectorAll('.home-tab');
        if (!tabs.length) return;
        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            const which = tab.getAttribute('data-tab');
            tabs.forEach(function (t) { t.classList.toggle('is-active', t === tab); });
            document.querySelectorAll('.home-tab-panel').forEach(function (p) {
              p.classList.toggle('is-hidden', p.getAttribute('data-panel') !== which);
            });
            if (which === 'recent') renderHomeRecent();
          });
        });
      }

      function renderRecentPage() {
        const page = document.querySelector('.recent-page');
        if (!page) return;
        const lang = page.dataset.lang || 'zh';
        const items = resolveItems(readRecent(), lang);
        if (!items.length) {
          page.innerHTML = '<div class="recent-empty">' +
            '<div class="recent-empty__icon">' + EMPTY_SVG + '</div>' +
            '<p>' + escapeHtml(I18N.emptyPage) + '</p>' +
            '<a class="recent-empty__cta" href="/' + lang + '/">' + escapeHtml(I18N.emptyCta) + '</a>' +
            '</div>';
          return;
        }
        page.innerHTML =
          '<div class="recent-toolbar">' +
            '<span class="recent-toolbar__count">' + items.length + ' ' + escapeHtml(I18N.countUnit) + '</span>' +
            '<button type="button" class="recent-toolbar__clear" data-clear-recent>' + escapeHtml(I18N.clear) + '</button>' +
          '</div>' +
          '<div class="tools-grid">' + items.map(function (item) { return cardHtml(item, lang); }).join('') + '</div>';

        const btn = page.querySelector('[data-clear-recent]');
        if (btn) {
          btn.addEventListener('click', function () {
            if (!window.confirm(I18N.confirm)) return;
            try { localStorage.removeItem(RECENT_KEY); } catch (e) {}
            renderRecentPage();
          });
        }
      }

      function renderAll() {
        renderRecentPage();
      }

      recordVisit();
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderAll);
      } else {
        renderAll();
      }
    })();
  </script>
</body>
</html>
