# Cloudflare 部署凭据模板
# 复制本文件为 .env.cf 并填入真实值（.env.cf 已被 .gitignore 忽略，不会入库）
#
# CF_ACCOUNT_ID：Cloudflare 账户 ID
#   获取：登录 dash.cloudflare.com → 右侧 "Account ID"；或 `wrangler whoami`
# CF_API_TOKEN：具有 Pages 部署权限的 API Token
#   获取：dash.cloudflare.com/profile/api-tokens → 创建 Token
#   权限模板选 "Cloudflare Pages: Edit"（或自定义：Account > Cloudflare Pages > Edit）
#   无需 Zone 权限（Pages 不走 DNS 区域，域名在 Pages 项目里直接绑定）

CF_ACCOUNT_ID=your_account_id_here
CF_API_TOKEN=your_api_token_here

# SITE_URL：站点正式域名，用于生成 sitemap / canonical / SEO（astro.config.mjs 会读取）
#   两个域名分别部署时，用对应站点的域名：
#     国外站 → https://example.com
#     国内站（/zh）→ https://cn.example.com
#   忘记填会在 sitemap 里带占位符 tool.example.com（不影响部署，但 SEO 链接错），上线前必填
SITE_URL=https://your-domain.example.com
